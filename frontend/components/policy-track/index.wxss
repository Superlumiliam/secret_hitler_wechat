.track-panel {
  margin-top: 10rpx;
  padding: 0;
  background: transparent;
}

.policy-track-shell {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 42.8333%;
  overflow: visible;
}

.policy-track-shell::before {
  content: "";
  position: absolute;
  inset: 10rpx 12rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.3);
  background: rgba(4, 16, 16, 0.72);
  box-shadow: inset 0 0 46rpx rgba(0, 0, 0, 0.62);
}

.policy-track-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.policy-row {
  position: absolute;
  z-index: 2;
  display: grid;
  align-items: end;
  justify-items: center;
}

.liberal-row {
  left: 10.5%;
  right: 9.5%;
  top: 32%;
  height: 54%;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: 1.2%;
}

.fascist-row {
  left: 7.5%;
  right: 7.5%;
  top: 33%;
  height: 52%;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  column-gap: 1%;
}

.policy-cell {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(226, 188, 139, 0.76);
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.policy-label {
  max-width: 92%;
  line-height: 1.08;
}

.policy-card-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 8rpx 8rpx rgba(0, 0, 0, 0.46));
}

.policy-cell.is-new-policy .policy-card-image {
  animation: policyDropIn 420ms cubic-bezier(0.18, 0.82, 0.24, 1) both;
}

.power-badge-control {
  position: absolute;
  left: 50%;
  bottom: -24rpx;
  z-index: 3;
  width: 34rpx;
  height: 34rpx;
  transform: translateX(-50%);
}

.power-badge-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 6rpx 7rpx rgba(0, 0, 0, 0.45));
}

.policy-cell.is-enacted .power-badge-control {
  opacity: 0.94;
}

.power-tip {
  position: absolute;
  left: 50%;
  bottom: 40rpx;
  min-width: 126rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  border: 1rpx solid rgba(211, 163, 89, 0.72);
  color: #f3d59d;
  font-size: 18rpx;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
  background: rgba(20, 13, 8, 0.94);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.35);
}

.power-tip::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -7rpx;
  width: 12rpx;
  height: 12rpx;
  transform: translateX(-50%) rotate(45deg);
  border-right: 1rpx solid rgba(211, 163, 89, 0.72);
  border-bottom: 1rpx solid rgba(211, 163, 89, 0.72);
  background: rgba(20, 13, 8, 0.94);
}

@keyframes policyDropIn {
  0% {
    opacity: 0;
    transform: translateY(-22rpx) scale(1.04) rotate(-1deg);
  }

  68% {
    opacity: 1;
    transform: translateY(3rpx) scale(0.995) rotate(0deg);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
  }
}

.track-progress {
  margin-top: 10rpx;
  color: rgba(221, 190, 143, 0.76);
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.progress-count {
  color: #1bd5df;
  font-weight: 800;
}

.fascist-count {
  color: #ef6048;
}

.veto-note {
  margin-top: 8rpx;
  color: #f1bd76;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
}

@media (max-width: 360px) {
  .policy-cell {
    font-size: 28rpx;
  }
}
