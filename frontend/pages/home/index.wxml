<view class="home-page">
  <image
    wx:if="{{homeBackgroundVisible}}"
    class="background-home"
    src="{{homeBackgroundSrc}}"
    mode="aspectFill"
    binderror="onBackgroundError"
  />

  <view
    class="profile-entry"
    bindtap="onProfileEntry"
    hover-class="profile-entry-hover"
    role="button"
    aria-label="创建或修改用户形象"
  >
    <image
      wx:if="{{profileAvatarSrc}}"
      class="profile-avatar"
      src="{{profileAvatarSrc}}"
      mode="aspectFill"
    />
  </view>

  <view class="actions">
    <button
      class="create-button"
      bindtap="onCreateRoom"
      hover-class="create-button-hover"
      aria-label="创建房间"
    >
      创建房间
      <text class="join-arrow">›</text>
    </button>

    <button class="join-button" bindtap="onJoinRoom" hover-class="join-button-hover">
      加入房间
      <text class="join-arrow">›</text>
    </button>
  </view>
</view>
