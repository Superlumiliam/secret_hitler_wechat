<view class="home-page">
  <image
    wx:if="{{homeBackgroundVisible}}"
    class="background-home"
    src="{{homeBackgroundSrc}}"
    mode="aspectFill"
    binderror="onBackgroundError"
  />

  <view
    class="profile-entry"
    bindtap="onProfileEntry"
    hover-class="profile-entry-hover"
    role="button"
    aria-label="创建或修改用户形象"
  >
    <image
      wx:if="{{profileAvatarSrc}}"
      class="profile-avatar"
      src="{{profileAvatarSrc}}"
      mode="aspectFill"
    />
  </view>

  <view class="actions">
    <button
      class="create-button"
      bindtap="onCreateRoom"
      hover-class="create-button-hover"
      aria-label="创建房间"
    >
      创建房间
      <text class="join-arrow">›</text>
    </button>

    <button class="join-button" bindtap="onOpenJoinDialog" hover-class="join-button-hover" aria-label="加入房间">
      加入房间
      <text class="join-arrow">›</text>
    </button>
  </view>

  <view wx:if="{{joinDialogVisible}}" class="join-dialog-layer">
    <view class="join-dialog-mask" bindtap="onCloseJoinDialog"></view>
    <view class="join-dialog" role="dialog" aria-label="加入房间">
      <view class="join-dialog-title">加入房间</view>
      <input
        class="join-dialog-input"
        value="{{joinCode}}"
        type="number"
        maxlength="6"
        focus="{{joinDialogVisible}}"
        placeholder="输入 6 位房间号"
        placeholder-class="join-dialog-placeholder"
        confirm-type="done"
        bindinput="onJoinInput"
        bindconfirm="onJoinRoom"
      />
      <view class="join-dialog-actions">
        <view
          class="dialog-action secondary"
          bindtap="onCloseJoinDialog"
          hover-class="dialog-action-hover"
          role="button"
          aria-label="取消加入"
        >
          取消
        </view>
        <view
          class="dialog-action primary {{isJoining ? 'is-disabled' : ''}}"
          bindtap="onJoinRoom"
          hover-class="dialog-action-hover"
          role="button"
          aria-label="确认加入"
        >
          {{isJoining ? '加入中...' : '确定'}}
        </view>
      </view>
    </view>
  </view>
</view>
