page {
  height: 100%;
  overflow: hidden;
  background: #061016;
}

.home-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #061016;
}

.background-home {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.profile-entry {
  position: absolute;
  z-index: 2;
  left: 34rpx;
  top: calc(90rpx + env(safe-area-inset-top));
  box-sizing: border-box;
  width: 92rpx;
  height: 92rpx;
  padding: 5rpx;
  border: 2rpx solid rgba(217, 170, 106, 0.78);
  border-radius: 50%;
  background: rgba(5, 17, 21, 0.72);
  box-shadow:
    0 0 18rpx rgba(32, 226, 232, 0.28),
    inset 0 0 0 2rpx rgba(59, 235, 240, 0.35);
}

.profile-entry-hover {
  opacity: 0.78;
}

.profile-avatar {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #10242b;
}

.actions {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.create-button {
  height: 72rpx;
  margin-top: 8rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9c899;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  background: transparent;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.82);
}

.create-button::after {
  border: none;
}

.create-button-hover {
  opacity: 0.72;
}

.join-button {
  height: 72rpx;
  margin-top: 8rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9c899;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  background: transparent;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.82);
}

.join-button::after {
  border: none;
}

.join-button[disabled] {
  color: rgba(233, 200, 153, 0.72);
  background: transparent;
}

.join-button-hover {
  opacity: 0.72;
}

.join-arrow {
  margin-left: 14rpx;
  font-size: 40rpx;
}

.license-note {
  position: absolute;
  z-index: 2;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  color: rgba(233, 200, 153, 0.62);
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
  text-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.76);
}

.join-dialog-layer {
  position: absolute;
  z-index: 5;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.join-dialog-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(2, 8, 10, 0.64);
}

.join-dialog {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 600rpx;
  padding: 42rpx 42rpx 34rpx;
  border: 2rpx solid rgba(217, 170, 106, 0.78);
  background: rgba(7, 19, 22, 0.94);
  box-shadow:
    0 18rpx 42rpx rgba(0, 0, 0, 0.58),
    inset 0 0 0 2rpx rgba(59, 235, 240, 0.16);
  font-family: "Songti SC", STSong, SimSun, serif;
}

.join-dialog-title {
  color: #e9c899;
  font-size: 34rpx;
  line-height: 1.25;
  text-align: center;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.78);
}

.join-dialog-input {
  box-sizing: border-box;
  width: 100%;
  height: 78rpx;
  margin-top: 34rpx;
  padding: 0 26rpx;
  border: 2rpx solid rgba(217, 170, 106, 0.72);
  color: #f1d7ad;
  background: rgba(2, 9, 11, 0.78);
  font-size: 30rpx;
  letter-spacing: 0;
  text-align: center;
}

.join-dialog-placeholder {
  color: rgba(233, 200, 153, 0.58);
}

.join-dialog-actions {
  display: flex;
  margin-top: 34rpx;
}

.dialog-action {
  box-sizing: border-box;
  height: 64rpx;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(217, 170, 106, 0.66);
  color: #e9c899;
  font-size: 28rpx;
  text-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.58);
}

.dialog-action + .dialog-action {
  margin-left: 18rpx;
}

.dialog-action.primary {
  color: #09282d;
  background: #d9aa6a;
  text-shadow: none;
}

.dialog-action.secondary {
  background: rgba(5, 17, 21, 0.58);
}

.dialog-action.is-disabled {
  opacity: 0.62;
}

.dialog-action-hover {
  opacity: 0.78;
}
