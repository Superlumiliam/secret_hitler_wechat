page {
  height: 100%;
  overflow: hidden;
  background: #061016;
}

.home-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #061016;
}

.home-background {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.actions {
  position: absolute;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: calc(130rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
}

.create-button {
  height: 72rpx;
  margin-top: 8rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9c899;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  background: transparent;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.82);
}

.create-button::after {
  border: none;
}

.create-button-hover {
  opacity: 0.72;
}

.join-button {
  height: 72rpx;
  margin-top: 8rpx;
  padding: 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9c899;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
  background: transparent;
  text-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.82);
}

.join-button::after {
  border: none;
}

.join-button-hover {
  opacity: 0.72;
}

.join-arrow {
  margin-left: 14rpx;
  font-size: 40rpx;
}
