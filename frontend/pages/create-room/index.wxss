page {
  min-height: 100vh;
  background: #061016;
}

.create-room-page {
  position: relative;
  min-height: 100vh;
  padding: calc(96rpx + env(safe-area-inset-top)) 24rpx 44rpx;
  box-sizing: border-box;
  font-family: "Songti SC", STSong, SimSun, serif;
  background:
    radial-gradient(circle at 18% 18%, rgba(34, 190, 200, 0.16), transparent 30%),
    radial-gradient(circle at 78% 80%, rgba(198, 51, 42, 0.16), transparent 32%),
    linear-gradient(180deg, #07171c 0%, #03080b 100%);
  color: #f1c47a;
}

.top-bar {
  position: relative;
  z-index: 2;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(185, 128, 66, 0.44);
  border-bottom: 1rpx solid rgba(185, 128, 66, 0.34);
  background: rgba(2, 12, 15, 0.52);
}

.back-control {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-62%);
  width: 68rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e0ad69;
  font-size: 72rpx;
  line-height: 72rpx;
}

.icon-hover {
  opacity: 0.72;
}

.page-title {
  color: #e5b978;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.complete-button::after {
  border: 0;
}

.content {
  padding-top: 28rpx;
}

.count-list {
  margin-top: 0;
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  column-gap: 10rpx;
  align-items: start;
}

.count-item {
  position: relative;
  width: 100%;
  min-width: 0;
  height: 118rpx;
  margin: 0;
  padding: 0;
  display: block;
  box-sizing: border-box;
  line-height: normal;
  background: transparent;
  overflow: visible;
}

.count-badge {
  width: 100%;
  height: 118rpx;
  filter: drop-shadow(0 0 8rpx rgba(0, 0, 0, 0.7));
}

.count-number {
  position: absolute;
  left: 0;
  right: 0;
  top: 24rpx;
  text-align: center;
  color: #d6b17b;
  font-size: 48rpx;
  font-weight: 700;
}

.count-item-active .count-badge {
  filter: drop-shadow(0 0 18rpx rgba(42, 230, 230, 0.86));
}

.count-item-active .count-number {
  color: #f3d5a1;
}

.count-hover,
.icon-hover {
  opacity: 0.76;
}

.faction-panel {
  margin-top: 36rpx;
  padding: 24rpx 18rpx 22rpx;
  border: 1rpx solid rgba(121, 171, 181, 0.56);
  border-radius: 8rpx;
  background:
    linear-gradient(180deg, rgba(137, 202, 214, 0.08), rgba(24, 62, 70, 0.03) 38%, rgba(4, 16, 20, 0.18)),
    linear-gradient(90deg, rgba(116, 168, 178, 0.1), rgba(6, 20, 24, 0.22) 18%, rgba(6, 20, 24, 0.18) 82%, rgba(116, 168, 178, 0.1));
  box-shadow:
    inset 0 1rpx 0 rgba(204, 246, 255, 0.18),
    inset 0 -1rpx 0 rgba(3, 8, 10, 0.62),
    0 0 0 1rpx rgba(8, 24, 29, 0.72);
}

.fascist-panel {
  border-color: rgba(157, 53, 45, 0.62);
  background:
    linear-gradient(180deg, rgba(176, 49, 40, 0.09), rgba(60, 13, 12, 0.04) 42%, rgba(18, 4, 5, 0.2)),
    linear-gradient(90deg, rgba(133, 36, 31, 0.12), rgba(23, 5, 6, 0.24) 18%, rgba(23, 5, 6, 0.18) 82%, rgba(133, 36, 31, 0.12));
  box-shadow:
    inset 0 1rpx 0 rgba(255, 184, 174, 0.12),
    inset 0 -1rpx 0 rgba(6, 1, 1, 0.68),
    0 0 0 1rpx rgba(34, 7, 6, 0.8);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #94c6d6;
  font-size: 30rpx;
  font-weight: 700;
}

.fascist-heading {
  color: #e66b5c;
}

.heading-line {
  width: 128rpx;
  height: 2rpx;
  background: rgba(148, 198, 214, 0.34);
}

.fascist-heading .heading-line {
  background: rgba(230, 107, 92, 0.34);
}

.role-grid {
  margin-top: 24rpx;
  display: grid;
  gap: 18rpx 8rpx;
}

.liberal-grid {
  grid-template-columns: repeat(3, 220rpx);
  justify-content: center;
}

.fascist-grid {
  grid-template-columns: repeat(3, 220rpx);
  justify-content: center;
}

.role-card {
  width: 220rpx;
  height: 272rpx;
  min-width: 0;
  padding: 0;
  background: transparent;
}

.role-avatar {
  width: 100%;
  height: 100%;
  display: block;
  background: transparent;
}

.role-avatar-empty {
  background: rgba(28, 54, 61, 0.45);
  box-shadow: inset 0 0 22rpx rgba(255, 255, 255, 0.06);
}

.complete-button {
  width: 410rpx;
  height: 94rpx;
  margin: 34rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid rgba(76, 255, 255, 0.55);
  border-radius: 48rpx;
  color: #04252a;
  font-size: 36rpx;
  font-weight: 900;
  background: linear-gradient(180deg, #49eff2 0%, #13bdc7 100%);
  box-shadow: 0 0 22rpx rgba(32, 226, 232, 0.32);
}

.complete-button-hover {
  opacity: 0.82;
}

.complete-button-disabled {
  color: rgba(4, 37, 42, 0.7);
  background: #2aaeb5;
}

.avatar-preload {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1rpx;
  height: 1rpx;
  overflow: hidden;
  opacity: 0;
}

.avatar-preload-image {
  width: 1rpx;
  height: 1rpx;
}
