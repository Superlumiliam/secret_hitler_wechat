<view class="profile-page">
  <image
    wx:if="{{backgroundVisible}}"
    class="profile-background"
    src="{{backgroundSrc}}"
    mode="aspectFill"
    webp="{{true}}"
    binderror="onBackgroundError"
  />

  <view class="profile-overlay"></view>

  <view class="top-bar">
    <view class="back-control" bindtap="onBackHome" hover-class="icon-hover" role="button" aria-label="返回">‹</view>
    <view class="page-title">创建用户</view>
  </view>

  <view class="hero-copy">
    <view class="hero-title">建立你的机密档案</view>
    <view class="hero-subtitle">
      <view class="subtitle-line"></view>
      <text>点击人像创建头像</text>
      <view class="subtitle-line"></view>
    </view>
  </view>

  <view class="avatar-stage">
    <button
      class="avatar-button"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
      hover-class="avatar-button-hover"
      aria-label="选择头像"
    >
      <view class="avatar-ring">
        <image class="avatar-image" src="{{avatarPreviewSrc || defaultAvatarSrc}}" mode="aspectFill" webp="{{true}}" />
      </view>
    </button>
  </view>

  <form bindsubmit="onSubmitProfile">
    <view class="form-panel">
      <view class="field-label">
        <view class="label-line"></view>
        <text>用户名</text>
        <view class="label-line"></view>
      </view>
      <input
        class="name-input"
        name="displayName"
        type="nickname"
        maxlength="12"
        value="{{displayName}}"
        placeholder="白夜行者"
        placeholder-class="input-placeholder"
        bindinput="onNameInput"
      />
      <view class="field-note">2-12个字符，创建后可修改</view>
    </view>

    <view class="stats-panel">
      <view class="stats-title">
        <view class="label-line"></view>
        <text>个人战绩</text>
        <view class="label-line"></view>
      </view>
      <view class="stats-grid">
        <view wx:for="{{personalStats}}" wx:key="key" class="stat-card">
          <text class="stat-label">{{item.label}}</text>
          <text class="stat-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <button
      class="save-button {{isSaving ? 'save-button-disabled' : ''}}"
      form-type="submit"
      loading="{{isSaving}}"
      disabled="{{isSaving}}"
      hover-class="save-button-hover"
    >
      保存形象
    </button>
  </form>
</view>
