.result-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(96rpx + env(safe-area-inset-top)) 28rpx 48rpx;
  color: #f3e4c8;
  background:
    linear-gradient(180deg, rgba(5, 10, 10, 0.35), rgba(6, 10, 10, 0.94)),
    #07100f;
  font-family: "Songti SC", STSong, SimSun, serif;
}

.top-bar {
  position: relative;
  z-index: 5;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(185, 128, 66, 0.44);
  border-bottom: 1rpx solid rgba(185, 128, 66, 0.34);
  background: rgba(2, 12, 15, 0.52);
}

.back-control {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-62%);
  width: 68rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e0ad69;
  font-size: 72rpx;
  line-height: 72rpx;
}

.icon-hover {
  opacity: 0.72;
}

.page-title {
  color: #e5b978;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.state-panel {
  margin-top: 160rpx;
  padding: 48rpx 28rpx;
  text-align: center;
  color: rgba(243, 228, 200, 0.8);
  border: 1rpx solid rgba(184, 132, 66, 0.34);
  background: rgba(25, 19, 14, 0.82);
}

.state-panel.is-error {
  color: #f0b0a4;
}

.result-story {
  margin-top: 24rpx;
  min-height: 220rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(197, 139, 72, 0.54);
  background:
    linear-gradient(135deg, rgba(33, 24, 16, 0.9), rgba(5, 31, 34, 0.82)),
    #14110d;
  box-shadow: 0 18rpx 58rpx rgba(0, 0, 0, 0.35);
}

.result-story-image {
  display: block;
  width: 100%;
}

.section {
  margin-top: 34rpx;
}

.section-title {
  margin-bottom: 18rpx;
  color: #e6c27e;
  font-size: 30rpx;
  font-weight: 700;
}

.section-body {
  padding: 18rpx 20rpx;
  color: rgba(244, 226, 197, 0.9);
  background: rgba(4, 17, 19, 0.62);
  font-size: 27rpx;
  line-height: 1.58;
}

.final-policy-tracks {
  display: grid;
  gap: 18rpx;
}

.player-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
}

.player-card {
  position: relative;
  height: 152rpx;
  overflow: visible;
}

.player-card.is-me {
  filter: drop-shadow(0 0 10rpx rgba(226, 190, 123, 0.36));
}

.player-plate,
.player-plate-fallback {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.player-plate {
  z-index: 1;
}

.player-plate-fallback {
  z-index: 0;
  box-sizing: border-box;
  border: 1rpx solid rgba(184, 132, 66, 0.32);
  background:
    linear-gradient(90deg, rgba(35, 26, 18, 0.94) 0 56rpx, rgba(178, 145, 98, 0.9) 56rpx),
    #b39162;
}

.player-card-inner {
  position: relative;
  z-index: 2;
  height: 100%;
  box-sizing: border-box;
  padding: 28rpx 44rpx 24rpx 70rpx;
  display: grid;
  grid-template-columns: 74rpx minmax(0, 1fr) 190rpx;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 74rpx;
  height: 74rpx;
  box-sizing: border-box;
  border: 2rpx solid rgba(67, 43, 24, 0.64);
  border-radius: 50%;
  background: rgba(232, 200, 143, 0.14);
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2b1d12;
  font-weight: 800;
}

.player-name {
  min-width: 0;
  color: #2b1d12;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-role-chip {
  justify-self: center;
  width: 180rpx;
  height: 48rpx;
}

.timeline {
  border-left: 1rpx solid rgba(184, 132, 66, 0.36);
  padding-left: 22rpx;
}

.timeline-item {
  position: relative;
  padding: 0 0 24rpx;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: -29rpx;
  top: 8rpx;
  width: 12rpx;
  height: 12rpx;
  background: #d3a45d;
}

.timeline-meta {
  color: rgba(232, 200, 143, 0.64);
  font-size: 22rpx;
}

.timeline-title {
  margin-top: 6rpx;
  color: #f5e7cf;
  font-size: 27rpx;
  font-weight: 700;
}

.timeline-summary {
  margin-top: 6rpx;
  color: rgba(243, 228, 200, 0.74);
  font-size: 24rpx;
  line-height: 1.5;
  white-space: pre-line;
}

.timeline-vote-groups {
  margin-top: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.timeline-vote-line {
  min-width: 0;
  color: rgba(243, 228, 200, 0.74);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
  overflow-wrap: anywhere;
}

.bottom-actions {
  padding: 30rpx 0 10rpx;
}

.primary-action {
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #20150f;
  background: #d2a15c;
  font-size: 28rpx;
  font-weight: 700;
}
