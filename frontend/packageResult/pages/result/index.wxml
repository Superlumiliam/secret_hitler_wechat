<view class="result-page">
  <view class="top-bar">
    <view class="back-control" role="button" aria-label="返回首页" bindtap="onBackHome" hover-class="icon-hover">‹</view>
    <view class="page-title">对局结果</view>
  </view>

  <view wx:if="{{loading}}" class="state-panel">正在打开复盘档案...</view>
  <view wx:elif="{{errorText}}" class="state-panel is-error">
    <view>{{errorText}}</view>
    <view class="primary-action" role="button" aria-label="返回首页" bindtap="onBackHome">返回首页</view>
  </view>

  <block wx:elif="{{result}}">
    <view class="result-story">
      <image
        wx:if="{{resultImageSrc}}"
        class="result-story-image"
        src="{{resultImageSrc}}"
        mode="widthFix"
        webp="{{true}}"
        data-asset-key="{{result.resultImageAssetKey}}"
        binderror="onResultAssetError"
      ></image>
    </view>

    <view class="section">
      <view class="section-title">对局结束原因</view>
      <view class="section-body">{{result.winReasonText}}</view>
    </view>

    <view class="section">
      <view class="section-title">最终政策轨</view>
      <view class="final-policy-tracks">
        <policy-track
          faction="liberal"
          assets="{{policyAssets}}"
          slots="{{result.policySummary.liberalTrack}}"
          count="{{result.policySummary.liberal}}"
          total="{{5}}"
          show-progress="{{false}}"
        ></policy-track>
        <policy-track
          faction="fascist"
          assets="{{policyAssets}}"
          slots="{{result.policySummary.fascistTrack}}"
          count="{{result.policySummary.fascist}}"
          total="{{6}}"
          show-progress="{{false}}"
          active-power-tip-slot="{{activePowerTipSlot}}"
          bind:togglepowertip="onTogglePowerTip"
        ></policy-track>
      </view>
    </view>

    <view class="section">
      <view class="section-title">最终身份</view>
      <view class="player-grid">
        <view wx:for="{{result.players}}" wx:key="memberId" class="{{item.className}}">
          <image
            wx:if="{{item.identityPlateSrc}}"
            class="player-plate"
            src="{{item.identityPlateSrc}}"
            mode="scaleToFill"
            webp="{{true}}"
          ></image>
          <view class="player-plate-fallback"></view>
          <view class="player-card-inner">
            <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar placeholder">{{item.seatIndex}}</view>
            <view class="player-name">{{item.seatIndex}}号 {{item.displayName}}</view>
            <image
              wx:if="{{item.roleChipSrc}}"
              class="player-role-chip"
              src="{{item.roleChipSrc}}"
              mode="scaleToFill"
              webp="{{true}}"
            ></image>
          </view>
        </view>
      </view>
    </view>

    <view class="section timeline-section">
      <view class="section-title">关键时间线</view>
      <view class="timeline">
        <view wx:for="{{result.timeline}}" wx:key="eventId" class="timeline-item">
          <view class="timeline-meta">{{item.roundText}} · {{item.timeText}}</view>
          <view class="timeline-title">{{item.title}}</view>
          <view wx:if="{{item.showSummary}}" class="timeline-summary">{{item.summary}}</view>
          <block wx:if="{{item.legislativeReview}}">
            <view wx:for="{{item.legislativeReview.lines}}" wx:for-item="reviewLine" wx:key="*this" class="timeline-summary">{{reviewLine}}</view>
          </block>
          <view
            wx:if="{{item.showVoteGroups}}"
            class="timeline-vote-groups"
          >
            <view
              wx:for="{{item.voteGroupRows}}"
              wx:for-item="voteItem"
              wx:key="key"
              class="timeline-vote-line"
            >
              {{voteItem.lineText}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="bottom-actions">
      <view class="primary-action" role="button" aria-label="返回首页" bindtap="onBackHome">返回首页</view>
    </view>
  </block>
</view>
