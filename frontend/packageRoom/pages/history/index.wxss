page {
  min-height: 100vh;
  background: #061016;
}

.history-page {
  position: relative;
  min-height: 100vh;
  padding: calc(96rpx + env(safe-area-inset-top)) 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  color: #d7a35d;
  font-family: "Songti SC", STSong, SimSun, serif;
  background:
    radial-gradient(circle at 52% 15%, rgba(31, 183, 188, 0.16), transparent 32%),
    radial-gradient(circle at 50% 54%, rgba(73, 45, 23, 0.24), transparent 46%),
    linear-gradient(180deg, #061719 0%, #020809 100%);
}

.history-background,
.history-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.history-background {
  z-index: 0;
}

.history-overlay {
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(1, 8, 10, 0.08) 0%, rgba(1, 8, 10, 0.24) 45%, rgba(1, 5, 8, 0.74) 100%),
    radial-gradient(circle at 50% 14%, rgba(31, 183, 188, 0.12), transparent 34%);
}

.page-frame {
  position: fixed;
  z-index: 1;
  inset: 10rpx;
  pointer-events: none;
  border: 2rpx solid rgba(158, 92, 42, 0.72);
  box-shadow:
    inset 0 0 0 3rpx rgba(4, 17, 18, 0.88),
    inset 0 0 90rpx rgba(0, 0, 0, 0.86);
}

.page-frame::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 1rpx;
  background: rgba(186, 129, 62, 0.3);
}

.page-frame::after {
  bottom: 20rpx;
}

.top-bar,
.room-strip,
.summary-board,
.round-list,
.history-loading {
  position: relative;
  z-index: 2;
}

.top-bar {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(185, 128, 66, 0.44);
  border-bottom: 1rpx solid rgba(185, 128, 66, 0.34);
  background: rgba(2, 12, 15, 0.52);
}

.back-control {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-62%);
  width: 68rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e0ad69;
  font-size: 72rpx;
  line-height: 72rpx;
}

.icon-hover {
  opacity: 0.72;
}

.page-title {
  color: #e5b978;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.room-strip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 1rpx solid rgba(169, 100, 48, 0.28);
}

.room-code-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.room-label {
  color: #d9a464;
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}

.room-code {
  min-width: 0;
  color: #dca25f;
  font-size: 32rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-pill {
  min-width: 118rpx;
  height: 52rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(181, 109, 54, 0.66);
  border-radius: 28rpx;
  color: #e2b572;
  font-size: 26rpx;
  background: rgba(5, 20, 21, 0.78);
  white-space: nowrap;
}

.summary-board {
  position: relative;
  margin-top: 24rpx;
  padding: 34rpx 28rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  overflow: hidden;
  border: 0;
  background: rgba(3, 17, 18, 0.62);
  box-shadow:
    0 16rpx 42rpx rgba(0, 0, 0, 0.24),
    inset 0 0 34rpx rgba(221, 136, 53, 0.08);
}

.board-frame-image,
.round-frame-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.summary-item {
  position: relative;
  z-index: 1;
  min-width: 0;
  min-height: 156rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid rgba(154, 88, 43, 0.46);
}

.summary-item:last-child {
  border-right: 0;
}

.summary-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #dca765;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.summary-value {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #d79a52;
}

.big-number {
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
}

.limit-text {
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.summary-foot {
  margin-top: 8rpx;
  color: #d3a166;
  font-size: 20rpx;
}

.summary-item.is-liberal .summary-label,
.summary-item.is-liberal .summary-value {
  color: #13a6d2;
}

.summary-item.is-fascist .summary-label,
.summary-item.is-fascist .summary-value {
  color: #d2412f;
}

.round-list {
  position: relative;
  margin-top: 26rpx;
  padding-left: 52rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.round-list::before {
  content: "";
  position: absolute;
  left: 17rpx;
  top: 42rpx;
  bottom: 42rpx;
  width: 3rpx;
  background: linear-gradient(180deg, rgba(193, 126, 56, 0.36), #c48638 12%, #c48638 88%, rgba(193, 126, 56, 0.36));
  box-shadow: 0 0 10rpx rgba(194, 126, 53, 0.3);
}

.round-board {
  position: relative;
  min-height: 258rpx;
  box-sizing: border-box;
  overflow: visible;
  border-radius: 22rpx;
  border: 0;
  background:
    linear-gradient(180deg, rgba(6, 27, 28, 0.92), rgba(3, 16, 18, 0.94)),
    repeating-linear-gradient(0deg, transparent 0, transparent 46rpx, rgba(171, 104, 45, 0.1) 47rpx);
  box-shadow:
    0 18rpx 40rpx rgba(0, 0, 0, 0.28),
    inset 0 0 34rpx rgba(222, 132, 52, 0.06);
}

.round-board::before {
  content: "";
  position: absolute;
  z-index: 2;
  left: -48rpx;
  top: 44rpx;
  width: 28rpx;
  height: 28rpx;
  box-sizing: border-box;
  border: 5rpx solid #bb7832;
  border-radius: 50%;
  background: #071719;
  box-shadow:
    0 0 0 4rpx #2d2115,
    0 0 0 6rpx rgba(199, 138, 63, 0.72),
    0 0 16rpx rgba(205, 143, 67, 0.46);
}

.round-header {
  position: relative;
  z-index: 1;
  min-height: 92rpx;
  padding: 22rpx 26rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  flex-wrap: wrap;
  border-bottom: 1rpx solid rgba(151, 91, 39, 0.42);
}

.round-result-group {
  flex: 0 1 auto;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 10rpx;
}

.round-title {
  min-width: 0;
  color: #e4b36f;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.7);
}

.round-result-badge {
  flex: 0 0 auto;
  transform: translateY(10rpx);
  min-height: 54rpx;
  padding: 8rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(191, 129, 56, 0.72);
  color: #edc993;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
  white-space: nowrap;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.74);
  box-shadow:
    inset 0 0 14rpx rgba(0, 0, 0, 0.28),
    0 5rpx 10rpx rgba(0, 0, 0, 0.2);
}

.round-result-badge.is-passed {
  border-color: rgba(31, 146, 181, 0.82);
  background: linear-gradient(180deg, rgba(16, 99, 126, 0.92), rgba(9, 58, 76, 0.94));
}

.round-result-badge.is-failed {
  border-color: rgba(172, 60, 46, 0.88);
  background: linear-gradient(180deg, rgba(127, 42, 34, 0.94), rgba(77, 24, 22, 0.96));
}

.round-result-badge.is-liberal {
  border-color: rgba(28, 127, 160, 0.86);
  background: linear-gradient(180deg, rgba(19, 101, 132, 0.94), rgba(9, 57, 78, 0.96));
}

.round-result-badge.is-fascist {
  border-color: rgba(171, 59, 45, 0.9);
  background: linear-gradient(180deg, rgba(133, 43, 35, 0.94), rgba(79, 24, 22, 0.96));
}

.round-details {
  position: relative;
  z-index: 1;
  padding: 12rpx 26rpx 24rpx;
}

.history-detail-row {
  min-height: 66rpx;
  padding: 9rpx 0;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 108rpx minmax(0, 1fr);
  align-items: start;
  gap: 22rpx;
  border-bottom: 1rpx solid rgba(142, 86, 38, 0.26);
}

.history-detail-row:last-child {
  border-bottom: 0;
}

.history-detail-label {
  min-height: 50rpx;
  padding: 6rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(186, 125, 55, 0.72);
  color: #e7c18a;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.2;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.72);
  box-shadow: inset 0 0 12rpx rgba(0, 0, 0, 0.28);
}

.history-detail-label.is-president,
.history-detail-label.is-chancellor {
  background: linear-gradient(180deg, rgba(124, 83, 19, 0.92), rgba(75, 48, 10, 0.94));
}

.history-detail-label.is-ja {
  border-color: rgba(28, 127, 160, 0.86);
  background: linear-gradient(180deg, rgba(19, 101, 132, 0.94), rgba(9, 57, 78, 0.96));
}

.history-detail-label.is-nein {
  border-color: rgba(171, 59, 45, 0.9);
  background: linear-gradient(180deg, rgba(133, 43, 35, 0.94), rgba(79, 24, 22, 0.96));
}

.history-player-cards {
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.history-detail-content {
  min-width: 0;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.history-action-text {
  color: #e4c28f;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
  white-space: nowrap;
}

.history-action-content {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.history-player-card {
  min-width: 74rpx;
  min-height: 50rpx;
  padding: 6rpx 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(181, 124, 61, 0.62);
  border-radius: 8rpx;
  color: #e5c18b;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
  background: rgba(7, 28, 28, 0.82);
  box-shadow:
    inset 0 0 10rpx rgba(0, 0, 0, 0.26),
    0 3rpx 7rpx rgba(0, 0, 0, 0.18);
}

.history-player-card.is-empty {
  color: rgba(224, 193, 145, 0.62);
}

.history-loading {
  min-height: 72vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: #d7a35d;
  font-size: 28rpx;
}

.retry-action {
  min-width: 140rpx;
  height: 56rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(215, 163, 93, 0.7);
  color: #e2b572;
  background: rgba(5, 20, 21, 0.82);
}
