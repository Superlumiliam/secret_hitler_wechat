page {
  min-height: 100vh;
  background: #061016;
}

.history-page {
  position: relative;
  min-height: 100vh;
  padding: calc(96rpx + env(safe-area-inset-top)) 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  color: #d7a35d;
  font-family: "Songti SC", STSong, SimSun, serif;
  background:
    radial-gradient(circle at 52% 15%, rgba(31, 183, 188, 0.16), transparent 32%),
    radial-gradient(circle at 50% 54%, rgba(73, 45, 23, 0.24), transparent 46%),
    linear-gradient(180deg, #061719 0%, #020809 100%);
}

.history-background,
.history-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.history-background {
  z-index: 0;
}

.history-overlay {
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(1, 8, 10, 0.08) 0%, rgba(1, 8, 10, 0.24) 45%, rgba(1, 5, 8, 0.74) 100%),
    radial-gradient(circle at 50% 14%, rgba(31, 183, 188, 0.12), transparent 34%);
}

.page-frame {
  position: fixed;
  z-index: 1;
  inset: 10rpx;
  pointer-events: none;
  border: 2rpx solid rgba(158, 92, 42, 0.72);
  box-shadow:
    inset 0 0 0 3rpx rgba(4, 17, 18, 0.88),
    inset 0 0 90rpx rgba(0, 0, 0, 0.86);
}

.page-frame::before,
.page-frame::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 1rpx;
  background: rgba(186, 129, 62, 0.3);
}

.page-frame::before {
  top: 122rpx;
}

.page-frame::after {
  bottom: 20rpx;
}

.top-bar,
.room-strip,
.summary-board,
.round-list,
.legend,
.history-loading {
  position: relative;
  z-index: 2;
}

.top-bar {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(185, 128, 66, 0.44);
  border-bottom: 1rpx solid rgba(185, 128, 66, 0.34);
  background: rgba(2, 12, 15, 0.52);
}

.back-control {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-62%);
  width: 68rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e0ad69;
  font-size: 72rpx;
  line-height: 72rpx;
}

.icon-hover {
  opacity: 0.72;
}

.title-wrap {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.wing-line {
  width: 92rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(199, 135, 67, 0.82), transparent);
}

.page-title {
  color: #e5b978;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.room-strip {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 1rpx solid rgba(169, 100, 48, 0.28);
}

.room-code-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 18rpx;
}

.room-label {
  color: #d9a464;
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}

.room-code {
  min-width: 0;
  color: #dca25f;
  font-size: 32rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header-pill {
  min-width: 118rpx;
  height: 52rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(181, 109, 54, 0.66);
  border-radius: 28rpx;
  color: #e2b572;
  font-size: 26rpx;
  background: rgba(5, 20, 21, 0.78);
  white-space: nowrap;
}

.summary-board {
  position: relative;
  margin-top: 24rpx;
  padding: 34rpx 28rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  overflow: hidden;
  border: 0;
  background: rgba(3, 17, 18, 0.62);
  box-shadow:
    0 16rpx 42rpx rgba(0, 0, 0, 0.24),
    inset 0 0 34rpx rgba(221, 136, 53, 0.08);
}

.board-frame-image,
.round-frame-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.summary-item {
  position: relative;
  z-index: 1;
  min-width: 0;
  min-height: 156rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid rgba(154, 88, 43, 0.46);
}

.summary-item:last-child {
  border-right: 0;
}

.summary-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #dca765;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.summary-value {
  margin-top: 14rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #d79a52;
}

.big-number {
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1;
}

.limit-text {
  margin-left: 8rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.summary-foot {
  margin-top: 8rpx;
  color: #d3a166;
  font-size: 20rpx;
}

.summary-item.is-liberal .summary-label,
.summary-item.is-liberal .summary-value {
  color: #13a6d2;
}

.summary-item.is-fascist .summary-label,
.summary-item.is-fascist .summary-value {
  color: #d2412f;
}

.round-list {
  margin-top: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.round-board {
  position: relative;
  min-height: 236rpx;
  padding: 28rpx 26rpx 28rpx 24rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
  grid-template-rows: auto auto auto;
  column-gap: 22rpx;
  row-gap: 18rpx;
  align-items: stretch;
  overflow: hidden;
  border: 0;
  background: rgba(3, 16, 18, 0.7);
  box-shadow:
    0 16rpx 40rpx rgba(0, 0, 0, 0.22),
    inset 0 0 28rpx rgba(222, 132, 52, 0.07);
}

.round-divider {
  position: absolute;
  z-index: 1;
  left: 192rpx;
  top: 30rpx;
  bottom: 30rpx;
  width: 1rpx;
  background: rgba(159, 91, 44, 0.58);
}

.round-side {
  position: relative;
  z-index: 1;
  grid-row: 1 / 4;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-right: 10rpx;
}

.round-medal {
  position: relative;
  width: 118rpx;
  height: 118rpx;
  display: grid;
  grid-template-columns: auto auto auto;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  color: #d7a35d;
  background: radial-gradient(circle, rgba(8, 28, 30, 0.76), rgba(3, 12, 14, 0.48));
}

.round-ring-image {
  position: absolute;
  left: -15rpx;
  top: -15rpx;
  width: 148rpx;
  height: 148rpx;
  pointer-events: none;
  opacity: 0.72;
}

.round-number {
  position: relative;
  z-index: 1;
  color: #e3ad6b;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.round-small {
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  font-weight: 800;
}

.round-main {
  position: relative;
  z-index: 1;
  min-width: 0;
  grid-column: 2;
  grid-row: 1;
  align-self: end;
  padding-left: 22rpx;
  padding-right: 0;
}

.round-line {
  min-width: 0;
  color: #d9a25f;
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.president-text {
  color: #16a5d1;
}

.chancellor-text {
  color: #e0a13f;
}

.role-text {
  color: #d3a166;
}

.vote-result-line {
  min-width: 0;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  color: #d8a05e;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.28;
}

.vote-result-label {
  color: #d8a05e;
}

.vote-result-text {
  margin-top: 4rpx;
  color: #e0b26f;
  max-width: calc(100% - 206rpx);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vote-strip {
  position: relative;
  z-index: 1;
  grid-column: 2;
  grid-row: 2;
  margin-left: 22rpx;
  display: grid;
  grid-template-columns: repeat(10, minmax(0, 1fr));
  border-top: 1rpx solid rgba(102, 67, 41, 0.72);
  border-left: 1rpx solid rgba(102, 67, 41, 0.72);
}

.vote-cell {
  min-width: 0;
  height: 82rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid rgba(102, 67, 41, 0.72);
  border-bottom: 1rpx solid rgba(102, 67, 41, 0.72);
  background: rgba(5, 18, 20, 0.46);
}

.seat-no {
  color: #dba45f;
  font-size: 22rpx;
  font-weight: 800;
}

.vote-mark {
  width: 32rpx;
  height: 32rpx;
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #061316;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
}

.vote-cell.is-ja .vote-mark {
  background: #108fc0;
  font-size: 22rpx;
}

.vote-cell.is-nein .vote-mark {
  background: #bf382b;
}

.vote-cell.is-dead .vote-mark {
  border: 1rpx solid rgba(190, 176, 150, 0.74);
  color: #d0c2a5;
  background: rgba(99, 88, 70, 0.28);
  font-size: 20rpx;
  box-shadow: inset 0 0 8rpx rgba(0, 0, 0, 0.34);
}

.vote-cell.is-pending .vote-mark,
.vote-cell.is-not_started .vote-mark {
  color: #8c704e;
  background: rgba(113, 83, 50, 0.18);
}

.executive-result {
  position: relative;
  z-index: 1;
  grid-column: 2;
  grid-row: 3;
  margin-left: 22rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(176, 125, 72, 0.32);
  color: #d9b178;
  font-size: 24rpx;
  line-height: 1.45;
}

.round-outcome {
  position: absolute;
  z-index: 1;
  right: 14rpx;
  top: 92rpx;
  width: 188rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outcome-badge {
  position: relative;
  width: 100%;
  height: 58rpx;
  min-height: 58rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 0;
  background: transparent;
  box-shadow: none;
}

.outcome-image {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.outcome-badge.is-liberal {
  box-shadow: none;
}

.outcome-badge.is-fascist {
  box-shadow: none;
}

.outcome-badge.is-failed,
.outcome-badge.is-veto,
.outcome-badge.is-chaos,
.outcome-badge.is-power,
.outcome-badge.is-win {
  border-color: rgba(210, 150, 64, 0.82);
  color: #e2b572;
}

.legend {
  min-height: 74rpx;
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: center;
  justify-content: stretch;
  gap: 0;
  color: #d5a062;
  font-size: 22rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-width: 0;
  white-space: nowrap;
}

.legend-dot {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #061316;
  font-size: 24rpx;
  font-weight: 900;
}

.legend-dot.is-ja {
  background: #108fc0;
  font-size: 22rpx;
}

.legend-dot.is-nein {
  background: #bf382b;
}

.legend-dot.is-dead {
  border: 1rpx solid rgba(190, 176, 150, 0.74);
  color: #d0c2a5;
  background: rgba(99, 88, 70, 0.28);
  font-size: 22rpx;
}

.legend-dot.is-pending {
  color: #d5a062;
  background: rgba(113, 83, 50, 0.24);
}

.history-loading {
  min-height: 72vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  color: #d7a35d;
  font-size: 28rpx;
}

.retry-action {
  min-width: 140rpx;
  height: 56rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(215, 163, 93, 0.7);
  color: #e2b572;
  background: rgba(5, 20, 21, 0.82);
}
