<view class="board-page">
  <view class="board-noise"></view>

  <block wx:if="{{board}}">
    <view class="top-bar">
      <view class="back-control" bindtap="onBackHome" hover-class="icon-hover" role="button" aria-label="返回首页">‹</view>
      <view class="page-title">对局桌面</view>
    </view>

    <view class="room-meta-row">
      <view class="room-head">
        <view class="room-title">
          <text class="room-label">房间号</text>
          <text class="room-code">{{board.roomCode}}</text>
        </view>
        <view class="round-pill">{{board.targetPlayerCount}}人局</view>
        <view class="round-pill">第{{board.roundNo}}轮</view>
      </view>
      <view class="top-actions">
        <view class="tool-control" bindtap="onTapRules" role="button" aria-label="规则说明">
          <view class="tool-icon rules-icon"></view>
          <view class="tool-text">规则说明</view>
        </view>
      </view>
    </view>

    <view class="board-layout">
      <view wx:if="{{isSoloRoom}}" class="solo-control-strip">
        <view class="solo-mark">单人模式</view>
        <view class="solo-seat">{{controlledSeatText}}</view>
        <view class="solo-hint">双击席位切换操控视角</view>
      </view>

      <view class="center-board">
        <phase-banner title="{{board.phaseName}}"></phase-banner>
        <policy-track faction="liberal" assets="{{policyAssets}}" slots="{{liberalTrack}}" count="{{board.liberalPolicyCount}}" total="{{5}}"></policy-track>
        <policy-track
          faction="fascist"
          assets="{{policyAssets}}"
          slots="{{fascistTrack}}"
          count="{{board.fascistPolicyCount}}"
          total="{{6}}"
          active-power-tip-slot="{{activePowerTipSlot}}"
          bind:togglepowertip="onTogglePowerTip"
        ></policy-track>
        <election-track assets="{{policyAssets}}" slots="{{electionTrack}}" election-tracker="{{board.electionTracker}}"></election-track>
        <deck-piles piles="{{board.deckPiles}}"></deck-piles>

        <view class="status-strip">
          <image wx:if="{{policyAssets.frameNarrow}}" class="status-frame-image" src="{{policyAssets.frameNarrow}}" mode="scaleToFill" webp="{{true}}"></image>
          <image wx:if="{{policyAssets.logoSeal}}" class="status-seal-icon" src="{{policyAssets.logoSeal}}" mode="aspectFit" webp="{{true}}"></image>
          <view class="status-copy">
            <view class="status-text">{{statusText}}</view>
            <view wx:if="{{phaseHintText}}" class="phase-hint-text">{{phaseHintText}}</view>
          </view>
        </view>

      </view>

      <seat-list
        assets="{{policyAssets}}"
        seats="{{seats}}"
        bind:tapseat="onTapSeat"
        bind:tapavatar="onTapAvatar"
        bind:tapidentitymark="onTapIdentityMark"
      ></seat-list>

      <view class="action-dock">
        <view wx:if="{{snapshot.currentPhase === 'executive_action' && !canAckPolicyPeek}}" class="executive-panel">
          <view class="executive-title">{{executiveAction.title || '总统权力'}}</view>
          <view wx:if="{{executiveAction.hint}}" class="executive-hint">{{executiveAction.hint}}</view>

          <view wx:if="{{canExecuteAction}}" class="executive-targets">
            <view wx:if="{{selectedExecutiveTargetLabel}}" class="executive-selected-title">已选择 {{selectedExecutiveTargetLabel}}</view>
            <view wx:else class="executive-selected-title">点击玩家席位选择目标</view>
            <view class="executive-submit {{selectedExecutiveTargetId ? '' : 'is-empty'}} {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapExecutiveSelected" role="button" aria-label="确认总统权力目标">
              <image wx:if="{{selectedExecutiveTargetId ? policyAssets.buttonBlue : policyAssets.buttonNormal}}" class="dock-button-frame" src="{{selectedExecutiveTargetId ? policyAssets.buttonBlue : policyAssets.buttonNormal}}" mode="scaleToFill" webp="{{true}}"></image>
              <view class="dock-button-text">{{executiveAction.confirmText || '确认'}}</view>
            </view>
          </view>

          <view wx:else class="executive-waiting">{{executiveAction.waitingText}}</view>
        </view>

        <view wx:if="{{vetoResponse}}" class="veto-response-panel">
          <view class="veto-response-title">{{vetoResponse.title}}</view>
          <view class="veto-response-hint">{{vetoResponse.hint}}</view>
          <view wx:if="{{canRespondVeto}}" class="veto-response-actions">
            <view class="veto-response-action accept-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapAcceptVeto" role="button" aria-label="同意否决">
              <image wx:if="{{policyAssets.buttonBlue}}" class="dock-button-frame" src="{{policyAssets.buttonBlue}}" mode="scaleToFill" webp="{{true}}"></image>
              <view class="dock-button-text">同意否决</view>
            </view>
            <view class="veto-response-action reject-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapRejectVeto" role="button" aria-label="拒绝否决">
              <image wx:if="{{policyAssets.buttonRed}}" class="dock-button-frame" src="{{policyAssets.buttonRed}}" mode="scaleToFill" webp="{{true}}"></image>
              <view class="dock-button-text">拒绝否决</view>
            </view>
          </view>
          <view wx:else class="veto-response-waiting">等待 {{vetoResponse.presidentName}} 回应</view>
        </view>

        <view wx:if="{{canNominate}}" class="nominate-panel">
          <view wx:if="{{selectedNominationTargetLabel}}" class="nominate-title">已选择 {{selectedNominationTargetLabel}}</view>
          <view wx:else class="nominate-title">点击玩家席位选择总理候选人</view>
          <view wx:if="{{nominateRuleHint}}" class="nominate-hint">{{nominateRuleHint}}</view>
          <view class="nominate-submit {{selectedNominationTargetId ? '' : 'is-empty'}} {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapNominateSelected" role="button" aria-label="提名总理候选人">
            <image wx:if="{{selectedNominationTargetId ? policyAssets.nominationButtonFrameBlue : policyAssets.nominationButtonFrame}}" class="dock-button-frame" src="{{selectedNominationTargetId ? policyAssets.nominationButtonFrameBlue : policyAssets.nominationButtonFrame}}" mode="scaleToFill" webp="{{true}}"></image>
            <view class="dock-button-text">提名</view>
          </view>
        </view>

        <view wx:if="{{canVote}}" class="action-panel">
          <view class="vote-action ja-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onVoteJa" hover-class="action-hover" role="button" aria-label="投赞成票">
            <image wx:if="{{policyAssets.buttonBlue}}" class="dock-button-frame" src="{{policyAssets.buttonBlue}}" mode="scaleToFill" webp="{{true}}"></image>
            <view class="dock-button-text">赞成 JA</view>
          </view>
          <view class="vote-action nein-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onVoteNein" hover-class="action-hover" role="button" aria-label="投反对票">
            <image wx:if="{{policyAssets.buttonRed}}" class="dock-button-frame" src="{{policyAssets.buttonRed}}" mode="scaleToFill" webp="{{true}}"></image>
            <view class="dock-button-text">反对 NEIN</view>
          </view>
        </view>

        <view class="secondary-actions">
          <view class="secondary-action" bindtap="onTapIdentity" hover-class="secondary-hover" role="button" aria-label="我的身份">
            <image wx:if="{{policyAssets.buttonNormal}}" class="dock-button-frame" src="{{policyAssets.buttonNormal}}" mode="scaleToFill" webp="{{true}}"></image>
            <view class="dock-button-text">我的身份</view>
          </view>
          <view class="secondary-action" bindtap="onTapHistory" hover-class="secondary-hover" role="button" aria-label="历史记录">
            <image wx:if="{{policyAssets.buttonNormal}}" class="dock-button-frame" src="{{policyAssets.buttonNormal}}" mode="scaleToFill" webp="{{true}}"></image>
            <view class="dock-button-text">历史记录</view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{canPickPolicy && !voteResultModalVisible}}" class="policy-modal-mask" catchtap="onStopTap">
      <view class="policy-modal" catchtap="onStopTap" role="dialog" aria-label="{{policyPickerTitle}}">
        <image wx:if="{{policyAssets.modalFrameMobile}}" class="policy-modal-frame" src="{{policyAssets.modalFrameMobile}}" mode="scaleToFill" webp="{{true}}"></image>
        <view class="policy-modal-content">
          <view class="policy-modal-title">{{policyPickerTitle}}</view>
          <view wx:if="{{policyPickerHint}}" class="policy-modal-hint">{{policyPickerHint}}</view>
          <view class="policy-choice-row {{canEnactPolicy ? 'is-two-cards' : 'is-three-cards'}}">
            <view
              wx:for="{{policyCards}}"
              wx:key="index"
              class="policy-choice-item {{item.policy === 'LIBERAL' ? 'is-liberal' : 'is-fascist'}} {{isSubmittingCommand ? 'is-disabled' : ''}}"
              catchtap="onTapPolicyCard"
              hover-class="policy-choice-hover"
              data-index="{{item.index}}"
              role="button"
              aria-label="{{canEnactPolicy ? '颁布此政策牌' : '弃掉此政策牌'}}"
            >
              <image wx:if="{{item.cardSrc}}" class="policy-choice-card-image" src="{{item.cardSrc}}" mode="aspectFit" webp="{{true}}"></image>
              <view wx:else class="policy-choice-card-fallback">
                <view class="policy-card-mark">{{item.mark}}</view>
                <view class="policy-card-title">{{item.title}}</view>
              </view>
            </view>
          </view>
          <view wx:if="{{canRequestVeto}}" class="policy-veto-action {{isSubmittingCommand ? 'is-disabled' : ''}}" catchtap="onTapRequestVeto" role="button" aria-label="提出否决">
            <image wx:if="{{policyAssets.modalFrameButtonMobile}}" class="policy-veto-action-image" src="{{policyAssets.modalFrameButtonMobile}}" mode="scaleToFill" webp="{{true}}"></image>
            <text class="policy-veto-action-text">提出否决</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{canAckPolicyPeek && !voteResultModalVisible}}" class="policy-modal-mask" catchtap="onStopTap">
      <view class="policy-modal policy-peek-modal" catchtap="onStopTap" role="dialog" aria-label="政策预览">
        <image wx:if="{{policyAssets.modalFrameMobile}}" class="policy-modal-frame" src="{{policyAssets.modalFrameMobile}}" mode="scaleToFill" webp="{{true}}"></image>
        <view class="policy-modal-content">
          <view class="policy-modal-title">{{executiveAction.title || '政策预览'}}</view>
          <view wx:if="{{executiveAction.hint}}" class="policy-modal-hint">{{executiveAction.hint}}</view>
          <view class="policy-choice-row is-three-cards policy-peek-row">
            <view wx:for="{{policyPeekCards}}" wx:key="index" class="policy-choice-item {{item.policy === 'LIBERAL' ? 'is-liberal' : 'is-fascist'}}">
              <image wx:if="{{item.cardSrc}}" class="policy-choice-card-image" src="{{item.cardSrc}}" mode="aspectFit" webp="{{true}}"></image>
              <view wx:else class="policy-choice-card-fallback">
                <view class="policy-card-mark">{{item.mark}}</view>
                <view class="policy-card-title">{{item.title}}</view>
              </view>
            </view>
          </view>
          <view class="policy-peek-confirm {{isSubmittingCommand ? 'is-disabled' : ''}}" catchtap="onTapPolicyPeekAck" role="button" aria-label="确认政策预览">
            <image wx:if="{{policyAssets.modalCancelButtonMobile}}" class="policy-peek-confirm-image" src="{{policyAssets.modalCancelButtonMobile}}" mode="scaleToFill" webp="{{true}}"></image>
            <text class="policy-peek-confirm-text">确认</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeIdentityPickerMemberId}}" class="identity-modal-mask" catchtap="onCancelIdentityPicker">
      <view class="identity-modal" catchtap="onStopTap">
        <image wx:if="{{policyAssets.modalFrameMobile}}" class="identity-modal-frame" src="{{policyAssets.modalFrameMobile}}" mode="scaleToFill" webp="{{true}}"></image>
        <view class="identity-modal-content">
          <view class="identity-modal-title">阵营标记</view>
          <view class="identity-modal-icon-row">
            <view
              wx:for="{{activeIdentityPickerOptions}}"
              wx:key="value"
              class="{{item.optionClass}}"
              catchtap="onTapIdentityOption"
              data-member-id="{{item.memberId}}"
              data-value="{{item.value}}"
              role="button"
              aria-label="{{item.label}}"
            >
              <image wx:if="{{item.iconSrc}}" class="identity-option-image" src="{{item.iconSrc}}" mode="aspectFill" webp="{{true}}"></image>
            </view>
          </view>
          <view class="identity-modal-label-row">
            <view wx:for="{{activeIdentityPickerOptions}}" wx:key="value" class="identity-option-label">{{item.label}}</view>
          </view>
          <view class="identity-modal-cancel" catchtap="onCancelIdentityPicker" role="button" aria-label="取消阵营标记">
            <image wx:if="{{policyAssets.modalCancelButtonMobile}}" class="identity-modal-cancel-image" src="{{policyAssets.modalCancelButtonMobile}}" mode="scaleToFill" webp="{{true}}"></image>
            <text class="identity-modal-cancel-text">取消</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{voteResultModalVisible && voteResult}}" class="vote-result-modal-mask" catchtap="onStopTap">
      <view class="vote-result-modal {{voteResult.resultClass}}" catchtap="onStopTap" role="dialog" aria-label="投票结果">
        <image wx:if="{{policyAssets.modalFrameMobile}}" class="vote-result-modal-frame" src="{{policyAssets.modalFrameMobile}}" mode="scaleToFill" webp="{{true}}"></image>
        <view class="vote-result-modal-content">
          <view class="vote-result-title">{{voteResult.title}}</view>
          <view class="vote-result-detail">{{voteResult.detailText}}</view>
          <view class="vote-reveal-row">
            <view wx:for="{{voteResult.voteRows}}" wx:key="memberId" class="vote-reveal-item {{item.voteClass}}">
              <text class="vote-reveal-name">{{item.name}}</text>
              <text class="vote-reveal-mark">{{item.voteText}}</text>
            </view>
          </view>
          <view class="vote-result-confirm" catchtap="onConfirmVoteResult" hover-class="action-hover" role="button" aria-label="确认投票结果">
            <image wx:if="{{policyAssets.modalCancelButtonMobile}}" class="vote-result-confirm-image" src="{{policyAssets.modalCancelButtonMobile}}" mode="scaleToFill" webp="{{true}}"></image>
            <text class="vote-result-confirm-text">确认</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{investigationReveal && (investigationReveal.visible || investigationReveal.exiting)}}" class="investigation-reveal-mask" catchtap="onDismissInvestigationReveal">
      <view class="investigation-reveal-card {{investigationReveal.exiting ? 'is-exiting' : ''}}" catchtap="onDismissInvestigationReveal" role="button" aria-label="调查结果">
        <image wx:if="{{investigationReveal.cardSrc}}" class="investigation-reveal-image" src="{{investigationReveal.cardSrc}}" mode="aspectFit" webp="{{true}}"></image>
        <view wx:else class="investigation-reveal-fallback {{investigationReveal.partyClass}}">
          <view class="investigation-reveal-party">{{investigationReveal.partyText}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:elif="{{errorText}}" class="board-loading">{{errorText}}</view>
  <view wx:else class="board-loading">正在布置桌面...</view>
</view>
