<view class="board-page">
  <view class="board-noise"></view>

  <block wx:if="{{board}}">
    <view class="top-bar">
      <view class="back-control" bindtap="onBackHome" hover-class="icon-hover" role="button" aria-label="返回首页">‹</view>
    </view>

    <view class="room-meta-row">
      <view class="room-head">
        <view class="room-title">
          <text class="room-label">房间号</text>
          <text class="room-code">{{board.roomCode}}</text>
        </view>
        <view class="round-pill">{{board.targetPlayerCount}}人局</view>
        <view class="round-pill">第{{board.roundNo}}轮</view>
      </view>
      <view class="top-actions">
        <view class="tool-control" bindtap="onTapRules" role="button" aria-label="规则说明">
          <view class="tool-icon rules-icon"></view>
          <view class="tool-text">规则说明</view>
        </view>
      </view>
    </view>

    <view class="board-layout">
      <view wx:if="{{isDevRoom}}" class="dev-control-strip">
        <view class="dev-mark">开发者房间</view>
        <view class="dev-seat">{{controlledSeatText}}</view>
        <view class="dev-hint">双击席位切换操控视角</view>
      </view>

      <view class="center-board">
        <view class="phase-banner">
          <view class="eagle-mark"></view>
          <view class="phase-title">{{board.phaseName}}</view>
        </view>

        <view class="track-panel liberal-panel">
          <view class="policy-track-shell liberal-track-shell">
            <image wx:if="{{policyAssets.liberalBg}}" class="policy-track-bg" src="{{policyAssets.liberalBg}}" mode="aspectFill" webp="{{true}}"></image>
            <view class="policy-row liberal-row">
              <view wx:for="{{liberalTrack}}" wx:key="slot" class="{{item.cellClass}}">
                <image wx:if="{{item.cardSrc}}" class="policy-card-image" src="{{item.cardSrc}}" mode="aspectFit" webp="{{true}}"></image>
                <text wx:else class="policy-label">{{item.label}}</text>
              </view>
            </view>
          </view>
          <view class="track-progress">已颁布 <text class="progress-count">{{board.liberalPolicyCount}}</text> / 5</view>
        </view>

        <view class="track-panel fascist-panel">
          <view class="policy-track-shell fascist-track-shell">
            <image wx:if="{{policyAssets.authoritarianBg}}" class="policy-track-bg" src="{{policyAssets.authoritarianBg}}" mode="aspectFill" webp="{{true}}"></image>
            <view class="policy-row fascist-row">
              <view wx:for="{{fascistTrack}}" wx:key="slot" class="{{item.cellClass}}">
                <image wx:if="{{item.cardSrc}}" class="policy-card-image" src="{{item.cardSrc}}" mode="aspectFit" webp="{{true}}"></image>
                <text wx:else class="policy-label">{{item.label}}</text>
                <view
                  wx:if="{{item.powerBadgeSrc}}"
                  class="power-badge-control"
                  catchtap="onTogglePowerTip"
                  data-slot="{{item.slot}}"
                  role="button"
                  aria-label="总统权力：{{item.power}}"
                >
                  <image
                    class="power-badge-image"
                    src="{{item.powerBadgeSrc}}"
                    mode="aspectFit"
                    webp="{{true}}"
                  ></image>
                  <view wx:if="{{activePowerTipSlot == item.slot}}" class="power-tip">总统权力：{{item.power}}</view>
                </view>
              </view>
            </view>
          </view>
          <view class="track-progress fascist-progress">已颁布 <text class="progress-count fascist-count">{{board.fascistPolicyCount}}</text> / 6</view>
          <view wx:if="{{board.fascistPolicyCount >= 5}}" class="veto-note">第5张后，立法阶段永久解锁否决权</view>
        </view>

        <view class="election-panel">
          <view class="track-title">选举计数器（3格）</view>
          <view class="election-row">
            <view wx:for="{{electionTrack}}" wx:key="slot" class="{{item.cellClass}}">{{item.slot}}</view>
          </view>
          <view class="election-progress">当前进度 {{board.electionTracker}} / 3</view>
        </view>

        <view class="deck-piles-panel">
          <view wx:for="{{board.deckPiles}}" wx:key="key" class="{{item.pileClass}}">
            <view class="deck-card-stack" aria-hidden="true">
              <view class="deck-card-shadow"></view>
              <view class="deck-card-back">
                <view class="deck-card-frame"></view>
                <view class="deck-card-seal"></view>
              </view>
            </view>
            <view class="deck-pile-copy">
              <view class="deck-pile-label">{{item.label}}</view>
              <view class="deck-pile-count">{{item.countText}}</view>
            </view>
          </view>
        </view>

        <view class="status-strip">
          <view class="status-icon">♟</view>
          <view class="status-copy">
            <view class="status-text">{{statusText}}</view>
            <view wx:if="{{phaseHintText}}" class="phase-hint-text">{{phaseHintText}}</view>
          </view>
        </view>

        <view wx:if="{{voteProgressText || voteResult}}" class="vote-panel {{voteResult ? voteResult.resultClass : ''}}">
          <view wx:if="{{voteProgressText && !voteResult}}" class="vote-progress-text">{{voteProgressText}}</view>
          <block wx:if="{{voteResult}}">
            <view class="vote-result-title">{{voteResult.title}}</view>
            <view class="vote-result-detail">{{voteResult.detailText}}</view>
            <view class="vote-reveal-row">
              <view wx:for="{{voteResult.voteRows}}" wx:key="memberId" class="vote-reveal-item {{item.voteClass}}">
                <text class="vote-reveal-name">{{item.name}}</text>
                <text class="vote-reveal-mark">{{item.voteText}}</text>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="seat-row">
        <view wx:for="{{seats}}" wx:key="seatNo" class="{{item.seatClass}}" bindtap="onTapSeat" data-member-id="{{item.memberId}}" role="button" aria-label="双击切换操控席位">
          <view class="seat-art">
            <image wx:if="{{policyAssets.playerSeat}}" class="seat-frame-image" src="{{policyAssets.playerSeat}}" mode="aspectFill" webp="{{true}}"></image>
            <view class="seat-no">{{item.seatNo}}</view>
            <view
              class="avatar"
              catchtap="onTapAvatar"
              data-member-id="{{item.memberId}}"
              data-is-self="{{item.isSelf}}"
              role="button"
              aria-label="{{item.isSelf ? '查看我的身份' : '选择玩家席位'}}"
            >
              <image wx:if="{{item.avatarSrc}}" class="avatar-image" src="{{item.avatarSrc}}" mode="aspectFill" webp="{{true}}"></image>
            </view>
            <view class="seat-name">{{item.name}}</view>
            <view wx:if="{{item.roleBadgeSrc}}" class="role-badge" aria-label="{{item.roleLabel}}">
              <image class="role-badge-image" src="{{item.roleBadgeSrc}}" mode="aspectFill" webp="{{true}}"></image>
            </view>
            <image
              wx:if="{{item.investigationStampSrc}}"
              class="investigation-stamp"
              src="{{item.investigationStampSrc}}"
              mode="aspectFit"
              webp="{{true}}"
              aria-label="调查结果：{{item.investigationStampLabel}}"
            ></image>
            <view
              class="{{item.identityMark.className}}"
              catchtap="onTapIdentityMark"
              data-member-id="{{item.memberId}}"
              data-can-change="{{item.canChangeIdentityMark}}"
              role="button"
              aria-label="{{item.identityMark.label}}"
            >
              <image wx:if="{{item.identityMark.iconSrc}}" class="identity-mark-image" src="{{item.identityMark.iconSrc}}" mode="aspectFill" webp="{{true}}"></image>
            </view>
          </view>
        </view>
      </view>

      <view class="action-dock">
        <view wx:if="{{investigationResult}}" class="secret-result-panel">
          <view class="secret-result-title">调查结果</view>
          <view class="secret-result-text">{{investigationResult.targetName}} 属于 <text class="{{investigationResult.partyClass}}">{{investigationResult.partyText}}</text></view>
        </view>

        <view wx:if="{{snapshot.currentPhase === 'executive_action'}}" class="executive-panel">
          <view class="executive-title">{{executiveAction.title || '总统权力'}}</view>
          <view wx:if="{{executiveAction.hint}}" class="executive-hint">{{executiveAction.hint}}</view>

          <view wx:if="{{canExecuteAction && executiveAction.taskType === 'EXEC_POLICY_PEEK_ACK'}}" class="policy-picker-row is-three-cards">
            <view wx:for="{{policyPeekCards}}" wx:key="index" class="{{item.cardClass}}">
              <view class="policy-card-mark">{{item.mark}}</view>
              <view class="policy-card-title">{{item.title}}</view>
              <view class="policy-card-action">政策牌</view>
            </view>
          </view>

          <view wx:if="{{canExecuteAction && executiveAction.taskType === 'EXEC_POLICY_PEEK_ACK'}}" class="executive-confirm {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapPolicyPeekAck" role="button" aria-label="确认政策预览">
            {{executiveAction.confirmText || '确认已查看'}}
          </view>

          <view wx:elif="{{canExecuteAction}}" class="executive-targets">
            <view
              wx:for="{{executiveTargets}}"
              wx:key="memberId"
              class="executive-target {{item.canTarget ? '' : 'is-ineligible'}} {{isSubmittingCommand ? 'is-disabled' : ''}}"
              bindtap="onTapExecutiveTarget"
              data-member-id="{{item.memberId}}"
              data-can-target="{{item.canTarget}}"
              data-disabled-reason="{{item.disabledReason}}"
              role="button"
              aria-label="选择总统权力目标"
            >
              <view class="executive-target-label">{{item.label}}</view>
              <view wx:if="{{!item.canTarget}}" class="executive-target-reason">{{item.disabledReason}}</view>
            </view>
          </view>

          <view wx:else class="executive-waiting">{{executiveAction.waitingText}}</view>
        </view>

        <view wx:if="{{canPickPolicy}}" class="policy-picker-panel">
          <view class="policy-picker-title">{{policyPickerTitle}}</view>
          <view wx:if="{{policyPickerHint}}" class="policy-picker-hint">{{policyPickerHint}}</view>
          <view class="policy-picker-row {{canEnactPolicy ? 'is-two-cards' : ''}}">
            <view
              wx:for="{{policyCards}}"
              wx:key="index"
              class="{{item.cardClass}} {{isSubmittingCommand ? 'is-disabled' : ''}}"
              bindtap="onTapPolicyCard"
              data-index="{{item.index}}"
              role="button"
              aria-label="{{canEnactPolicy ? '颁布此政策牌' : '弃掉此政策牌'}}"
            >
              <view class="policy-card-mark">{{item.mark}}</view>
              <view class="policy-card-title">{{item.title}}</view>
              <view class="policy-card-action">{{canEnactPolicy ? '颁布此牌' : '弃掉此牌'}}</view>
            </view>
          </view>
          <view wx:if="{{canRequestVeto}}" class="veto-request-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapRequestVeto" role="button" aria-label="提出否决">
            提出否决
          </view>
        </view>

        <view wx:if="{{vetoResponse}}" class="veto-response-panel">
          <view class="veto-response-title">{{vetoResponse.title}}</view>
          <view class="veto-response-hint">{{vetoResponse.hint}}</view>
          <view wx:if="{{canRespondVeto}}" class="veto-response-actions">
            <view class="veto-response-action accept-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapAcceptVeto" role="button" aria-label="同意否决">同意否决</view>
            <view class="veto-response-action reject-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapRejectVeto" role="button" aria-label="拒绝否决">拒绝否决</view>
          </view>
          <view wx:else class="veto-response-waiting">等待 {{vetoResponse.presidentName}} 回应</view>
        </view>

        <view wx:if="{{canNominate}}" class="nominate-panel">
          <view wx:if="{{selectedNominationTargetLabel}}" class="nominate-title">已选择 {{selectedNominationTargetLabel}}</view>
          <view wx:else class="nominate-title">点击玩家席位选择总理候选人</view>
          <view wx:if="{{nominateRuleHint}}" class="nominate-hint">{{nominateRuleHint}}</view>
          <view class="nominate-submit {{selectedNominationTargetId ? '' : 'is-empty'}} {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onTapNominateSelected" role="button" aria-label="提名总理候选人">
            提名
          </view>
        </view>

        <view wx:if="{{canVote}}" class="action-panel">
          <view class="vote-action ja-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onVoteJa" hover-class="action-hover" role="button" aria-label="投赞成票">赞成 JA</view>
          <view class="vote-action nein-action {{isSubmittingCommand ? 'is-disabled' : ''}}" bindtap="onVoteNein" hover-class="action-hover" role="button" aria-label="投反对票">反对 NEIN</view>
        </view>

        <view wx:elif="{{votingSubmitted}}" class="vote-waiting-panel">
          <view class="vote-waiting-text">{{voteWaitingText}}</view>
        </view>

        <view class="secondary-actions">
          <view class="secondary-action" bindtap="onTapIdentity" hover-class="secondary-hover" role="button" aria-label="查看身份">查看身份</view>
          <view class="secondary-action" bindtap="onTapHistory" hover-class="secondary-hover" role="button" aria-label="历史记录">历史记录</view>
        </view>
      </view>
    </view>

    <view wx:if="{{activeIdentityPickerMemberId}}" class="identity-modal-mask" catchtap="onCancelIdentityPicker">
      <view class="identity-modal" catchtap="onStopTap">
        <image wx:if="{{policyAssets.modalFrameMobile}}" class="identity-modal-frame" src="{{policyAssets.modalFrameMobile}}" mode="scaleToFill" webp="{{true}}"></image>
        <view class="identity-modal-content">
          <view class="identity-modal-title">阵营标记</view>
          <view class="identity-modal-icon-row">
            <view
              wx:for="{{activeIdentityPickerOptions}}"
              wx:key="value"
              class="{{item.optionClass}}"
              catchtap="onTapIdentityOption"
              data-member-id="{{item.memberId}}"
              data-value="{{item.value}}"
              role="button"
              aria-label="{{item.label}}"
            >
              <image wx:if="{{item.iconSrc}}" class="identity-option-image" src="{{item.iconSrc}}" mode="aspectFill" webp="{{true}}"></image>
            </view>
          </view>
          <view class="identity-modal-label-row">
            <view wx:for="{{activeIdentityPickerOptions}}" wx:key="value" class="identity-option-label">{{item.label}}</view>
          </view>
          <view class="identity-modal-cancel" catchtap="onCancelIdentityPicker" role="button" aria-label="取消阵营标记">
            <image wx:if="{{policyAssets.modalCancelButtonMobile}}" class="identity-modal-cancel-image" src="{{policyAssets.modalCancelButtonMobile}}" mode="scaleToFill" webp="{{true}}"></image>
            <text class="identity-modal-cancel-text">取消</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:elif="{{errorText}}" class="board-loading">{{errorText}}</view>
  <view wx:else class="board-loading">正在布置桌面...</view>
</view>
