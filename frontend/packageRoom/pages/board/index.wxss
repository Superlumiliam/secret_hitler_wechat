  background: rgba(7, 24, 24, 0.88);
}

.nominate-title {
  color: #e8bf83;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.nominate-hint {
  margin-top: 6rpx;
  color: rgba(221, 190, 143, 0.78);
  font-size: 19rpx;
  line-height: 1.25;
  text-align: center;
}

.nominate-submit {
  position: relative;
  min-height: 58rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  color: #082024;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.16;
  text-align: center;
  background: rgba(27, 213, 223, 0.16);
  box-shadow: 0 0 14rpx rgba(31, 204, 215, 0.24);
  overflow: visible;
}

.nominate-submit.is-empty {
  color: rgba(226, 188, 139, 0.7);
  background: rgba(15, 22, 21, 0.88);
  box-shadow: none;
}

.nominate-submit.is-disabled {
  opacity: 0.56;
}

.action-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.vote-action {
  position: relative;
  height: 74rpx;
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  color: #041014;
  font-size: 25rpx;
  font-weight: 900;
  letter-spacing: 0;
  box-shadow: inset 0 0 22rpx rgba(255, 255, 255, 0.14), 0 0 22rpx rgba(0, 0, 0, 0.34);
  overflow: visible;
}

.vote-action.is-disabled {
  opacity: 0.55;
}

.ja-action {
  background: rgba(27, 213, 223, 0.16);
}

.nein-action {
  color: #f2c088;
  background: rgba(103, 25, 21, 0.36);
}

.secondary-actions {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.secondary-action {
  position: relative;
  width: 100%;
  min-width: 0;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  color: #e0b373;
  font-size: 25rpx;
  font-weight: 800;
  background: rgba(7, 24, 24, 0.72);
  overflow: visible;
}

.dock-button-frame {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  filter: drop-shadow(0 6rpx 8rpx rgba(0, 0, 0, 0.36));
}

.dock-button-text {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 88%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: inherit;
  line-height: 1.12;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.42);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.board-loading {
  position: relative;
  z-index: 2;
  margin-top: 320rpx;
  color: rgba(224, 179, 115, 0.76);
  font-size: 28rpx;
  text-align: center;
}

@media (max-width: 360px) {
  .policy-cell {
    font-size: 28rpx;
  }

  .phase-title {
    font-size: 32rpx;
  }

  .election-row {
    left: 29%;
    right: 29%;
  }

  .election-slot {
    width: 48rpx;
    height: 48rpx;
  }
}
