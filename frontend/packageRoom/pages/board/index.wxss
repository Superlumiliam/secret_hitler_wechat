page {
  min-height: 100vh;
  background: #031014;
}

.board-page {
  min-height: 100vh;
  padding: calc(160rpx + env(safe-area-inset-top)) 40rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #e0b06d;
  background: linear-gradient(180deg, #06171c 0%, #01080a 100%);
  font-family: "Songti SC", STSong, SimSun, serif;
}

.board-title {
  color: #20d8dc;
  font-size: 44rpx;
  font-weight: 900;
}

.board-room {
  margin-top: 28rpx;
  color: rgba(240, 212, 164, 0.82);
  font-size: 28rpx;
}
