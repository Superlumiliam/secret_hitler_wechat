.board-page {
  position: relative;
  min-height: 100vh;
  padding: calc(36rpx + env(safe-area-inset-top)) 18rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  color: #e1b373;
  background:
    radial-gradient(circle at 50% 48%, rgba(20, 52, 55, 0.6), transparent 42%),
    linear-gradient(180deg, #071719 0%, #02090a 100%);
  font-family: "Songti SC", STSong, SimSun, serif;
}

.board-noise {
  position: absolute;
  inset: 12rpx;
  pointer-events: none;
  border: 1rpx solid rgba(186, 129, 62, 0.52);
  box-shadow: inset 0 0 0 2rpx rgba(6, 22, 24, 0.78), inset 0 0 84rpx rgba(0, 0, 0, 0.8);
}

.board-noise::before,
.board-noise::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 1rpx;
  background: rgba(186, 129, 62, 0.34);
}

.board-noise::before {
  top: 96rpx;
}

.board-noise::after {
  bottom: 20rpx;
}

.top-bar {
  position: relative;
  z-index: 2;
  min-height: 74rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.back-control {
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e3b36e;
  font-size: 76rpx;
  line-height: 52rpx;
  text-shadow: 0 0 12rpx rgba(0, 0, 0, 0.75);
}

.icon-hover,
.action-hover,
.secondary-hover {
  opacity: 0.72;
}

.room-head {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.room-title {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.room-label {
  color: #e4af6e;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.room-code {
  max-width: 176rpx;
  color: #f0b160;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.round-pill {
  flex: 0 0 auto;
  min-width: 84rpx;
  height: 44rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(190, 129, 65, 0.66);
  border-radius: 28rpx;
  color: #e6bd83;
  font-size: 22rpx;
  background: rgba(9, 21, 23, 0.78);
  white-space: nowrap;
}

.top-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.tool-control {
  width: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #d9ad73;
}

.tool-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 4rpx;
}

.gear-icon {
  border-radius: 50%;
  border: 9rpx solid #d9ad73;
  box-sizing: border-box;
  box-shadow: 0 0 12rpx rgba(217, 173, 115, 0.22);
}

.gear-icon::after {
  content: "";
  position: absolute;
  left: 7rpx;
  top: 7rpx;
  width: 5rpx;
  height: 5rpx;
  border: 4rpx solid #061416;
  border-radius: 50%;
  background: #d9ad73;
}

.rules-icon {
  display: flex;
  border-left: 6rpx solid #d9ad73;
  border-right: 6rpx solid #d9ad73;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.rules-icon::before,
.rules-icon::after {
  content: "";
  flex: 1;
  border: 2rpx solid #d9ad73;
  border-top-width: 5rpx;
  box-sizing: border-box;
}

.tool-text {
  color: #e0b373;
  font-size: 18rpx;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
}

.board-layout {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 140rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dev-control-strip {
  min-height: 58rpx;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid rgba(31, 204, 215, 0.5);
  color: #bdeff0;
  background: rgba(3, 43, 47, 0.74);
}

.dev-mark {
  height: 34rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 204, 215, 0.62);
  color: #082024;
  font-size: 20rpx;
  font-weight: 800;
  background: #21d0db;
  white-space: nowrap;
}

.dev-seat {
  min-width: 0;
  color: #e8c48a;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-hint {
  color: rgba(189, 239, 240, 0.76);
  font-size: 19rpx;
  white-space: nowrap;
}

.seat-row {
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.seat-card {
  position: relative;
  flex: 1 1 0;
  max-width: 136rpx;
  min-width: 0;
  height: 142rpx;
  padding: 12rpx 6rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border: 1rpx solid rgba(181, 127, 67, 0.62);
  background: rgba(10, 18, 18, 0.86);
  box-shadow: inset 0 0 28rpx rgba(223, 164, 87, 0.08);
  overflow: hidden;
}

.seat-card::before {
  content: "";
  position: absolute;
  inset: 6rpx;
  border: 1rpx solid rgba(181, 127, 67, 0.28);
  pointer-events: none;
}

.seat-card.is-current {
  border-color: #16d5df;
  box-shadow: inset 0 0 34rpx rgba(22, 213, 223, 0.2), 0 0 18rpx rgba(22, 213, 223, 0.32);
}

.seat-card.is-controlled {
  border-color: #f1bd76;
  box-shadow: inset 0 0 36rpx rgba(241, 189, 118, 0.22), 0 0 20rpx rgba(241, 189, 118, 0.34);
}

.seat-card.is-controlled::after {
  content: "操控";
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  z-index: 1;
  padding: 1rpx 6rpx;
  color: #081719;
  font-size: 16rpx;
  font-weight: 800;
  line-height: 1.2;
  background: #f1bd76;
}

.seat-card.is-nominee {
  border-color: #d8a248;
  box-shadow: inset 0 0 32rpx rgba(216, 162, 72, 0.2), 0 0 14rpx rgba(216, 162, 72, 0.22);
}

.seat-card.is-eligible-nominee {
  border-color: #20cbd4;
  box-shadow: inset 0 0 30rpx rgba(32, 203, 212, 0.16), 0 0 12rpx rgba(32, 203, 212, 0.2);
}

.seat-card.is-empty {
  justify-content: center;
  opacity: 0.58;
}

.seat-no {
  position: absolute;
  left: 8rpx;
  top: 6rpx;
  z-index: 1;
  color: #deb073;
  font-size: 22rpx;
  line-height: 1;
}

.avatar {
  width: 58rpx;
  height: 58rpx;
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b57c42;
  border-radius: 50%;
  color: #031014;
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #d9c29a 0%, #74502c 100%);
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.seat-name {
  width: 100%;
  margin-top: 6rpx;
  color: #e9bf83;
  font-size: 20rpx;
  line-height: 1.05;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.role-badge {
  max-width: 112rpx;
  min-height: 26rpx;
  margin-top: 5rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(22, 213, 223, 0.72);
  color: #27dbe5;
  font-size: 17rpx;
  line-height: 1.1;
  background: rgba(4, 45, 51, 0.8);
  text-align: center;
}

.seat-card.is-dead {
  opacity: 0.52;
}

.center-board {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  padding: 4rpx 10rpx 2rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(159, 102, 48, 0.42);
  background: rgba(3, 15, 17, 0.48);
  box-shadow: inset 0 0 56rpx rgba(0, 0, 0, 0.48);
}

.phase-banner {
  min-height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(161, 110, 56, 0.42);
  border-bottom: 1rpx solid rgba(161, 110, 56, 0.42);
}

.eagle-mark {
  width: 112rpx;
  height: 18rpx;
  border-top: 4rpx solid #b17d45;
  border-bottom: 2rpx solid rgba(177, 125, 69, 0.72);
  opacity: 0.82;
}

.phase-title {
  margin-top: 5rpx;
  color: #e0a668;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.track-panel {
  margin-top: 10rpx;
  padding: 14rpx 12rpx 12rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.48);
  background: rgba(4, 20, 22, 0.72);
  box-shadow: inset 0 0 42rpx rgba(10, 33, 36, 0.8);
}

.liberal-panel {
  border-color: rgba(20, 176, 188, 0.36);
}

.fascist-panel {
  background: rgba(23, 11, 8, 0.7);
}

.track-title {
  position: relative;
  color: #18d3dd;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.fascist-title {
  color: #e95138;
}

.policy-row {
  margin-top: 18rpx;
  display: grid;
  gap: 8rpx;
}

.liberal-row {
  grid-template-columns: repeat(5, minmax(0, 1fr));
}

.fascist-row,
.power-row {
  grid-template-columns: repeat(6, minmax(0, 1fr));
}

.policy-cell {
  position: relative;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(158, 111, 59, 0.64);
  color: rgba(226, 188, 139, 0.76);
  font-size: 32rpx;
  font-weight: 800;
  background: rgba(12, 18, 17, 0.82);
  text-align: center;
}

.policy-label {
  max-width: 92%;
  line-height: 1.08;
}

.policy-cell.is-enacted {
  color: #032024;
  border-color: #16d5df;
  background: linear-gradient(180deg, #1dd8e4 0%, #087582 100%);
  box-shadow: 0 0 18rpx rgba(22, 213, 223, 0.4);
}

.fascist-cell.is-enacted {
  color: #240703;
  border-color: #ef6048;
  background: linear-gradient(180deg, #f06c50 0%, #8e2117 100%);
  box-shadow: 0 0 18rpx rgba(239, 96, 72, 0.38);
}

.policy-cell.is-victory {
  font-size: 20rpx;
  color: #e4bd84;
  background: rgba(10, 14, 13, 0.9);
}

.track-progress,
.election-progress {
  margin-top: 10rpx;
  color: rgba(221, 190, 143, 0.76);
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.progress-count {
  color: #1bd5df;
  font-weight: 800;
}

.fascist-count {
  color: #ef6048;
}

.power-row {
  margin-top: 10rpx;
  display: grid;
  gap: 8rpx;
}

.power-cell {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: rgba(218, 170, 105, 0.86);
}

.power-icon {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bd8752;
  font-size: 20rpx;
  line-height: 1;
}

.power-label {
  width: 100%;
  margin-top: 4rpx;
  min-height: 34rpx;
  color: #dca766;
  font-size: 17rpx;
  line-height: 1.08;
  text-align: center;
  word-break: break-all;
}

.power-victory-label {
  color: #e0b373;
}

.veto-note {
  margin-top: 8rpx;
  color: #f1bd76;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
}

.election-panel {
  margin-top: 10rpx;
  padding: 12rpx 16rpx 10rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.46);
  background: rgba(5, 20, 20, 0.74);
}

.election-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 58rpx;
}

.election-dot {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(166, 116, 59, 0.62);
  border-radius: 50%;
  color: rgba(216, 171, 110, 0.72);
  font-size: 26rpx;
  background: #071314;
}

.election-dot.is-active {
  color: #031014;
  border-color: #e9bc72;
  background: #e7b769;
  box-shadow: 0 0 18rpx rgba(233, 188, 114, 0.36);
}

.status-strip {
  min-height: 56rpx;
  margin-top: 10rpx;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(161, 110, 56, 0.5);
  background: rgba(9, 17, 16, 0.82);
}

.status-icon {
  flex: 0 0 auto;
  color: #d9ad73;
  font-size: 26rpx;
}

.status-text {
  min-width: 0;
  color: #e9bf83;
  font-size: 21rpx;
  line-height: 1.25;
}

.vote-panel {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(31, 204, 215, 0.42);
  background: rgba(3, 28, 31, 0.76);
}

.vote-panel.is-failed {
  border-color: rgba(239, 96, 72, 0.46);
  background: rgba(35, 12, 9, 0.72);
}

.vote-progress-text,
.vote-result-title {
  color: #e9bf83;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.vote-panel.is-passed .vote-result-title {
  color: #1bd5df;
}

.vote-panel.is-failed .vote-result-title {
  color: #ef6048;
}

.vote-result-detail {
  margin-top: 6rpx;
  color: rgba(229, 192, 141, 0.84);
  font-size: 19rpx;
  line-height: 1.25;
  text-align: center;
}

.vote-reveal-row {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}

.vote-reveal-item {
  min-width: 0;
  min-height: 38rpx;
  padding: 5rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  border: 1rpx solid rgba(185, 128, 66, 0.52);
  background: rgba(8, 18, 18, 0.82);
}

.vote-reveal-name {
  min-width: 0;
  color: #e4bd84;
  font-size: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vote-reveal-mark {
  flex: 0 0 auto;
  color: #e4bd84;
  font-size: 19rpx;
  font-weight: 900;
}

.vote-reveal-item.is-ja .vote-reveal-mark {
  color: #1bd5df;
}

.vote-reveal-item.is-nein .vote-reveal-mark {
  color: #ef6048;
}

.action-dock {
  margin-top: auto;
  padding: 4rpx 10rpx 0;
}

.nominate-panel {
  padding: 10rpx 12rpx 12rpx;
  border: 1rpx solid rgba(185, 128, 66, 0.64);
  background: rgba(7, 24, 24, 0.88);
}

.nominate-title {
  color: #e8bf83;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.nominate-hint {
  margin-top: 6rpx;
  color: rgba(221, 190, 143, 0.78);
  font-size: 19rpx;
  line-height: 1.25;
  text-align: center;
}

.nominate-actions {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.nominate-action {
  min-height: 54rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 204, 215, 0.58);
  color: #082024;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.16;
  text-align: center;
  background: linear-gradient(180deg, #31d8df 0%, #0f8c95 100%);
}

.nominate-action.is-ineligible {
  border-color: rgba(160, 112, 63, 0.5);
  color: rgba(226, 188, 139, 0.7);
  background: rgba(15, 22, 21, 0.88);
}

.nominate-action.is-disabled {
  opacity: 0.56;
}

.nominate-label {
  max-width: 100%;
  line-height: 1.16;
}

.nominate-reason {
  max-width: 100%;
  margin-top: 4rpx;
  color: rgba(226, 188, 139, 0.58);
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1.12;
}

.action-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.vote-action {
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid currentColor;
  border-radius: 36rpx;
  color: #041014;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 0;
  box-shadow: inset 0 0 22rpx rgba(255, 255, 255, 0.14), 0 0 22rpx rgba(0, 0, 0, 0.34);
}

.vote-action.is-disabled {
  opacity: 0.55;
}

.ja-action {
  background: linear-gradient(180deg, #28dbe8 0%, #0a8f9b 100%);
}

.nein-action {
  background: linear-gradient(180deg, #f06b4f 0%, #96231a 100%);
}

.vote-waiting-panel {
  min-height: 62rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(185, 128, 66, 0.64);
  background: rgba(7, 24, 24, 0.88);
}

.vote-waiting-text {
  color: #e8bf83;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.secondary-actions {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.secondary-action {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(185, 128, 66, 0.72);
  color: #e0b373;
  font-size: 25rpx;
  background: rgba(7, 24, 24, 0.86);
}

.board-loading {
  position: relative;
  z-index: 2;
  margin-top: 320rpx;
  color: rgba(224, 179, 115, 0.76);
  font-size: 28rpx;
  text-align: center;
}

@media (max-width: 360px) {
  .seat-card {
    height: 130rpx;
    padding-top: 10rpx;
  }

  .avatar {
    width: 52rpx;
    height: 52rpx;
  }

  .seat-name {
    font-size: 18rpx;
  }

  .role-badge {
    min-height: 24rpx;
    font-size: 16rpx;
  }

  .policy-cell {
    height: 62rpx;
    font-size: 28rpx;
  }

  .phase-title {
    font-size: 32rpx;
  }

  .power-label {
    font-size: 16rpx;
  }

  .election-row {
    gap: 44rpx;
  }
}
