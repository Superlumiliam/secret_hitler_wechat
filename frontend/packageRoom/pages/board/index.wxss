.board-page {
  position: relative;
  min-height: 100vh;
  padding: calc(72rpx + env(safe-area-inset-top)) 18rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  color: #e1b373;
  background:
    radial-gradient(circle at 50% 48%, rgba(20, 52, 55, 0.6), transparent 42%),
    linear-gradient(180deg, #071719 0%, #02090a 100%);
  font-family: "Songti SC", STSong, SimSun, serif;
}

.board-noise {
  position: absolute;
  inset: 12rpx;
  pointer-events: none;
  border: 1rpx solid rgba(186, 129, 62, 0.52);
  box-shadow: inset 0 0 0 2rpx rgba(6, 22, 24, 0.78), inset 0 0 84rpx rgba(0, 0, 0, 0.8);
}

.board-noise::before,
.board-noise::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 1rpx;
  background: rgba(186, 129, 62, 0.34);
}

.board-noise::before {
  top: 132rpx;
}

.board-noise::after {
  bottom: 20rpx;
}

.top-bar {
  position: relative;
  z-index: 2;
  min-height: 58rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.back-control {
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e3b36e;
  font-size: 76rpx;
  line-height: 52rpx;
  text-shadow: 0 0 12rpx rgba(0, 0, 0, 0.75);
}

.icon-hover,
.action-hover,
.secondary-hover {
  opacity: 0.72;
}

.room-meta-row {
  position: relative;
  z-index: 2;
  min-height: 100rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.room-head {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.room-title {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.room-label {
  color: #e4af6e;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.room-code {
  max-width: 176rpx;
  color: #f0b160;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.round-pill {
  flex: 0 0 auto;
  min-width: 84rpx;
  height: 44rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(190, 129, 65, 0.66);
  border-radius: 28rpx;
  color: #e6bd83;
  font-size: 22rpx;
  background: rgba(9, 21, 23, 0.78);
  white-space: nowrap;
}

.top-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: flex-start;
}

.tool-control {
  width: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #d9ad73;
}

.tool-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 4rpx;
}

.rules-icon {
  display: flex;
  border-left: 6rpx solid #d9ad73;
  border-right: 6rpx solid #d9ad73;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.rules-icon::before,
.rules-icon::after {
  content: "";
  flex: 1;
  border: 2rpx solid #d9ad73;
  border-top-width: 5rpx;
  box-sizing: border-box;
}

.tool-text {
  color: #e0b373;
  font-size: 18rpx;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
}

.board-layout {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 140rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.dev-control-strip {
  min-height: 58rpx;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid rgba(31, 204, 215, 0.5);
  color: #bdeff0;
  background: rgba(3, 43, 47, 0.74);
}

.dev-mark {
  height: 34rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 204, 215, 0.62);
  color: #082024;
  font-size: 20rpx;
  font-weight: 800;
  background: #21d0db;
  white-space: nowrap;
}

.dev-seat {
  min-width: 0;
  color: #e8c48a;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-hint {
  color: rgba(189, 239, 240, 0.76);
  font-size: 19rpx;
  white-space: nowrap;
}

.seat-row {
  display: grid;
  grid-template-columns: repeat(5, 138rpx);
  justify-content: center;
  gap: 14rpx 0;
  padding: 2rpx 0 0;
}

.seat-card {
  position: relative;
  width: 138rpx;
  min-width: 0;
  height: 281rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.seat-card::before {
  content: none;
}

.seat-art {
  position: absolute;
  left: 50%;
  top: 0;
  width: 138rpx;
  height: 281rpx;
  transform: translateX(-50%);
}

.seat-frame-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  filter: drop-shadow(0 8rpx 10rpx rgba(0, 0, 0, 0.46));
}

.seat-card.is-current {
  filter: drop-shadow(0 0 12rpx rgba(22, 213, 223, 0.55));
}

.seat-card.is-controlled {
  filter: drop-shadow(0 0 12rpx rgba(241, 189, 118, 0.58));
}

.seat-card.is-controlled::after {
  content: "操控";
  position: absolute;
  right: 3rpx;
  top: 11rpx;
  z-index: 4;
  padding: 2rpx 7rpx;
  color: #081719;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
  background: #f1bd76;
}

.seat-card.is-nominee {
  filter: drop-shadow(0 0 13rpx rgba(216, 162, 72, 0.56));
}

.seat-card.is-eligible-nominee {
  filter: drop-shadow(0 0 12rpx rgba(32, 203, 212, 0.5));
}

.seat-card.is-selected-nomination {
  filter: drop-shadow(0 0 16rpx rgba(232, 181, 99, 0.72));
}

.seat-card.is-ineligible-nominee {
  opacity: 0.72;
}

.seat-card.is-empty {
  justify-content: center;
  opacity: 0.58;
}

.seat-no {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  z-index: 2;
  color: #deb073;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.8);
}

.avatar {
  position: absolute;
  left: 50%;
  top: 48rpx;
  z-index: 2;
  width: 83rpx;
  height: 83rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b57c42;
  border-radius: 50%;
  color: #031014;
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #d9c29a 0%, #74502c 100%);
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.seat-name {
  position: absolute;
  left: 50%;
  top: 148rpx;
  z-index: 2;
  width: 105rpx;
  transform: translateX(-50%);
  margin-top: 0;
  color: #e9bf83;
  font-size: 20rpx;
  line-height: 1.12;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.role-badge {
  position: absolute;
  left: 50%;
  top: 176rpx;
  z-index: 5;
  width: 100rpx;
  height: 29rpx;
  transform: translateX(-50%);
}

.role-badge-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.investigation-stamp {
  position: absolute;
  right: -17rpx;
  top: 0;
  z-index: 6;
  width: 79rpx;
  height: 79rpx;
  pointer-events: none;
  filter: drop-shadow(0 4rpx 5rpx rgba(0, 0, 0, 0.5));
}

.identity-mark {
  position: absolute;
  left: 50%;
  top: 214rpx;
  z-index: 7;
  width: 43rpx;
  height: 43rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(226, 188, 139, 0.78);
  border-radius: 50%;
  background: rgba(61, 65, 63, 0.92);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.42);
  overflow: hidden;
}

.identity-mark.is-liberal {
  border-color: rgba(34, 210, 221, 0.84);
  background: rgba(4, 38, 43, 0.92);
}

.identity-mark.is-fascist {
  border-color: rgba(231, 75, 50, 0.82);
  background: rgba(46, 13, 10, 0.92);
}

.identity-mark-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.identity-option {
  width: 96rpx;
  height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(226, 188, 139, 0.66);
  border-radius: 50%;
  background: #4b504e;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.identity-option.is-liberal {
  border-color: rgba(34, 210, 221, 0.76);
  background: rgba(6, 47, 52, 0.9);
}

.identity-option.is-fascist {
  border-color: rgba(231, 75, 50, 0.76);
  background: rgba(58, 15, 12, 0.9);
}

.identity-option.is-active {
  box-shadow: 0 0 18rpx currentColor, 0 8rpx 16rpx rgba(0, 0, 0, 0.35);
}

.identity-option-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.identity-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.58);
}

.identity-modal {
  position: relative;
  width: 100%;
  max-width: 660rpx;
  min-height: 468rpx;
  box-sizing: border-box;
  color: #e9bf83;
  background:
    linear-gradient(180deg, rgba(25, 37, 34, 0.98) 0%, rgba(10, 18, 17, 0.98) 100%);
  box-shadow: 0 28rpx 68rpx rgba(0, 0, 0, 0.62);
  animation: identityModalIn 150ms ease-out both;
}

.identity-modal-frame {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.identity-modal-content {
  position: relative;
  z-index: 1;
  min-height: 468rpx;
  padding: 76rpx 54rpx 48rpx;
  box-sizing: border-box;
}

.identity-modal-title {
  color: #f0c184;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
  text-align: center;
}

.identity-modal-icon-row,
.identity-modal-label-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  justify-items: center;
}

.identity-modal-icon-row {
  margin-top: 46rpx;
  column-gap: 18rpx;
}

.identity-modal-label-row {
  margin-top: 16rpx;
  column-gap: 18rpx;
}

.identity-option-label {
  color: rgba(238, 199, 144, 0.88);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
  text-align: center;
}

.identity-modal-cancel {
  position: relative;
  width: 212rpx;
  height: 66rpx;
  margin: 46rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9bf83;
  font-size: 24rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.48);
}

.identity-modal-cancel-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.identity-modal-cancel-text {
  position: relative;
  z-index: 1;
  color: #e9bf83;
}

@keyframes identityModalIn {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.seat-card.is-dead {
  opacity: 0.52;
}

.center-board {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  padding: 4rpx 10rpx 2rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(159, 102, 48, 0.42);
  background: rgba(3, 15, 17, 0.48);
  box-shadow: inset 0 0 56rpx rgba(0, 0, 0, 0.48);
}

.phase-banner {
  min-height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(161, 110, 56, 0.42);
  border-bottom: 1rpx solid rgba(161, 110, 56, 0.42);
}

.eagle-mark {
  width: 112rpx;
  height: 18rpx;
  border-top: 4rpx solid #b17d45;
  border-bottom: 2rpx solid rgba(177, 125, 69, 0.72);
  opacity: 0.82;
}

.phase-title {
  margin-top: 5rpx;
  color: #e0a668;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.track-panel {
  margin-top: 10rpx;
  padding: 0;
  background: transparent;
}

.policy-track-shell {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 42.8333%;
  overflow: visible;
}

.policy-track-shell::before {
  content: "";
  position: absolute;
  inset: 10rpx 12rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.3);
  background: rgba(4, 16, 16, 0.72);
  box-shadow: inset 0 0 46rpx rgba(0, 0, 0, 0.62);
}

.policy-track-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.track-title {
  position: relative;
  color: #18d3dd;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.policy-row {
  position: absolute;
  z-index: 2;
  display: grid;
  align-items: end;
  justify-items: center;
}

.liberal-row {
  left: 10.5%;
  right: 9.5%;
  top: 32%;
  height: 54%;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: 1.2%;
}

.fascist-row {
  left: 7.5%;
  right: 7.5%;
  top: 33%;
  height: 52%;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  column-gap: 1%;
}

.policy-cell {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(226, 188, 139, 0.76);
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.policy-label {
  max-width: 92%;
  line-height: 1.08;
}

.policy-card-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 8rpx 8rpx rgba(0, 0, 0, 0.46));
}

.policy-cell.is-new-policy .policy-card-image {
  animation: policyDropIn 420ms cubic-bezier(0.18, 0.82, 0.24, 1) both;
}

.power-badge-control {
  position: absolute;
  left: 50%;
  bottom: -24rpx;
  width: 34rpx;
  height: 34rpx;
  transform: translateX(-50%);
  z-index: 3;
}

.power-badge-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 6rpx 7rpx rgba(0, 0, 0, 0.45));
}

.policy-cell.is-enacted .power-badge-control {
  opacity: 0.94;
}

.power-tip {
  position: absolute;
  left: 50%;
  bottom: 40rpx;
  min-width: 126rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  border: 1rpx solid rgba(211, 163, 89, 0.72);
  color: #f3d59d;
  font-size: 18rpx;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
  background: rgba(20, 13, 8, 0.94);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.35);
}

.power-tip::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -7rpx;
  width: 12rpx;
  height: 12rpx;
  transform: translateX(-50%) rotate(45deg);
  border-right: 1rpx solid rgba(211, 163, 89, 0.72);
  border-bottom: 1rpx solid rgba(211, 163, 89, 0.72);
  background: rgba(20, 13, 8, 0.94);
}

@keyframes policyDropIn {
  0% {
    opacity: 0;
    transform: translateY(-22rpx) scale(1.04) rotate(-1deg);
  }

  68% {
    opacity: 1;
    transform: translateY(3rpx) scale(0.995) rotate(0deg);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
  }
}

.track-progress,
.election-progress {
  margin-top: 10rpx;
  color: rgba(221, 190, 143, 0.76);
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.progress-count {
  color: #1bd5df;
  font-weight: 800;
}

.fascist-count {
  color: #ef6048;
}

.veto-note {
  margin-top: 8rpx;
  color: #f1bd76;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
}

.election-panel {
  margin-top: 10rpx;
  padding: 0;
  background: transparent;
}

.election-track-shell {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 21.7514%;
  overflow: visible;
}

.election-track-shell::before {
  content: "";
  position: absolute;
  inset: 8rpx 12rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.3);
  background: rgba(4, 16, 16, 0.72);
  box-shadow: inset 0 0 40rpx rgba(0, 0, 0, 0.58);
}

.election-track-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.election-row {
  position: absolute;
  left: 30.5%;
  right: 30.5%;
  top: 38%;
  z-index: 2;
  height: 36%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.election-slot {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(216, 171, 110, 0.72);
  font-size: 24rpx;
  font-weight: 800;
}

.election-slot-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 7rpx 8rpx rgba(0, 0, 0, 0.48));
}

.election-slot.is-active .election-slot-image {
  filter: drop-shadow(0 0 12rpx rgba(233, 188, 114, 0.28)) drop-shadow(0 7rpx 8rpx rgba(0, 0, 0, 0.48));
}

.election-slot-label {
  position: relative;
  z-index: 1;
  color: #c5955b;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 2rpx 2rpx rgba(0, 0, 0, 0.72), 0 0 8rpx rgba(220, 164, 91, 0.26);
}

.election-slot.is-active .election-slot-label {
  color: #f0c47d;
  text-shadow: 0 2rpx 2rpx rgba(0, 0, 0, 0.76), 0 0 10rpx rgba(236, 185, 105, 0.36);
}

.deck-piles-panel {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.deck-pile {
  min-width: 0;
  min-height: 102rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.5);
  background: rgba(6, 18, 18, 0.78);
  box-shadow: inset 0 0 32rpx rgba(0, 0, 0, 0.34);
}

.deck-pile.is-draw {
  border-color: rgba(31, 204, 215, 0.36);
}

.deck-pile.is-discard {
  border-color: rgba(190, 129, 65, 0.58);
  background: rgba(22, 13, 9, 0.72);
}

.deck-card-stack {
  position: relative;
  flex: 0 0 62rpx;
  width: 62rpx;
  height: 78rpx;
}

.deck-card-shadow,
.deck-card-back {
  position: absolute;
  width: 48rpx;
  height: 66rpx;
  border: 1rpx solid rgba(230, 183, 112, 0.76);
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(21, 65, 65, 0.9) 0%, rgba(8, 25, 26, 0.98) 48%, rgba(77, 37, 24, 0.92) 100%);
}

.deck-card-shadow {
  left: 8rpx;
  top: 7rpx;
  opacity: 0.62;
}

.deck-card-back {
  left: 2rpx;
  top: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 14rpx rgba(223, 164, 87, 0.12);
}

.deck-pile.is-empty .deck-card-shadow {
  opacity: 0;
}

.deck-pile.is-empty .deck-card-back {
  opacity: 0.42;
  background: rgba(9, 16, 15, 0.9);
}

.deck-card-frame {
  position: absolute;
  inset: 7rpx;
  border: 1rpx solid rgba(230, 183, 112, 0.52);
}

.deck-card-seal {
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid rgba(230, 183, 112, 0.82);
  transform: rotate(45deg);
  background: rgba(4, 15, 16, 0.42);
}

.deck-pile-copy {
  min-width: 0;
  flex: 1;
}

.deck-pile-label {
  color: #e7bd82;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.15;
  white-space: nowrap;
}

.deck-pile-count {
  margin-top: 5rpx;
  color: #21d0db;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
  white-space: nowrap;
}

.deck-pile.is-discard .deck-pile-count {
  color: #e8a663;
}

.status-strip {
  min-height: 56rpx;
  margin-top: 10rpx;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(161, 110, 56, 0.5);
  background: rgba(9, 17, 16, 0.82);
}

.status-icon {
  flex: 0 0 auto;
  color: #d9ad73;
  font-size: 26rpx;
}

.status-text {
  min-width: 0;
  color: #e9bf83;
  font-size: 21rpx;
  line-height: 1.25;
}

.status-copy {
  min-width: 0;
  flex: 1;
}

.phase-hint-text {
  margin-top: 5rpx;
  color: rgba(224, 207, 174, 0.7);
  font-size: 19rpx;
  line-height: 1.3;
}

.vote-panel {
  margin-top: 10rpx;
  padding: 10rpx 12rpx;
  border: 1rpx solid rgba(31, 204, 215, 0.42);
  background: rgba(3, 28, 31, 0.76);
}

.vote-panel.is-failed {
  border-color: rgba(239, 96, 72, 0.46);
  background: rgba(35, 12, 9, 0.72);
}

.vote-progress-text,
.vote-result-title {
  color: #e9bf83;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.vote-panel.is-passed .vote-result-title,
.vote-result-modal.is-passed .vote-result-title {
  color: #1bd5df;
}

.vote-panel.is-failed .vote-result-title,
.vote-result-modal.is-failed .vote-result-title {
  color: #ef6048;
}

.vote-result-detail {
  margin-top: 6rpx;
  color: rgba(229, 192, 141, 0.84);
  font-size: 19rpx;
  line-height: 1.25;
  text-align: center;
}

.vote-reveal-row {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}

.vote-reveal-item {
  min-width: 0;
  min-height: 38rpx;
  padding: 5rpx 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  border: 1rpx solid rgba(185, 128, 66, 0.52);
  background: rgba(8, 18, 18, 0.82);
}

.vote-reveal-name {
  min-width: 0;
  color: #e4bd84;
  font-size: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vote-reveal-mark {
  flex: 0 0 auto;
  color: #e4bd84;
  font-size: 19rpx;
  font-weight: 900;
}

.vote-reveal-item.is-ja .vote-reveal-mark {
  color: #1bd5df;
}

.vote-reveal-item.is-nein .vote-reveal-mark {
  color: #ef6048;
}

.vote-result-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 84;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx 26rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.64);
}

.vote-result-modal {
  position: relative;
  width: 100%;
  max-width: 704rpx;
  box-sizing: border-box;
  color: #e9bf83;
  background:
    linear-gradient(180deg, rgba(31, 18, 14, 0.98) 0%, rgba(13, 8, 7, 0.98) 100%);
  box-shadow:
    0 28rpx 72rpx rgba(0, 0, 0, 0.66);
  animation: identityModalIn 150ms ease-out both;
}

.vote-result-modal-frame {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.vote-result-modal-content {
  position: relative;
  z-index: 1;
  padding: 38rpx 34rpx 36rpx;
  box-sizing: border-box;
}

.vote-result-modal .vote-result-title {
  font-size: 34rpx;
}

.vote-result-modal .vote-result-detail {
  margin-top: 12rpx;
  font-size: 23rpx;
}

.vote-result-modal .vote-reveal-row {
  margin-top: 16rpx;
}

.vote-result-modal .vote-reveal-item {
  min-height: 54rpx;
  padding: 8rpx 12rpx;
}

.vote-result-modal .vote-reveal-name,
.vote-result-modal .vote-reveal-mark {
  font-size: 24rpx;
}

.vote-result-confirm {
  position: relative;
  width: 238rpx;
  height: 66rpx;
  margin: 22rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9bf83;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.48);
}

.vote-result-confirm-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.vote-result-confirm-text {
  position: relative;
  z-index: 1;
  color: #e9bf83;
}

.action-dock {
  margin-top: auto;
  padding: 4rpx 10rpx 0;
}

.secret-result-panel,
.executive-panel,
.veto-response-panel {
  margin-bottom: 10rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(185, 128, 66, 0.64);
  background: rgba(7, 24, 24, 0.9);
}

.secret-result-title,
.executive-title,
.veto-response-title {
  color: #e8bf83;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.secret-result-text,
.executive-hint,
.executive-waiting,
.veto-response-hint,
.veto-response-waiting {
  margin-top: 7rpx;
  color: rgba(221, 190, 143, 0.84);
  font-size: 20rpx;
  line-height: 1.3;
  text-align: center;
}

.is-liberal-text {
  color: #1bd5df;
  font-weight: 800;
}

.is-fascist-text {
  color: #ef6048;
  font-weight: 800;
}

.executive-targets {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}

.executive-target,
.executive-confirm {
  min-height: 54rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 204, 215, 0.62);
  color: #092326;
  background: #1bd5df;
  box-shadow: 0 0 14rpx rgba(27, 213, 223, 0.28);
}

.executive-confirm {
  margin-top: 12rpx;
  color: #071416;
  font-size: 22rpx;
  font-weight: 900;
}

.executive-target.is-ineligible {
  border-color: rgba(185, 128, 66, 0.46);
  color: rgba(221, 190, 143, 0.58);
  background: rgba(12, 18, 17, 0.82);
  box-shadow: none;
}

.executive-target.is-disabled,
.executive-confirm.is-disabled {
  opacity: 0.56;
}

.executive-target-label {
  width: 100%;
  color: inherit;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.15;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.executive-target-reason {
  width: 100%;
  margin-top: 3rpx;
  color: rgba(221, 190, 143, 0.62);
  font-size: 17rpx;
  line-height: 1.12;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.policy-picker-panel {
  padding: 12rpx;
  border: 1rpx solid rgba(185, 128, 66, 0.64);
  background: rgba(7, 24, 24, 0.9);
}

.policy-picker-title {
  color: #e8bf83;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.policy-picker-hint {
  margin-top: 6rpx;
  color: rgba(221, 190, 143, 0.78);
  font-size: 19rpx;
  line-height: 1.25;
  text-align: center;
}

.policy-picker-row {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.policy-picker-row.is-two-cards {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.policy-picker-row.is-three-cards {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.policy-pick-card {
  min-width: 0;
  height: 154rpx;
  padding: 12rpx 8rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid rgba(185, 128, 66, 0.72);
  color: #e9bf83;
  background: rgba(13, 18, 17, 0.9);
  box-shadow: inset 0 0 26rpx rgba(222, 160, 83, 0.12);
}

.policy-pick-card.is-disabled {
  opacity: 0.56;
}

.policy-pick-card.is-liberal {
  border-color: rgba(31, 204, 215, 0.66);
  box-shadow: inset 0 0 30rpx rgba(31, 204, 215, 0.16), 0 0 12rpx rgba(31, 204, 215, 0.14);
}

.policy-pick-card.is-fascist {
  border-color: rgba(239, 96, 72, 0.66);
  box-shadow: inset 0 0 30rpx rgba(239, 96, 72, 0.16), 0 0 12rpx rgba(239, 96, 72, 0.14);
}

.policy-card-mark {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid currentColor;
  color: #e8bf83;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1;
}

.is-liberal .policy-card-mark {
  color: #24d5df;
}

.is-fascist .policy-card-mark {
  color: #ef6048;
}

.policy-card-title {
  max-width: 100%;
  color: #e8bf83;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 1.12;
  text-align: center;
}

.policy-card-action {
  width: 100%;
  min-height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #071719;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1.1;
  background: #e1b373;
  text-align: center;
}

.veto-request-action {
  min-height: 54rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(239, 96, 72, 0.72);
  color: #f0c28a;
  font-size: 22rpx;
  font-weight: 900;
  background: rgba(103, 25, 21, 0.72);
  box-shadow: inset 0 0 24rpx rgba(239, 96, 72, 0.16);
}

.veto-response-actions {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.veto-response-action {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #071719;
  font-size: 22rpx;
  font-weight: 900;
}

.veto-response-action.accept-action {
  border: 1rpx solid rgba(31, 204, 215, 0.7);
  background: #1bd5df;
  box-shadow: 0 0 14rpx rgba(27, 213, 223, 0.22);
}

.veto-response-action.reject-action {
  border: 1rpx solid rgba(239, 96, 72, 0.72);
  color: #f0c28a;
  background: rgba(103, 25, 21, 0.82);
}

.veto-request-action.is-disabled,
.veto-response-action.is-disabled {
  opacity: 0.56;
}

.nominate-panel {
  margin-bottom: 10rpx;
  padding: 10rpx 12rpx 12rpx;
  border: 1rpx solid rgba(185, 128, 66, 0.64);
  background: rgba(7, 24, 24, 0.88);
}

.nominate-title {
  color: #e8bf83;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
  text-align: center;
}

.nominate-hint {
  margin-top: 6rpx;
  color: rgba(221, 190, 143, 0.78);
  font-size: 19rpx;
  line-height: 1.25;
  text-align: center;
}

.nominate-submit {
  min-height: 58rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 204, 215, 0.58);
  color: #082024;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.16;
  text-align: center;
  background: linear-gradient(180deg, #31d8df 0%, #0f8c95 100%);
  box-shadow: 0 0 14rpx rgba(31, 204, 215, 0.24);
}

.nominate-submit.is-empty {
  border-color: rgba(160, 112, 63, 0.5);
  color: rgba(226, 188, 139, 0.7);
  background: rgba(15, 22, 21, 0.88);
  box-shadow: none;
}

.nominate-submit.is-disabled {
  opacity: 0.56;
}

.action-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.vote-action {
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid currentColor;
  border-radius: 36rpx;
  color: #041014;
  font-size: 31rpx;
  font-weight: 900;
  letter-spacing: 0;
  box-shadow: inset 0 0 22rpx rgba(255, 255, 255, 0.14), 0 0 22rpx rgba(0, 0, 0, 0.34);
}

.vote-action.is-disabled {
  opacity: 0.55;
}

.ja-action {
  background: linear-gradient(180deg, #28dbe8 0%, #0a8f9b 100%);
}

.nein-action {
  background: linear-gradient(180deg, #f06b4f 0%, #96231a 100%);
}

.vote-waiting-panel {
  min-height: 62rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(185, 128, 66, 0.64);
  background: rgba(7, 24, 24, 0.88);
}

.vote-waiting-text {
  color: #e8bf83;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.25;
  text-align: center;
}

.secondary-actions {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.secondary-action {
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(185, 128, 66, 0.72);
  color: #e0b373;
  font-size: 25rpx;
  background: rgba(7, 24, 24, 0.86);
}

.board-loading {
  position: relative;
  z-index: 2;
  margin-top: 320rpx;
  color: rgba(224, 179, 115, 0.76);
  font-size: 28rpx;
  text-align: center;
}

@media (max-width: 360px) {
  .policy-cell {
    font-size: 28rpx;
  }

  .phase-title {
    font-size: 32rpx;
  }

  .election-row {
    left: 29%;
    right: 29%;
  }

  .election-slot {
    width: 48rpx;
    height: 48rpx;
  }
}
