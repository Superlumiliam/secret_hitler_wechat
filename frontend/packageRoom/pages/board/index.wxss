.board-page {
  position: relative;
  min-height: 100vh;
  padding: calc(96rpx + env(safe-area-inset-top)) 18rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overflow-x: hidden;
  color: #e1b373;
  background:
    radial-gradient(circle at 50% 48%, rgba(20, 52, 55, 0.6), transparent 42%),
    linear-gradient(180deg, #071719 0%, #02090a 100%);
  font-family: "Songti SC", STSong, SimSun, serif;
}

.board-noise {
  position: absolute;
  inset: 12rpx;
  pointer-events: none;
  border: 1rpx solid rgba(186, 129, 62, 0.52);
  box-shadow: inset 0 0 0 2rpx rgba(6, 22, 24, 0.78), inset 0 0 84rpx rgba(0, 0, 0, 0.8);
}

.board-noise::after {
  content: "";
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  height: 1rpx;
  background: rgba(186, 129, 62, 0.34);
}

.board-noise::after {
  bottom: 20rpx;
}

.top-bar {
  position: relative;
  z-index: 2;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(185, 128, 66, 0.44);
  border-bottom: 1rpx solid rgba(185, 128, 66, 0.34);
  background: rgba(2, 12, 15, 0.52);
}

.back-control {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-62%);
  width: 68rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e0ad69;
  font-size: 72rpx;
  line-height: 72rpx;
}

.page-title {
  color: #e5b978;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.icon-hover,
.action-hover,
.secondary-hover {
  opacity: 0.72;
}

.room-meta-row {
  position: relative;
  z-index: 2;
  min-height: 100rpx;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.room-head {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.room-title {
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-wrap: nowrap;
}

.room-label {
  color: #e4af6e;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.room-code {
  max-width: 170rpx;
  color: #f0b160;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-separator,
.room-meta-text {
  flex: 0 0 auto;
  color: #e6bd83;
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

.room-separator {
  color: rgba(230, 189, 131, 0.72);
}

.top-actions {
  flex: 0 0 108rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
}

.tool-control {
  width: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #d9ad73;
}

.tool-icon-image {
  display: block;
  width: 58rpx;
  height: 58rpx;
  margin-bottom: 4rpx;
  filter: drop-shadow(0 5rpx 10rpx rgba(0, 0, 0, 0.52));
}

.tool-text {
  color: #e0b373;
  font-size: 18rpx;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
}

.board-layout {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 140rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.solo-control-strip {
  min-height: 58rpx;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid rgba(31, 204, 215, 0.5);
  color: #bdeff0;
  background: rgba(3, 43, 47, 0.74);
}

.solo-mark {
  height: 34rpx;
  padding: 0 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(31, 204, 215, 0.62);
  color: #082024;
  font-size: 20rpx;
  font-weight: 800;
  background: #21d0db;
  white-space: nowrap;
}

.solo-seat {
  min-width: 0;
  color: #e8c48a;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.solo-hint {
  color: rgba(189, 239, 240, 0.76);
  font-size: 19rpx;
  white-space: nowrap;
}

.seat-row {
  display: grid;
  grid-template-columns: repeat(5, 138rpx);
  justify-content: center;
  gap: 14rpx 0;
  padding: 2rpx 0 0;
}

.seat-card {
  position: relative;
  width: 138rpx;
  min-width: 0;
  height: 281rpx;
  padding: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  box-shadow: none;
  overflow: visible;
}

.seat-card::before {
  content: none;
}

.seat-art {
  position: absolute;
  left: 50%;
  top: 0;
  width: 138rpx;
  height: 281rpx;
  transform: translateX(-50%);
}

.seat-frame-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  filter: drop-shadow(0 8rpx 10rpx rgba(0, 0, 0, 0.46));
}

.seat-card.is-current {
  filter: drop-shadow(0 0 12rpx rgba(22, 213, 223, 0.55));
}

.seat-card.is-controlled {
  filter: drop-shadow(0 0 12rpx rgba(241, 189, 118, 0.58));
}

.seat-card.is-controlled::after {
  content: "操控";
  position: absolute;
  right: 3rpx;
  top: 11rpx;
  z-index: 4;
  padding: 2rpx 7rpx;
  color: #081719;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.2;
  background: #f1bd76;
}

.seat-card.is-nominee {
  filter: drop-shadow(0 0 13rpx rgba(216, 162, 72, 0.56));
}

.seat-card.is-eligible-nominee {
  filter: drop-shadow(0 0 12rpx rgba(32, 203, 212, 0.5));
}

.seat-card.is-eligible-executive-target {
  filter: drop-shadow(0 0 12rpx rgba(32, 203, 212, 0.5));
}

.seat-card.is-selected-nomination {
  filter: drop-shadow(0 0 16rpx rgba(232, 181, 99, 0.72));
}

.seat-card.is-selected-executive-target {
  filter: drop-shadow(0 0 16rpx rgba(232, 181, 99, 0.72));
}

.seat-card.is-vote-submitted {
  filter: drop-shadow(0 0 15rpx rgba(82, 224, 135, 0.74)) drop-shadow(0 0 27rpx rgba(30, 153, 84, 0.38));
}

.seat-card.is-ineligible-nominee {
  opacity: 0.72;
}

.seat-card.is-ineligible-executive-target {
  opacity: 0.72;
}

.seat-card.is-empty {
  justify-content: center;
  opacity: 0.58;
}

.seat-no {
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  z-index: 2;
  color: #deb073;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.8);
}

.avatar {
  position: absolute;
  left: 50%;
  top: 48rpx;
  z-index: 2;
  width: 83rpx;
  height: 83rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #b57c42;
  border-radius: 50%;
  color: #031014;
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #d9c29a 0%, #74502c 100%);
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.seat-name {
  position: absolute;
  left: 50%;
  top: 148rpx;
  z-index: 2;
  width: 105rpx;
  transform: translateX(-50%);
  margin-top: 0;
  color: #e9bf83;
  font-size: 20rpx;
  line-height: 1.12;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.role-badge {
  position: absolute;
  left: 50%;
  top: 176rpx;
  z-index: 5;
  width: 100rpx;
  height: 29rpx;
  transform: translateX(-50%);
}

.role-badge-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.investigation-stamp {
  position: absolute;
  right: -17rpx;
  top: 0;
  z-index: 6;
  width: 79rpx;
  height: 79rpx;
  pointer-events: none;
  filter: drop-shadow(0 4rpx 5rpx rgba(0, 0, 0, 0.5));
}

.identity-mark {
  position: absolute;
  left: 50%;
  top: 214rpx;
  z-index: 7;
  width: 43rpx;
  height: 43rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(226, 188, 139, 0.78);
  border-radius: 50%;
  background: rgba(61, 65, 63, 0.92);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.42);
  overflow: hidden;
}

.identity-mark.is-liberal {
  border-color: rgba(34, 210, 221, 0.84);
  background: rgba(4, 38, 43, 0.92);
}

.identity-mark.is-fascist {
  border-color: rgba(231, 75, 50, 0.82);
  background: rgba(46, 13, 10, 0.92);
}

.identity-mark-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.identity-option {
  width: 96rpx;
  height: 96rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(226, 188, 139, 0.66);
  border-radius: 50%;
  background: #4b504e;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.identity-option.is-liberal {
  border-color: rgba(34, 210, 221, 0.76);
  background: rgba(6, 47, 52, 0.9);
}

.identity-option.is-fascist {
  border-color: rgba(231, 75, 50, 0.76);
  background: rgba(58, 15, 12, 0.9);
}

.identity-option.is-active {
  box-shadow: 0 0 18rpx currentColor, 0 8rpx 16rpx rgba(0, 0, 0, 0.35);
}

.identity-option-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.identity-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.58);
}

.identity-modal {
  position: relative;
  width: 100%;
  max-width: 660rpx;
  min-height: 468rpx;
  box-sizing: border-box;
  color: #e9bf83;
  background:
    linear-gradient(180deg, rgba(25, 37, 34, 0.98) 0%, rgba(10, 18, 17, 0.98) 100%);
  box-shadow: 0 28rpx 68rpx rgba(0, 0, 0, 0.62);
  animation: identityModalIn 150ms ease-out both;
}

.identity-modal-frame {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.identity-modal-content {
  position: relative;
  z-index: 1;
  min-height: 468rpx;
  padding: 76rpx 54rpx 48rpx;
  box-sizing: border-box;
}

.identity-modal-title {
  color: #f0c184;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.15;
  text-align: center;
}

.identity-modal-icon-row,
.identity-modal-label-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  justify-items: center;
}

.identity-modal-icon-row {
  margin-top: 46rpx;
  column-gap: 18rpx;
}

.identity-modal-label-row {
  margin-top: 16rpx;
  column-gap: 18rpx;
}

.identity-option-label {
  color: rgba(238, 199, 144, 0.88);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.15;
  text-align: center;
}

.identity-modal-cancel {
  position: relative;
  width: 212rpx;
  height: 66rpx;
  margin: 46rpx auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e9bf83;
  font-size: 24rpx;
  font-weight: 800;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.48);
}

.identity-modal-cancel-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.identity-modal-cancel-text {
  position: relative;
  z-index: 1;
  color: #e9bf83;
}

@keyframes identityModalIn {
  from {
    opacity: 0;
    transform: translateY(12rpx) scale(0.98);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.seat-card.is-dead {
  opacity: 0.52;
}

.center-board {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  padding: 4rpx 10rpx 2rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(159, 102, 48, 0.42);
  background: rgba(3, 15, 17, 0.48);
  box-shadow: inset 0 0 56rpx rgba(0, 0, 0, 0.48);
}

.phase-banner {
  min-height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(161, 110, 56, 0.42);
  border-bottom: 1rpx solid rgba(161, 110, 56, 0.42);
}

.eagle-mark {
  width: 112rpx;
  height: 18rpx;
  border-top: 4rpx solid #b17d45;
  border-bottom: 2rpx solid rgba(177, 125, 69, 0.72);
  opacity: 0.82;
}

.phase-title {
  margin-top: 5rpx;
  color: #e0a668;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.track-panel {
  margin-top: 10rpx;
  padding: 0;
  background: transparent;
}

.policy-track-shell {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 42.8333%;
  overflow: visible;
}

.policy-track-shell::before {
  content: "";
  position: absolute;
  inset: 10rpx 12rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.3);
  background: rgba(4, 16, 16, 0.72);
  box-shadow: inset 0 0 46rpx rgba(0, 0, 0, 0.62);
}

.policy-track-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.track-title {
  position: relative;
  color: #18d3dd;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.policy-row {
  position: absolute;
  z-index: 2;
  display: grid;
  align-items: end;
  justify-items: center;
}

.liberal-row {
  left: 10.5%;
  right: 9.5%;
  top: 32%;
  height: 54%;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  column-gap: 1.2%;
}

.fascist-row {
  left: 7.5%;
  right: 7.5%;
  top: 33%;
  height: 52%;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  column-gap: 1%;
}

.policy-cell {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(226, 188, 139, 0.76);
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

.policy-label {
  max-width: 92%;
  line-height: 1.08;
}

.policy-card-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 8rpx 8rpx rgba(0, 0, 0, 0.46));
}

.policy-cell.is-new-policy .policy-card-image {
  animation: policyDropIn 420ms cubic-bezier(0.18, 0.82, 0.24, 1) both;
}

.power-badge-control {
  position: absolute;
  left: 50%;
  bottom: -24rpx;
  width: 34rpx;
  height: 34rpx;
  transform: translateX(-50%);
  z-index: 3;
}

.power-badge-image {
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 6rpx 7rpx rgba(0, 0, 0, 0.45));
}

.policy-cell.is-enacted .power-badge-control {
  opacity: 0.94;
}

.power-tip {
  position: absolute;
  left: 50%;
  bottom: 40rpx;
  min-width: 126rpx;
  padding: 8rpx 10rpx;
  box-sizing: border-box;
  transform: translateX(-50%);
  border: 1rpx solid rgba(211, 163, 89, 0.72);
  color: #f3d59d;
  font-size: 18rpx;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
  background: rgba(20, 13, 8, 0.94);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.35);
}

.power-tip::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -7rpx;
  width: 12rpx;
  height: 12rpx;
  transform: translateX(-50%) rotate(45deg);
  border-right: 1rpx solid rgba(211, 163, 89, 0.72);
  border-bottom: 1rpx solid rgba(211, 163, 89, 0.72);
  background: rgba(20, 13, 8, 0.94);
}

@keyframes policyDropIn {
  0% {
    opacity: 0;
    transform: translateY(-22rpx) scale(1.04) rotate(-1deg);
  }

  68% {
    opacity: 1;
    transform: translateY(3rpx) scale(0.995) rotate(0deg);
  }

  100% {
    opacity: 1;
    transform: translateY(0) scale(1) rotate(0deg);
  }
}

.track-progress,
.election-progress {
  margin-top: 10rpx;
  color: rgba(221, 190, 143, 0.76);
  font-size: 20rpx;
  line-height: 1.2;
  text-align: center;
}

.progress-count {
  color: #1bd5df;
  font-weight: 800;
}

.fascist-count {
  color: #ef6048;
}

.veto-note {
  margin-top: 8rpx;
  color: #f1bd76;
  font-size: 20rpx;
  line-height: 1.25;
  text-align: center;
}

.election-panel {
  margin-top: 10rpx;
  padding: 0;
  background: transparent;
}

.election-track-shell {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 21.7514%;
  overflow: visible;
}

.election-track-shell::before {
  content: "";
  position: absolute;
  inset: 8rpx 12rpx;
  border: 1rpx solid rgba(159, 102, 48, 0.3);
  background: rgba(4, 16, 16, 0.72);
  box-shadow: inset 0 0 40rpx rgba(0, 0, 0, 0.58);
}

.election-track-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.election-row {
  position: absolute;
  left: 30.5%;
  right: 30.5%;
  top: 38%;
  z-index: 2;
  height: 36%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.election-slot {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(216, 171, 110, 0.72);
  font-size: 24rpx;
  font-weight: 800;
}

.election-slot-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  filter: drop-shadow(0 7rpx 8rpx rgba(0, 0, 0, 0.48));
}

.election-slot.is-active .election-slot-image {
  filter: drop-shadow(0 0 12rpx rgba(233, 188, 114, 0.28)) drop-shadow(0 7rpx 8rpx rgba(0, 0, 0, 0.48));
}

.election-slot-label {
  position: relative;
  z-index: 1;
  color: #c5955b;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 2rpx 2rpx rgba(0, 0, 0, 0.72), 0 0 8rpx rgba(220, 164, 91, 0.26);
}

.election-slot.is-active .election-slot-label {
  color: #f0c47d;
  text-shadow: 0 2rpx 2rpx rgba(0, 0, 0, 0.76), 0 0 10rpx rgba(236, 185, 105, 0.36);
}

.deck-piles-panel {
  margin-top: 10rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
}

.deck-pile {
  position: relative;
  overflow: hidden;
  min-width: 0;
  min-height: 112rpx;
  padding: 12rpx 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border: 0;
  background: rgba(6, 18, 18, 0.44);
}

.deck-pile.is-draw {
  background: rgba(4, 26, 27, 0.42);
}

.deck-pile.is-discard {
  background: rgba(24, 11, 7, 0.42);
}

.deck-pile-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.96;
}

.deck-card-stack {
  position: relative;
  z-index: 1;
  flex: 0 0 74rpx;
  width: 74rpx;
  height: 88rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 8rpx rgba(0, 0, 0, 0.34);
}

.deck-card-image {
  width: 100%;
  height: 100%;
}

