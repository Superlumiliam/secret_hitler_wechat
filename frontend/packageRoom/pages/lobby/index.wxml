<view class="lobby-page">
  <image
    wx:if="{{backgroundVisible}}"
    class="lobby-background"
    src="{{backgroundSrc}}"
    mode="aspectFill"
    webp="{{true}}"
  />
  <view class="lobby-overlay"></view>

  <view class="top-bar">
    <view class="back-control" bindtap="onBackHome" hover-class="icon-hover" role="button" aria-label="返回首页">‹</view>
  </view>

  <view wx:if="{{isLoading}}" class="state-text">正在进入房间...</view>

  <view wx:elif="{{lobby}}" class="lobby-content">
    <view class="room-head">
      <view>
        <text class="room-code-label">房间号</text>
        <text class="room-code">{{lobby.roomCode}}</text>
      </view>
      <view class="room-actions">
        <view class="tool-control" bindtap="onTapRoomSettings" role="button" aria-label="房间设置">
          <view class="tool-icon gear-icon"></view>
          <view class="tool-text">房间设置</view>
        </view>
        <view class="tool-control" bindtap="onTapRules" role="button" aria-label="规则说明">
          <view class="tool-icon rules-icon"></view>
          <view class="tool-text">规则说明</view>
        </view>
      </view>
    </view>

    <view class="room-meta">目标 {{lobby.targetPlayerCount}} 人 · 当前 {{lobby.playerCount}} 人</view>

    <view class="seat-grid">
      <view wx:for="{{seats}}" wx:key="seatIndex" class="seat-card {{item.isReady ? 'is-ready' : ''}}">
        <view class="seat-index">{{item.seatIndex}}</view>
        <block wx:if="{{item.isEmpty}}">
          <view class="seat-body">
            <image class="seat-avatar" src="{{item.avatarSrc}}" mode="aspectFit" webp="{{true}}"></image>
            <view class="seat-name">邀请好友</view>
          </view>
          <button class="seat-share-hitarea" open-type="share" hover-class="seat-hover" aria-label="邀请好友"></button>
        </block>
        <block wx:else>
          <view class="seat-body">
            <image class="seat-avatar" src="{{item.avatarSrc}}" mode="aspectFit" webp="{{true}}"></image>
            <view class="seat-name">{{item.displayName}}</view>
            <view class="seat-tags">
              <view wx:if="{{item.isHost}}" class="host-tag">房主</view>
              <view wx:if="{{item.isReady}}" class="ready-tag">已准备</view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <button
      class="primary-action {{lobby.viewerState.isHost && lobby.viewerState.myIsReady && !lobby.viewerState.canStart ? 'is-disabled' : ''}}"
      bindtap="onReadyAction"
      loading="{{isSubmitting}}"
      disabled="{{isSubmitting || (lobby.viewerState.isHost && lobby.viewerState.myIsReady && !lobby.viewerState.canStart)}}"
    >
      {{lobby.viewerState.isHost && lobby.viewerState.myIsReady ? '开始' : (lobby.viewerState.myIsReady ? '已准备' : '准备')}}
    </button>
  </view>

  <view wx:else class="state-text">房间暂不可用</view>
</view>
