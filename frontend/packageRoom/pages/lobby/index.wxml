<view class="lobby-page">
  <image
    wx:if="{{backgroundVisible}}"
    class="lobby-background"
    src="{{backgroundSrc}}"
    mode="aspectFill"
    webp="{{true}}"
  />
  <view class="lobby-overlay"></view>

  <view class="top-bar">
    <view class="back-control" bindtap="onBackHome" hover-class="icon-hover" role="button" aria-label="返回首页">‹</view>
    <view class="page-title">房间大厅</view>
  </view>

  <view wx:if="{{isLoading}}" class="state-text">正在进入房间...</view>

  <view wx:elif="{{lobby}}" class="lobby-content">
    <view class="room-head">
      <view class="room-code-row">
        <text class="room-code-label">房间号</text>
        <text class="room-code">{{lobby.roomCode}}</text>
      </view>

      <view class="room-actions {{lobby.isSoloRoom ? 'is-solo' : ''}}">
        <button
          wx:if="{{!lobby.isSoloRoom}}"
          class="tool-control tool-share-control"
          open-type="share"
          hover-class="none"
          aria-label="好友邀请"
        >
          <image wx:if="{{lobbyAssets.logoInvite}}" class="tool-icon-image" src="{{lobbyAssets.logoInvite}}" mode="aspectFit" webp="{{true}}"></image>
          <view class="tool-text">好友邀请</view>
        </button>
        <view class="tool-control room-settings-control" bindtap="onTapRoomSettings" role="button" aria-label="房间设置">
          <image wx:if="{{lobbyAssets.logoRoomAdjust}}" class="tool-icon-image" src="{{lobbyAssets.logoRoomAdjust}}" mode="aspectFit" webp="{{true}}"></image>
          <view class="tool-text">房间设置</view>
        </view>
        <view class="tool-control" bindtap="onTapRules" role="button" aria-label="规则说明">
          <image wx:if="{{lobbyAssets.logoRule}}" class="tool-icon-image" src="{{lobbyAssets.logoRule}}" mode="aspectFit" webp="{{true}}"></image>
          <view class="tool-text">规则说明</view>
        </view>
      </view>

      <view class="lobby-seat-hint">双击空席位可切换座位。</view>
      <view class="room-meta">玩家 {{lobby.playerCount}}/{{lobby.targetPlayerCount}} · 准备 {{readyPlayerCount}} · 观战 {{lobby.spectatorCount}}/{{lobby.spectatorCapacity}}</view>
    </view>

    <view wx:if="{{lobby.isSoloRoom}}" class="solo-panel">
      <view class="solo-label">单人模式</view>
      <view class="solo-actions">
        <view
          class="solo-action {{isSoloActionSubmitting ? 'is-disabled' : ''}}"
          bindtap="onSoloFillVirtualPlayers"
          role="button"
          aria-label="补齐虚拟玩家"
        >
          一键补齐
        </view>
        <view
          class="solo-action {{isSoloActionSubmitting ? 'is-disabled' : ''}}"
          bindtap="onSoloReadyAllVirtualPlayers"
          role="button"
          aria-label="虚拟玩家全员准备"
        >
          全员准备
        </view>
      </view>
    </view>

    <view class="seat-grid">
      <view wx:for="{{seats}}" wx:key="seatIndex" class="seat-card {{item.isReady ? 'is-ready' : ''}} {{item.isEmpty ? 'is-empty' : ''}} {{seatChangeSubmitting ? 'is-submitting' : ''}}">
        <image wx:if="{{lobbyAssets.roomPlayerFrame}}" class="seat-frame-image" src="{{lobbyAssets.roomPlayerFrame}}" mode="scaleToFill" webp="{{true}}"></image>
        <view class="seat-index">{{item.seatIndex}}</view>
        <block wx:if="{{item.isEmpty}}">
          <view
            class="seat-body empty-seat-control"
            bindtap="onTapEmptySeat"
            hover-class="none"
            data-seat-index="{{item.seatIndex}}"
            data-member-type="player"
            role="button"
            aria-label="{{seatChangeSubmitting ? '正在换座' : '双击换到该空席位'}}"
          >
            <image class="seat-avatar" src="{{item.avatarSrc}}" mode="aspectFit" webp="{{true}}"></image>
            <view class="seat-name">{{lobby.isSoloRoom ? '待补齐' : '空席位'}}</view>
          </view>
        </block>
        <block wx:else>
          <view class="seat-body">
            <image class="seat-avatar" src="{{item.avatarSrc}}" mode="aspectFit" webp="{{true}}"></image>
            <view class="seat-name">{{item.displayName}}</view>
            <view wx:if="{{item.roleLabel}}" class="seat-badges">
              <view wx:if="{{item.roleLabel}}" class="seat-identity">
                <image wx:if="{{lobbyAssets.roomIdentity}}" class="seat-identity-image" src="{{lobbyAssets.roomIdentity}}" mode="scaleToFill" webp="{{true}}"></image>
                <text class="seat-identity-text">{{item.roleLabel}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="spectator-section">
      <view class="spectator-heading">
        <text class="spectator-title">观战席</text>
        <text class="spectator-count">{{lobby.spectatorCount}}/{{lobby.spectatorCapacity}}</text>
      </view>
      <view class="spectator-seat-row">
        <view
          wx:for="{{spectatorSeats}}"
          wx:key="seatIndex"
          class="spectator-seat {{item.isEmpty ? 'is-empty' : ''}} {{seatChangeSubmitting ? 'is-submitting' : ''}}"
        >
          <image wx:if="{{lobbyAssets.spectatorFrame}}" class="spectator-frame-image" src="{{lobbyAssets.spectatorFrame}}" mode="scaleToFill" webp="{{true}}"></image>
          <view class="spectator-seat-index">{{item.seatIndex}}</view>
          <view
            wx:if="{{item.isEmpty}}"
            class="spectator-seat-body empty-seat-control"
            bindtap="onTapEmptySeat"
            hover-class="none"
            data-seat-index="{{item.seatIndex}}"
            data-member-type="spectator"
            role="button"
            aria-label="{{seatChangeSubmitting ? '正在切换席位' : '双击切换到该观战席'}}"
          >
            <image class="spectator-avatar" src="{{item.avatarSrc}}" mode="aspectFit" webp="{{true}}"></image>
            <view class="spectator-name">空观战席</view>
          </view>
          <view wx:else class="spectator-seat-body">
            <image class="spectator-avatar" src="{{item.avatarSrc}}" mode="aspectFit" webp="{{true}}"></image>
            <view class="spectator-copy">
              <view class="spectator-name">{{item.displayName}}</view>
              <view wx:if="{{item.roleLabel}}" class="spectator-host">{{item.roleLabel}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <button
      class="primary-action {{(lobby.viewerState.myMemberType === 'spectator' && (!lobby.viewerState.isHost || !lobby.viewerState.canStart)) || (lobby.viewerState.myMemberType !== 'spectator' && lobby.viewerState.isHost && lobby.viewerState.myIsReady && !lobby.viewerState.canStart) ? 'is-disabled' : ''}}"
      bindtap="onReadyAction"
      loading="{{isSubmitting}}"
      disabled="{{isSubmitting || (lobby.viewerState.myMemberType === 'spectator' && !lobby.viewerState.isHost)}}"
    >
      {{lobby.viewerState.myMemberType === 'spectator' ? (lobby.viewerState.isHost ? '开始' : '观战中') : (lobby.viewerState.isHost && lobby.viewerState.myIsReady ? '开始' : (lobby.viewerState.myIsReady ? '已准备' : '准备'))}}
    </button>
  </view>

  <view wx:else class="state-text">房间暂不可用</view>
</view>
