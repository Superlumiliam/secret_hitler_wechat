page {
  min-height: 100vh;
  background: #031014;
}

.lobby-page {
  position: relative;
  min-height: 100vh;
  padding: calc(96rpx + env(safe-area-inset-top)) 32rpx 44rpx;
  box-sizing: border-box;
  background: #031014;
  color: #e0b06d;
  font-family: "Songti SC", STSong, SimSun, serif;
}

.lobby-background,
.lobby-overlay {
  position: absolute;
  inset: 0;
}

.lobby-background {
  width: 100%;
  height: 100%;
  z-index: 0;
}

.lobby-overlay {
  z-index: 1;
  background: linear-gradient(180deg, rgba(3, 15, 18, 0.48) 0%, rgba(3, 15, 18, 0.3) 44%, rgba(1, 8, 10, 0.94) 100%);
}

.top-bar {
  position: relative;
  z-index: 2;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(185, 128, 66, 0.44);
  border-bottom: 1rpx solid rgba(185, 128, 66, 0.34);
  background: rgba(2, 12, 15, 0.52);
}

.back-control {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-62%);
  width: 68rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e0ad69;
  font-size: 72rpx;
  line-height: 72rpx;
}

.page-title {
  color: #e5b978;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.state-text {
  position: relative;
  z-index: 2;
  margin-top: 240rpx;
  color: rgba(240, 212, 164, 0.78);
  text-align: center;
  font-size: 30rpx;
}

.lobby-content {
  position: relative;
  z-index: 2;
  min-height: calc(100vh - 174rpx - env(safe-area-inset-top));
  display: flex;
  flex-direction: column;
}

.room-head {
  margin-top: 58rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 22rpx;
}

.room-code-label {
  color: #e5b171;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0;
  white-space: nowrap;
}

.room-code {
  margin-left: 20rpx;
  color: #f2b15d;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-shadow: 0 0 18rpx rgba(4, 8, 8, 0.76);
}

.room-actions {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.tool-control {
  width: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #d7a35e;
}

.tool-icon-image {
  display: block;
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 4rpx;
  filter: drop-shadow(0 5rpx 10rpx rgba(0, 0, 0, 0.52));
}

.tool-text {
  color: #d7a35e;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.78);
  white-space: nowrap;
}

.room-meta {
  margin-top: 20rpx;
  color: rgba(236, 198, 142, 0.75);
  font-size: 26rpx;
}

.lobby-seat-hint {
  margin-top: 12rpx;
  color: rgba(224, 190, 136, 0.78);
  font-size: 22rpx;
  line-height: 1.5;
}

.solo-panel {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border: 1rpx solid rgba(19, 203, 208, 0.5);
  background: rgba(4, 24, 29, 0.68);
}

.solo-label {
  flex: 1;
  min-width: 0;
  color: #13cbd0;
  font-size: 24rpx;
  font-weight: 700;
}

.solo-actions {
  display: flex;
  gap: 12rpx;
}

.solo-action {
  min-width: 132rpx;
  height: 52rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(19, 203, 208, 0.76);
  color: #031014;
  font-size: 22rpx;
  font-weight: 800;
  background: #13cbd0;
}

.solo-action.is-disabled {
  opacity: 0.62;
}

.seat-grid {
  margin-top: 36rpx;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18rpx 8rpx;
}

.seat-card {
  position: relative;
  justify-self: center;
  width: 150rpx;
  height: 210rpx;
  padding: 18rpx 6rpx 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0;
  background: transparent;
  box-shadow: none;
  overflow: hidden;
}

.seat-card.is-ready {
  filter: drop-shadow(0 0 15rpx rgba(82, 224, 135, 0.74)) drop-shadow(0 0 27rpx rgba(30, 153, 84, 0.38));
}

.seat-card.is-empty:not(.is-submitting) {
  cursor: pointer;
}

.seat-card.is-invite-armed {
  filter: drop-shadow(0 0 14rpx rgba(31, 206, 211, 0.76));
}

.seat-frame-image {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.seat-index {
  position: absolute;
  left: 18rpx;
  top: 14rpx;
  z-index: 1;
  color: #cfa367;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1;
  text-shadow: 0 2rpx 0 rgba(15, 10, 4, 0.9), 0 0 10rpx rgba(226, 178, 104, 0.2);
  pointer-events: none;
}

.seat-body {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  min-width: 0;
  padding-top: 20rpx;
}

.empty-seat-control {
  position: relative;
  z-index: 2;
  -webkit-tap-highlight-color: transparent;
  -webkit-user-select: none;
  user-select: none;
}

.seat-share-action {
  position: absolute;
  inset: 0;
  z-index: 4;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  color: transparent;
  font-size: 0;
  line-height: 0;
  background: transparent;
}

.seat-share-action::after {
  border: 0;
}

.seat-avatar {
  display: block;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  box-sizing: border-box;
  border: 4rpx solid rgba(196, 151, 85, 0.96);
  border-radius: 50%;
  background: rgba(4, 12, 12, 0.9);
  box-shadow: 0 0 0 1rpx rgba(41, 23, 9, 0.9), 0 8rpx 16rpx rgba(0, 0, 0, 0.46);
}

.seat-name {
  flex: 0 0 24rpx;
  width: 100%;
  height: 24rpx;
  margin-top: 16rpx;
  color: #d4a461;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 24rpx;
  text-align: center;
  text-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.84);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-badges {
  flex: 0 0 33rpx;
  width: 104rpx;
  height: 33rpx;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.seat-identity {
  position: relative;
  flex: 0 0 33rpx;
  width: 68rpx;
  height: 33rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.seat-identity-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.seat-identity-text {
  position: relative;
  z-index: 1;
  color: #2c1708;
  font-size: 18rpx;
  font-weight: 900;
  line-height: 1;
  text-shadow: 0 1rpx 0 rgba(242, 202, 137, 0.56), 0 0 2rpx rgba(44, 23, 8, 0.22);
}

.primary-action {
  width: 520rpx;
  height: 104rpx;
  margin: auto auto 24rpx;
  padding: 0;
  border: 6rpx solid rgba(35, 222, 226, 0.46);
  border-radius: 52rpx;
  color: #062932;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 92rpx;
  letter-spacing: 0;
  background: linear-gradient(180deg, #2ee6e7 0%, #10bfc5 100%);
  box-shadow: 0 0 0 6rpx rgba(23, 205, 208, 0.18), 0 16rpx 32rpx rgba(0, 0, 0, 0.42);
}

.primary-action::after {
  border: 0;
}

.primary-action.is-disabled,
.primary-action[disabled] {
  color: rgba(8, 42, 48, 0.68);
  background: linear-gradient(180deg, #85ccd0 0%, #5ba2a8 100%);
  opacity: 0.76;
}

.icon-hover,
.seat-hover {
  opacity: 0.76;
}
