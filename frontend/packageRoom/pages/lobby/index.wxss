page {
  min-height: 100vh;
  background: #061016;
}

.lobby-page {
  min-height: 100vh;
  padding: calc(48rpx + env(safe-area-inset-top)) 34rpx 48rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at 50% 10%, rgba(38, 206, 210, 0.18), transparent 34%),
    linear-gradient(180deg, #07171d 0%, #03080b 100%);
  color: #f2d9a7;
}

.top-bar {
  position: relative;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-control {
  position: absolute;
  left: 0;
  top: 0;
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d7a35d;
  font-size: 78rpx;
  line-height: 54rpx;
  background: transparent;
  border: 0;
}

.back-control::after {
  border: 0;
}

.page-title {
  color: #dca85e;
  font-size: 36rpx;
  font-weight: 800;
}

.state-text {
  margin-top: 240rpx;
  color: rgba(242, 217, 167, 0.76);
  text-align: center;
  font-size: 30rpx;
}

.lobby-content {
  margin-top: 80rpx;
  text-align: center;
}

.room-code-label {
  color: rgba(242, 217, 167, 0.68);
  font-size: 28rpx;
}

.room-code {
  margin-top: 18rpx;
  color: #45edf0;
  font-size: 76rpx;
  font-weight: 900;
}

.room-meta {
  margin-top: 12rpx;
  color: rgba(242, 217, 167, 0.78);
  font-size: 28rpx;
}

.seat-panel {
  margin-top: 64rpx;
  padding: 28rpx;
  border: 2rpx solid rgba(119, 154, 162, 0.48);
  border-radius: 8rpx;
  background: rgba(17, 34, 41, 0.78);
  text-align: left;
}

.seat-title {
  margin-bottom: 20rpx;
  color: #94c6d6;
  font-size: 30rpx;
  font-weight: 800;
}

.seat-row {
  height: 72rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid rgba(148, 198, 214, 0.18);
}

.seat-index {
  width: 48rpx;
  color: #45edf0;
  font-weight: 800;
}

.seat-name {
  flex: 1;
  color: #f4e0b5;
  font-size: 28rpx;
}

.host-tag {
  padding: 6rpx 14rpx;
  color: #061016;
  font-size: 22rpx;
  font-weight: 800;
  background: #dca85e;
}

.icon-hover {
  opacity: 0.76;
}
