page {
  min-height: 100vh;
  background: #061016;
}

.rules-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  padding: calc(72rpx + env(safe-area-inset-top)) 26rpx calc(42rpx + env(safe-area-inset-bottom));
  color: #e8c48a;
  font-family: "Songti SC", STSong, SimSun, serif;
  background:
    linear-gradient(180deg, rgba(4, 13, 15, 0.26), rgba(2, 7, 8, 0.92)),
    radial-gradient(circle at 50% 22%, rgba(31, 183, 188, 0.15), transparent 32%),
    #061016;
}

.rules-noise {
  position: absolute;
  inset: 14rpx;
  pointer-events: none;
  border: 1rpx solid rgba(185, 128, 66, 0.5);
  box-shadow:
    inset 0 0 0 2rpx rgba(7, 23, 24, 0.86),
    inset 0 0 90rpx rgba(0, 0, 0, 0.74);
}

.top-bar,
.rules-hero,
.section-tabs,
.rules-list {
  position: relative;
  z-index: 1;
}

.top-bar {
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(185, 128, 66, 0.44);
  border-bottom: 1rpx solid rgba(185, 128, 66, 0.34);
  background: rgba(2, 12, 15, 0.52);
}

.back-control {
  position: absolute;
  left: 0;
  top: 0;
  width: 68rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #e0ad69;
  font-size: 72rpx;
  line-height: 72rpx;
}

.icon-hover {
  opacity: 0.72;
}

.page-title {
  color: #e5b978;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.rules-hero {
  margin-top: 24rpx;
  min-height: 220rpx;
  box-sizing: border-box;
  overflow: hidden;
  border: 1rpx solid rgba(197, 139, 72, 0.54);
  background:
    linear-gradient(135deg, rgba(33, 24, 16, 0.9), rgba(5, 31, 34, 0.82)),
    #14110d;
  box-shadow: 0 18rpx 58rpx rgba(0, 0, 0, 0.35);
}

.rule-story-image {
  display: block;
  width: 100%;
}

.section-tabs {
  margin-top: 22rpx;
  box-sizing: border-box;
  width: 100%;
}

.section-tab-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  width: 100%;
  padding-bottom: 6rpx;
}

.section-tab {
  min-width: 0;
  min-height: 56rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(164, 113, 62, 0.54);
  color: rgba(229, 188, 128, 0.76);
  background: rgba(13, 18, 17, 0.86);
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
}

.section-tab.is-active {
  border-color: rgba(38, 210, 218, 0.72);
  color: #071719;
  background: linear-gradient(180deg, #33d7df 0%, #13919a 100%);
}

.rules-list {
  margin-top: 18rpx;
}

.rule-section {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid rgba(174, 118, 61, 0.45);
  background: rgba(7, 17, 18, 0.84);
}

.rule-section.is-active {
  border-color: rgba(197, 139, 72, 0.54);
  box-shadow: 0 0 22rpx rgba(197, 139, 72, 0.12);
}

.rule-one-flow-image {
  display: block;
  width: 100%;
}

.section-heading {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-index {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(38, 210, 218, 0.5);
  color: #27d1da;
  background: rgba(8, 37, 40, 0.72);
  font-size: 23rpx;
  font-weight: 900;
}

.section-title {
  color: #eac38a;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}

.rule-items {
  margin-top: 18rpx;
}

.rule-groups {
  margin-top: 22rpx;
}

.rule-group {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(174, 118, 61, 0.28);
}

.rule-group:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}

.rule-group-title {
  color: #27d1da;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.25;
}

.rule-item {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.rule-bullet {
  width: 9rpx;
  height: 9rpx;
  margin-top: 14rpx;
  flex: 0 0 9rpx;
  background: #cf9454;
  box-shadow: 0 0 10rpx rgba(207, 148, 84, 0.54);
}

.rule-text {
  min-width: 0;
  flex: 1;
  color: rgba(244, 226, 197, 0.86);
  font-size: 27rpx;
  line-height: 1.58;
}

.rule-empty {
  margin-top: 28rpx;
  padding: 30rpx 24rpx;
  border: 1rpx dashed rgba(174, 118, 61, 0.44);
  color: rgba(244, 226, 197, 0.68);
  background: rgba(4, 12, 13, 0.48);
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}
