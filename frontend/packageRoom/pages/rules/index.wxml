<view class="rules-page">
  <view class="rules-noise"></view>

  <view class="top-bar">
    <view class="back-control" bindtap="onTapBack" hover-class="icon-hover" role="button" aria-label="返回">‹</view>
    <view class="page-title">局内规则</view>
  </view>

  <view class="rules-hero">
    <image
      wx:if="{{ruleStorySrc}}"
      class="rule-story-image"
      src="{{ruleStorySrc}}"
      mode="widthFix"
      webp="{{true}}"
      data-asset-key="story"
      binderror="onRuleAssetError"
    ></image>
  </view>

  <scroll-view class="section-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="section-tab-row">
      <view
        wx:for="{{sections}}"
        wx:key="id"
        class="section-tab {{activeSectionId === item.id ? 'is-active' : ''}}"
        bindtap="onTapSection"
        data-section-id="{{item.id}}"
        role="button"
        aria-label="查看{{item.title}}规则"
      >
        {{item.title}}
      </view>
    </view>
  </scroll-view>

  <view class="rules-list">
    <view wx:if="{{activeSection}}" id="{{activeSection.id}}" class="rule-section is-active">
      <image
        wx:if="{{activeSection.imageOnly && activeSectionImageSrc}}"
        class="rule-one-flow-image"
        src="{{activeSectionImageSrc}}"
        mode="widthFix"
        webp="{{true}}"
        data-asset-key="{{activeSection.imageAssetKey}}"
        binderror="onRuleAssetError"
      ></image>

      <view wx:elif="{{!activeSection.imageOnly && !activeSection.hideHeading}}" class="section-heading">
        <view wx:if="{{!activeSection.hideIndex}}" class="section-index">{{activeSectionIndex + 1}}</view>
        <view class="section-title">{{activeSection.title}}</view>
      </view>

      <view wx:if="{{!activeSection.imageOnly && activeSection.description}}" class="section-description">
        {{activeSection.description}}
      </view>

      <view wx:if="{{!activeSection.imageOnly && activeSection.groups && activeSection.groups.length}}" class="rule-groups {{activeSection.layout === 'identity-cards' ? 'identity-rule-groups' : ''}}">
        <view wx:for="{{activeSection.groups}}" wx:key="title" class="rule-group {{activeSection.layout === 'identity-cards' ? 'identity-rule-group' : ''}}">
          <view wx:if="{{activeSection.layout === 'identity-cards'}}" class="identity-rule-card">
            <image
              wx:if="{{item.imageSrc}}"
              class="identity-rule-card-image"
              src="{{item.imageSrc}}"
              mode="aspectFit"
              webp="{{true}}"
              data-asset-key="{{item.imageAssetKey}}"
              binderror="onRuleAssetError"
            ></image>
            <view wx:else class="identity-rule-card-missing">{{item.title}}</view>
          </view>
          <view class="rule-group-main">
            <view class="rule-group-title">{{item.title}}</view>
            <view class="rule-items">
              <view wx:for="{{item.items}}" wx:for-item="rule" wx:key="*this" class="rule-item">
                <view class="rule-bullet"></view>
                <view class="rule-text">{{rule}}</view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:elif="{{!activeSection.imageOnly && activeSection.items && activeSection.items.length}}" class="rule-items">
        <view wx:for="{{activeSection.items}}" wx:for-item="rule" wx:key="*this" class="rule-item">
          <view class="rule-bullet"></view>
          <view class="rule-text">{{rule}}</view>
        </view>
      </view>

      <view wx:elif="{{!activeSection.imageOnly}}" class="rule-empty">{{activeSection.emptyText || "暂无内容"}}</view>
    </view>
  </view>
</view>
