page {
  min-height: 100vh;
  background: #061016;
}

.identity-page {
  position: relative;
  min-height: 100vh;
  padding: calc(68rpx + env(safe-area-inset-top)) 32rpx 40rpx;
  color: #d9aa6a;
  font-family: "Songti SC", STSong, SimSun, serif;
  background:
    linear-gradient(180deg, rgba(3, 12, 16, 0.26), rgba(2, 7, 10, 0.82)),
    radial-gradient(circle at 50% 30%, rgba(28, 214, 222, 0.18), transparent 28%),
    #061016;
}

.identity-background,
.identity-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.identity-background {
  z-index: 0;
}

.identity-overlay {
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(1, 8, 11, 0.1) 0%, rgba(1, 8, 11, 0.25) 50%, rgba(1, 5, 8, 0.8) 100%);
}

.top-bar,
.card-stage,
.panel,
.bottom-actions,
.identity-loading {
  position: relative;
  z-index: 2;
}

.top-bar {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(169, 111, 61, 0.55);
  border-bottom: 1rpx solid rgba(169, 111, 61, 0.36);
  background: rgba(2, 12, 16, 0.38);
}

.back-control {
  position: absolute;
  left: 0;
  top: 0;
  width: 74rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d7a35d;
  font-size: 78rpx;
  line-height: 86rpx;
}

.page-title {
  color: #d9aa6a;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.card-stage {
  height: 680rpx;
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.identity-card-frame {
  position: absolute;
  left: 50%;
  top: 30rpx;
  z-index: 3;
  width: 460rpx;
  height: 613rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%) translateY(0) scale(1);
  transform-origin: 50% 50%;
  transition: transform 560ms cubic-bezier(0.2, 0.82, 0.24, 1), opacity 420ms ease;
}

.identity-card-frame.liberal-card {
  filter: drop-shadow(0 0 24rpx rgba(42, 227, 235, 0.58));
}

.identity-card-frame.fascist-card,
.identity-card-frame.dictator-card {
  filter: drop-shadow(0 0 24rpx rgba(218, 89, 54, 0.42));
}

.identity-card-image {
  display: block;
  width: 100%;
  height: 100%;
}

.identity-card-missing {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(60, 242, 248, 0.72);
  color: #e7d7bb;
  font-size: 48rpx;
  font-weight: 900;
  background: rgba(6, 41, 49, 0.92);
  box-shadow:
    0 0 28rpx rgba(42, 227, 235, 0.42),
    inset 0 0 0 8rpx rgba(206, 223, 226, 0.1);
}

.panel {
  margin-top: 24rpx;
  min-height: 226rpx;
  position: relative;
  overflow: visible;
  color: #e2b174;
  background: rgba(3, 14, 18, 0.78);
}

.panel-content {
  position: relative;
  z-index: 1;
  min-height: 226rpx;
  box-sizing: border-box;
  padding: 72rpx 50rpx 34rpx;
}

.panel-frame-image {
  position: absolute;
  left: -4rpx;
  top: -4rpx;
  z-index: 0;
  width: calc(100% + 8rpx);
  height: calc(100% + 8rpx);
  pointer-events: none;
  filter: drop-shadow(0 10rpx 18rpx rgba(0, 0, 0, 0.36));
}

.info-panel {
  min-height: 270rpx;
}

.info-panel .panel-content {
  min-height: 270rpx;
  padding-top: 62rpx;
}

.tips-panel {
  min-height: 0;
}

.tips-panel .panel-content {
  min-height: 0;
  padding-bottom: 26rpx;
}

.section-title {
  position: absolute;
  left: 50%;
  top: 32rpx;
  transform: translateX(-50%);
  width: 220rpx;
  color: #28d8de;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.72);
}

.mission-line,
.info-line {
  margin-top: 16rpx;
  color: #e2b174;
  font-size: 28rpx;
  line-height: 1.45;
  text-align: center;
  text-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.54);
}

.mission-panel .mission-line {
  padding-left: 24rpx;
  position: relative;
  text-align: left;
}

.mission-panel .mission-line::before,
.tip-row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 14rpx;
  width: 7rpx;
  height: 7rpx;
  border: 1rpx solid rgba(40, 216, 222, 0.86);
  transform: rotate(45deg);
  background: rgba(40, 216, 222, 0.36);
}

.known-list {
  margin-top: 18rpx;
}

.known-member {
  min-height: 82rpx;
  margin-top: 14rpx;
  padding: 18rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  overflow: visible;
  border: 0;
  background: transparent;
}

.known-member-bg {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  filter: drop-shadow(0 6rpx 10rpx rgba(0, 0, 0, 0.32));
}

.known-avatar {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(205, 144, 83, 0.78);
  border-radius: 50%;
  color: #d9aa6a;
  font-size: 28rpx;
  background: rgba(45, 30, 19, 0.88);
  position: relative;
  z-index: 1;
  box-shadow:
    0 0 10rpx rgba(205, 144, 83, 0.3),
    inset 0 0 0 1rpx rgba(245, 199, 130, 0.24);
}

.known-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.known-main {
  min-width: 0;
  flex: 1;
  position: relative;
  z-index: 1;
}

.known-name {
  color: #ecd0a4;
  font-size: 28rpx;
}

.known-role {
  margin-top: 6rpx;
  color: rgba(226, 177, 116, 0.72);
  font-size: 22rpx;
}

.tip-row {
  margin-top: 15rpx;
  padding-left: 24rpx;
  position: relative;
}

.tip-text {
  color: #e2b174;
  font-size: 27rpx;
  line-height: 1.42;
  text-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.54);
}

.bottom-actions {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  gap: 36rpx;
}

.primary-action,
.secondary-action,
.retry-action {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 0;
  border-radius: 0;
  font-size: 34rpx;
  font-weight: 900;
  overflow: visible;
}

.primary-action {
  flex: 1.1;
  color: #062429;
  background: rgba(33, 205, 218, 0.16);
  box-shadow: 0 0 24rpx rgba(32, 226, 232, 0.36);
}

.secondary-action {
  flex: 1;
  color: #e0ad6b;
  background: rgba(48, 31, 19, 0.78);
}

.action-button-image {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  filter: drop-shadow(0 7rpx 10rpx rgba(0, 0, 0, 0.36));
}

.action-button-text {
  position: relative;
  z-index: 1;
  max-width: 88%;
  color: inherit;
  line-height: 1.1;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.42);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-loading {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  color: #d9aa6a;
  font-size: 30rpx;
}

.retry-action {
  width: 260rpx;
  border: 3rpx solid rgba(78, 231, 235, 0.64);
  color: #55e4e7;
  background: rgba(6, 34, 39, 0.86);
}

.icon-hover,
.action-hover {
  opacity: 0.78;
}
