page {
  min-height: 100vh;
  background: #061016;
}

.identity-page {
  position: relative;
  min-height: 100vh;
  padding: calc(68rpx + env(safe-area-inset-top)) 32rpx 40rpx;
  color: #d9aa6a;
  font-family: "Songti SC", STSong, SimSun, serif;
  background:
    linear-gradient(180deg, rgba(3, 12, 16, 0.26), rgba(2, 7, 10, 0.82)),
    radial-gradient(circle at 50% 30%, rgba(28, 214, 222, 0.18), transparent 28%),
    #061016;
}

.identity-background,
.identity-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.identity-background {
  z-index: 0;
}

.identity-overlay {
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(1, 8, 11, 0.1) 0%, rgba(1, 8, 11, 0.25) 50%, rgba(1, 5, 8, 0.8) 100%);
}

.top-bar,
.card-stage,
.panel,
.bottom-actions,
.identity-loading {
  position: relative;
  z-index: 2;
}

.top-bar {
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-top: 1rpx solid rgba(169, 111, 61, 0.55);
  border-bottom: 1rpx solid rgba(169, 111, 61, 0.36);
  background: rgba(2, 12, 16, 0.38);
}

.back-control {
  position: absolute;
  left: 0;
  top: 0;
  width: 74rpx;
  height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d7a35d;
  font-size: 78rpx;
  line-height: 86rpx;
}

.page-title {
  color: #d9aa6a;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.top-actions {
  position: absolute;
  right: 0;
  top: 0;
  height: 86rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.tool-control {
  width: 86rpx;
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #d7a35d;
}

.tool-icon {
  width: 36rpx;
  height: 32rpx;
  position: relative;
}

.rules-icon::before,
.rules-icon::after {
  content: "";
  position: absolute;
  top: 0;
  width: 15rpx;
  height: 31rpx;
  border: 3rpx solid #d7a35d;
  border-radius: 3rpx;
}

.rules-icon::before {
  left: 2rpx;
  transform: skewY(-8deg);
}

.rules-icon::after {
  right: 2rpx;
  transform: skewY(8deg);
}

.lock-icon {
  border: 3rpx solid #d7a35d;
  border-radius: 6rpx;
  margin-top: 10rpx;
}

.lock-icon::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: -18rpx;
  width: 16rpx;
  height: 18rpx;
  border: 3rpx solid #d7a35d;
  border-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
}

.tool-text {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1;
}

.card-stage {
  height: 680rpx;
  margin-top: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.identity-card-frame {
  position: absolute;
  left: 50%;
  top: 30rpx;
  z-index: 3;
  width: 460rpx;
  height: 613rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translateX(-50%) translateY(0) scale(1);
  transform-origin: 50% 50%;
  transition: transform 560ms cubic-bezier(0.2, 0.82, 0.24, 1), opacity 420ms ease;
}

.identity-card-frame.liberal-card {
  filter: drop-shadow(0 0 24rpx rgba(42, 227, 235, 0.58));
}

.identity-card-frame.fascist-card,
.identity-card-frame.dictator-card {
  filter: drop-shadow(0 0 24rpx rgba(218, 89, 54, 0.42));
}

.identity-card-image {
  display: block;
  width: 100%;
  height: 100%;
}

.identity-card-missing {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(60, 242, 248, 0.72);
  color: #e7d7bb;
  font-size: 48rpx;
  font-weight: 900;
  background: rgba(6, 41, 49, 0.92);
  box-shadow:
    0 0 28rpx rgba(42, 227, 235, 0.42),
    inset 0 0 0 8rpx rgba(206, 223, 226, 0.1);
}

.panel {
  margin-top: 24rpx;
  padding: 26rpx 30rpx;
  display: flex;
  gap: 26rpx;
  border: 2rpx solid rgba(169, 111, 61, 0.58);
  border-radius: 8rpx;
  background: rgba(3, 14, 18, 0.82);
  box-shadow:
    inset 0 1rpx 0 rgba(235, 191, 130, 0.14),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.7);
}

.panel-icon {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid rgba(94, 218, 219, 0.46);
  border-radius: 50%;
  color: #60dde2;
  font-size: 48rpx;
  font-weight: 900;
  background: rgba(14, 44, 48, 0.78);
}

.dossier-icon {
  border-color: rgba(169, 111, 61, 0.62);
  color: #d0a06a;
  background: rgba(48, 32, 19, 0.72);
}

.panel-content {
  min-width: 0;
  flex: 1;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #28d8de;
  font-size: 34rpx;
  font-weight: 900;
}

.section-title::before,
.section-title::after {
  content: "";
  width: 74rpx;
  height: 1rpx;
  margin: 0 18rpx;
  background: rgba(169, 111, 61, 0.58);
}

.mission-line,
.info-line {
  margin-top: 15rpx;
  color: #e2b174;
  font-size: 27rpx;
  line-height: 1.45;
}

.known-list {
  margin-top: 20rpx;
}

.known-member {
  min-height: 82rpx;
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid rgba(169, 111, 61, 0.34);
  background: rgba(7, 23, 27, 0.72);
}

.known-avatar {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 2rpx solid rgba(72, 219, 224, 0.56);
  border-radius: 50%;
  color: #56e1e4;
  font-size: 28rpx;
  background: rgba(12, 45, 50, 0.88);
}

.known-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.known-main {
  min-width: 0;
  flex: 1;
}

.known-name {
  color: #ecd0a4;
  font-size: 28rpx;
}

.known-role {
  margin-top: 6rpx;
  color: rgba(226, 177, 116, 0.72);
  font-size: 22rpx;
}

.tips-panel {
  display: block;
  padding-bottom: 20rpx;
}

.tips-title {
  margin-bottom: 18rpx;
}

.tip-row {
  min-height: 72rpx;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid rgba(169, 111, 61, 0.28);
  background: rgba(2, 12, 16, 0.7);
}

.tip-icon {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(43, 216, 222, 0.62);
  color: #48e0e6;
  font-size: 26rpx;
  font-weight: 900;
  background: rgba(8, 47, 53, 0.76);
}

.tip-text {
  color: #e2b174;
  font-size: 27rpx;
  line-height: 1.35;
}

.bottom-actions {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  gap: 36rpx;
}

.primary-action,
.secondary-action,
.retry-action {
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.primary-action {
  flex: 1.1;
  border: 4rpx solid rgba(90, 255, 255, 0.56);
  color: #062429;
  background: linear-gradient(180deg, #46eff2 0%, #10b8c2 100%);
  box-shadow: 0 0 24rpx rgba(32, 226, 232, 0.36);
}

.secondary-action {
  flex: 1;
  border: 4rpx solid rgba(163, 111, 62, 0.64);
  color: #e0ad6b;
  background: linear-gradient(180deg, rgba(94, 61, 31, 0.92), rgba(48, 31, 19, 0.96));
}

.identity-loading {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  color: #d9aa6a;
  font-size: 30rpx;
}

.retry-action {
  width: 260rpx;
  border: 3rpx solid rgba(78, 231, 235, 0.64);
  color: #55e4e7;
  background: rgba(6, 34, 39, 0.86);
}

.icon-hover,
.action-hover {
  opacity: 0.78;
}
