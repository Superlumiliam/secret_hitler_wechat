<view class="{{seat.seatClass}}" bindtap="onTapSeat" role="button" aria-label="双击切换操控席位">
  <view class="seat-art">
    <image wx:if="{{seat.seatFrameSrc}}" class="seat-frame-image" src="{{seat.seatFrameSrc}}" mode="aspectFill" webp="{{true}}"></image>
    <view class="seat-no">{{seat.seatNo}}</view>
    <view
      class="avatar"
      catchtap="onTapAvatar"
      role="button"
      aria-label="{{seat.isSelf ? '查看我的身份' : '选择玩家席位'}}"
    >
      <image wx:if="{{seat.avatarSrc}}" class="avatar-image" src="{{seat.avatarSrc}}" mode="aspectFill" webp="{{true}}"></image>
    </view>
    <view wx:if="{{seat.isVoteSubmitted}}" class="vote-submitted-avatar-mask" aria-label="{{seat.voteStatusLabel}}">
      <view class="vote-submitted-stamp">已投票</view>
    </view>
    <view class="{{seat.nameClass || 'seat-name'}}">{{seat.name}}</view>
    <government-badge
      wx:if="{{seat.roleBadgeSrc}}"
      label="{{seat.roleLabel || ''}}"
      src="{{seat.roleBadgeSrc || ''}}"
    ></government-badge>
    <image
      wx:if="{{seat.investigationStampSrc}}"
      class="investigation-stamp"
      src="{{seat.investigationStampSrc}}"
      mode="aspectFit"
      webp="{{true}}"
      aria-label="调查结果：{{seat.investigationStampLabel}}"
    ></image>
    <view
      class="{{seat.identityMark.className}}"
      catchtap="onTapIdentityMark"
      role="button"
      aria-label="{{seat.identityMark.label}}"
    >
      <image wx:if="{{seat.identityMark.iconSrc}}" class="identity-mark-image" src="{{seat.identityMark.iconSrc}}" mode="aspectFill" webp="{{true}}"></image>
    </view>
  </view>
</view>
