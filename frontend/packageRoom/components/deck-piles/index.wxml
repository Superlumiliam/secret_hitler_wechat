<view class="deck-piles-panel">
  <view wx:for="{{piles}}" wx:key="key" class="{{item.pileClass}}">
    <image wx:if="{{item.bgSrc}}" class="deck-pile-bg" src="{{item.bgSrc}}" mode="scaleToFill" webp="{{true}}"></image>
    <view class="deck-card-stack" aria-hidden="true">
      <image wx:if="{{item.cardSrc}}" class="deck-card-image" src="{{item.cardSrc}}" mode="aspectFit" webp="{{true}}"></image>
    </view>
    <view class="deck-pile-copy">
      <view class="deck-pile-label">{{item.label}}</view>
      <view class="deck-pile-count">{{item.countText}}</view>
    </view>
  </view>
</view>
