<view class="election-panel">
  <view class="election-track-shell">
    <image wx:if="{{assets.electionTrackBg}}" class="election-track-bg" src="{{assets.electionTrackBg}}" mode="aspectFill" webp="{{true}}"></image>
    <view class="election-row">
      <view wx:for="{{slots}}" wx:key="slot" class="{{item.cellClass}}">
        <image wx:if="{{item.slotSrc}}" class="election-slot-image" src="{{item.slotSrc}}" mode="aspectFit" webp="{{true}}"></image>
        <text class="election-slot-label">{{item.slot}}</text>
      </view>
    </view>
  </view>
  <view class="election-progress">当前进度 {{electionTracker}} / 3</view>
</view>
