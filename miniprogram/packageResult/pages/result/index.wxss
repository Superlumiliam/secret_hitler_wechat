.result {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 44rpx;
}

.result__hero {
  padding: 32rpx;
}

.result__title {
  margin-top: 16rpx;
  font-size: 42rpx;
  line-height: 1.12;
  font-weight: 900;
}

.result__subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.result__summary {
  padding: 24rpx;
}

.result__summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.result__summary-cell {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.04);
}

.result__summary-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.result__summary-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.result__players {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result__player {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.04);
}

.result__player-main {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  align-items: center;
}

.result__player-name {
  font-size: 28rpx;
  font-weight: 700;
}

.result__player-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

