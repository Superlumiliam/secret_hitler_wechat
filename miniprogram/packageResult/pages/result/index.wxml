<view class="page-root">
  <view class="page-inner result">
    <view class="result__hero shell-card shell-card--strong">
      <view class="chip {{resultVm && resultVm.winner === 'LIBERAL' ? 'chip--liberal' : 'chip--fascist'}}">
        {{resultVm ? resultVm.winnerLabel : '结果'}}
      </view>
      <view class="result__title">{{resultVm ? resultVm.reasonLabel : '正在加载结果'}}</view>
      <view class="result__subtitle">本局已结束，以下是公开复盘信息。</view>
    </view>

    <view class="section" wx:if="{{resultVm}}">
      <room-code-card
        roomCode="{{resultVm.roomCode}}"
        statusText="{{resultVm.winnerLabel}}"
        subtitle="最后结果与身份已经完全公开"
      />
    </view>

    <view class="section result__summary shell-card" wx:if="{{resultVm}}">
      <view class="result__summary-grid">
        <view class="result__summary-cell">
          <view class="result__summary-label">自由派政策</view>
          <view class="result__summary-value">{{resultVm.policySummary.liberal}}</view>
        </view>
        <view class="result__summary-cell">
          <view class="result__summary-label">法西斯政策</view>
          <view class="result__summary-value">{{resultVm.policySummary.fascist}}</view>
        </view>
      </view>
      <view class="result__players">
        <view wx:for="{{resultVm.finalPlayers}}" wx:key="memberId" class="result__player">
          <view class="result__player-main">
            <view class="result__player-name">{{item.displayName}}</view>
            <view class="chip {{item.party === 'LIBERAL' ? 'chip--liberal' : 'chip--fascist'}}">{{item.role}}</view>
          </view>
          <view class="result__player-meta mono">#{{item.seatIndex}} · {{item.isAlive ? '存活' : '出局'}}</view>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{resultVm}}">
      <result-timeline items="{{resultVm.timeline}}" />
    </view>

    <view class="section">
      <view class="button-row">
        <button class="button-secondary" catchtap="handleBackHome">返回首页</button>
        <button class="button-ghost" catchtap="handleOpenRules">查看规则</button>
      </view>
    </view>

    <view class="section">
      <state-feedback status="{{errorText ? 'error' : (loading ? 'loading' : 'idle')}}" text="{{errorText}}" retryText="重新加载" bind:retry="refreshResult" />
    </view>
  </view>
</view>
