.lobby {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.lobby__profile {
  padding: 28rpx;
}

.lobby__input {
  margin-top: 18rpx;
  width: 100%;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(29, 22, 18, 0.04);
  border: 1rpx solid rgba(47, 35, 19, 0.08);
  font-size: 28rpx;
}

.lobby__actions {
  padding: 24rpx;
}

