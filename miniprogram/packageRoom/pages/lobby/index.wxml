<view class="page-root">
  <view class="page-inner lobby">
    <room-code-card
      roomCode="{{lobbyVm.roomCode}}"
      statusText="{{lobbyVm.canStart ? '可开局' : '大厅中'}}"
      subtitle="{{lobbyVm.summaryText}}"
      bind:copy="handleCopyRoom"
    />

    <view class="section shell-card lobby__profile">
      <view class="card-title">我的名字</view>
      <view class="card-subtitle">修改后会同步到房间成员列表。</view>
      <input class="lobby__input mono" value="{{displayName}}" maxlength="20" placeholder="请输入展示名" bindinput="onDisplayNameInput" />
      <view class="button-row">
        <button class="button-secondary" catchtap="handleUpdateDisplayName" loading="{{renaming}}">{{renaming ? '保存中...' : '保存名字'}}</button>
        <button class="button-ghost" catchtap="handleToggleReady" loading="{{readySubmitting}}">{{myReady ? '取消准备' : '准备'}}</button>
      </view>
    </view>

    <view class="section">
      <seat-list
        players="{{lobbyVm.players}}"
        title="座位顺序"
        subtitle="{{lobbyVm.isHost ? '房主可通过上移 / 下移调整座位' : '等待房主确认顺序'}}"
        canReorder="{{lobbyVm.isHost}}"
        bind:moveup="handleMoveUp"
        bind:movedown="handleMoveDown"
      />
    </view>

    <view class="section">
      <view class="lobby__actions shell-card">
        <view class="button-row">
          <button class="button-solid" catchtap="handleStartGame" loading="{{startSubmitting}}" disabled="{{!canStart || !isHost}}">
            {{startSubmitting ? '开局中...' : '开始游戏'}}
          </button>
          <button class="button-ghost" catchtap="handleLeaveRoom" loading="{{leaving}}">退出房间</button>
        </view>
      </view>
    </view>

    <view class="section">
      <state-feedback status="{{errorText ? 'error' : 'idle'}}" text="{{errorText}}" retryText="刷新大厅" bind:retry="refreshLobby" />
    </view>
  </view>
</view>
