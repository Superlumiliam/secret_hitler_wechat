.identity {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.identity__panel-content {
  margin-top: 18rpx;
}

.identity__role {
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 900;
}

.identity__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.identity__grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.identity__cell {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.04);
}

.identity__label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.identity__value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.identity__known {
  margin-top: 18rpx;
}

.identity__known-list {
  margin-top: 10rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.identity__confirm {
  margin-top: 18rpx;
  width: 100%;
}

