<view class="page-root">
  <view class="page-inner board">
    <phase-banner
      phase="{{board.phase}}"
      title="{{board.phaseTitle}}"
      description="{{board.phaseDescription}}"
      danger="{{board.phaseDanger}}"
    />

    <government-badge
      round="{{board.round}}"
      phaseTitle="{{board.phaseTitle}}"
      president="{{board.government.president}}"
      chancellor="{{board.government.chancellor}}"
      presidentCandidate="{{board.government.presidentCandidate}}"
      chancellorCandidate="{{board.government.chancellorCandidate}}"
    />

    <view class="section">
      <policy-track liberalCount="{{board.tracks.liberal}}" fascistCount="{{board.tracks.fascist}}" vetoUnlocked="{{board.tracks.vetoUnlocked}}" />
    </view>

    <view class="section">
      <election-track count="{{board.tracks.electionTracker}}" />
    </view>

    <view class="section">
      <seat-list
        players="{{board.players}}"
        title="存活座位"
        subtitle="所有公开状态从这里读取"
        selectable="false"
        canReorder="false"
      />
    </view>

    <view class="section">
      <public-log items="{{board.publicLogs}}" title="公开日志" />
    </view>

    <view class="section">
      <pending-task-card task="{{task}}" submitting="{{submitting}}" bind:open="handleOpenTask" />
    </view>

    <view class="section">
    <state-feedback status="{{errorText ? 'error' : (loading ? 'loading' : 'idle')}}" text="{{errorText || board.currentTaskSummary}}" retryText="刷新桌面" bind:retry="refreshGame" />
    </view>

    <vote-panel
      visible="{{actionPanelVisible && currentPanel === 'vote'}}"
      submitting="{{submitting}}"
      bind:select="handleVoteSelect"
      bind:confirmvote="handleVoteConfirm"
      bind:cancel="handleVoteCancel"
    />

    <policy-picker
      visible="{{actionPanelVisible && currentPanel === 'pick_policy'}}"
      cards="{{task.cards}}"
      mode="{{task.taskType === 'PRESIDENT_DISCARD_POLICY' ? 'discard_one' : 'enact_one'}}"
      canRequestVeto="{{task.extra.canRequestVeto}}"
      submitting="{{submitting}}"
      title="{{task.title}}"
      bind:select="handlePolicySelect"
      bind:confirmpick="handlePolicyConfirm"
      bind:requestveto="handleRequestVeto"
      bind:cancel="handleVoteCancel"
    />

    <target-picker
      visible="{{actionPanelVisible && currentPanel === 'pick_target'}}"
      targets="{{task.targets}}"
      title="{{task.title}}"
      danger="{{task.taskType === 'EXECUTE_PLAYER'}}"
      submitting="{{submitting}}"
      confirmLabel="{{task.taskType === 'EXECUTE_PLAYER' ? '确认处决' : '确认目标'}}"
      bind:select="handleTargetSelect"
      bind:confirmtarget="handleTargetConfirm"
      bind:cancel="handleVoteCancel"
    />

    <view wx:if="{{actionPanelVisible && currentPanel === 'respond_veto'}}" class="board-veto">
      <view class="board-veto__mask" catchtap="handleVoteCancel"></view>
      <view class="board-veto__sheet shell-card shell-card--strong">
        <view class="board-veto__head">
          <view>
            <view class="card-title">{{task.title}}</view>
            <view class="card-subtitle">{{task.description}}</view>
          </view>
          <button class="board-veto__close" catchtap="handleVoteCancel">关闭</button>
        </view>
        <view class="board-veto__notice">否决是否成立将影响本轮立法结果。</view>
        <view class="board-veto__actions button-row">
          <button class="button-danger board-veto__accept" catchtap="handleVetoAccept" loading="{{submitting}}">接受否决</button>
          <button class="button-secondary board-veto__reject" catchtap="handleVetoReject" loading="{{submitting}}">拒绝否决</button>
        </view>
      </view>
    </view>

    <secret-panel
      visible="{{actionPanelVisible && currentPanel === 'confirm_only'}}"
      masked="{{secretMasked}}"
      title="{{task.title}}"
      hint="{{task.description}}"
      bind:reveal="handleSecretReveal"
      bind:close="handleSecretClose"
    >
      <view class="board__secret">
        <view class="board__secret-title">私密内容</view>
        <view class="board__secret-text">{{peekSummary || '查看完内容后确认即可。'}}</view>
        <view class="board__peek-list" wx:if="{{peekCards && peekCards.length}}">
          <view wx:for="{{peekCards}}" wx:key="index" class="board__peek-chip chip {{item === 'FASCIST' ? 'chip--fascist' : 'chip--liberal'}}">{{item}}</view>
        </view>
        <button class="button-solid board__confirm" catchtap="handleSecretConfirm">确认已查看</button>
      </view>
    </secret-panel>

    <privacy-mask visible="{{privacyShieldVisible}}" text="{{safeModeText}}" />
  </view>
</view>
