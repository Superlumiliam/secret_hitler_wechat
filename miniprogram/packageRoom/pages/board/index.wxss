.board {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 44rpx;
}

.board__secret {
  margin-top: 18rpx;
}

.board__secret-title {
  font-size: 30rpx;
  font-weight: 800;
}

.board__secret-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.board__peek-list {
  margin-top: 14rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.board__confirm {
  margin-top: 18rpx;
  width: 100%;
}

.board-veto {
  position: fixed;
  inset: 0;
  z-index: 72;
}

.board-veto__mask {
  position: absolute;
  inset: 0;
  background: rgba(17, 13, 11, 0.5);
}

.board-veto__sheet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 26rpx;
}

.board-veto__head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.board-veto__close {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: rgba(29, 22, 18, 0.06);
  font-size: 22rpx;
}

.board-veto__notice {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.board-veto__actions {
  margin-top: 18rpx;
}

.board-veto__accept,
.board-veto__reject {
  flex: 1;
}
