<view class="page-root">
  <view class="page-inner rules">
    <view class="rules__hero shell-card shell-card--strong">
      <view class="chip chip--brand">规则摘要</view>
      <view class="rules__title">局内提示</view>
      <view class="rules__subtitle">这里是与游戏流程相关的精简说明，帮助新玩家快速跟上节奏。</view>
    </view>

    <view class="section shell-card rules__section" wx:for="{{sections}}" wx:key="id">
      <view class="card-title">{{item.title}}</view>
      <view class="rules__items">
        <view wx:for="{{item.items}}" wx:key="*this" class="rules__item">• {{item}}</view>
      </view>
    </view>

    <view class="section">
      <view class="button-row">
        <button class="button-secondary" catchtap="handleBackHome">返回首页</button>
        <button class="button-ghost" catchtap="handleOpenBoard">查看桌面</button>
      </view>
    </view>
  </view>
</view>
