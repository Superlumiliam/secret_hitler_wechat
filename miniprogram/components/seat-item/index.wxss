.seat-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(47, 35, 19, 0.08);
  background: rgba(255, 255, 255, 0.8);
}

.seat-item--selected {
  border-color: rgba(177, 34, 43, 0.45);
  box-shadow: 0 12rpx 28rpx rgba(177, 34, 43, 0.08);
}

.seat-item--danger {
  border-color: rgba(161, 24, 37, 0.24);
}

.seat-item--dead {
  opacity: 0.72;
}

.seat-item__seat {
  min-width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.06);
  font-size: 24rpx;
  font-weight: 700;
}

.seat-item__body {
  flex: 1;
  min-width: 0;
}

.seat-item__name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.seat-item__name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.seat-item__meta {
  margin-top: 10rpx;
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.seat-item__actions {
  display: flex;
  gap: 10rpx;
}

.seat-item__action {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  background: #fff;
  border: 1rpx solid rgba(47, 35, 19, 0.12);
  color: var(--text-primary);
}

