.government-badge {
  padding: 24rpx;
}

.government-badge__head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.government-badge__grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.government-badge__cell {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.04);
}

.government-badge__label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.government-badge__value {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
}

