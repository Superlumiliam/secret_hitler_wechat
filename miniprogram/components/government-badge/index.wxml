<view class="government-badge shell-card">
  <view class="government-badge__head">
    <view>
      <view class="card-title">政府状态</view>
      <view class="card-subtitle">第 {{round}} 轮 · {{phaseTitle}}</view>
    </view>
    <view class="chip chip--brand">公开桌面</view>
  </view>
  <view class="government-badge__grid">
    <view class="government-badge__cell">
      <view class="government-badge__label">总统候选人</view>
      <view class="government-badge__value">{{presidentCandidate ? presidentCandidate.displayName : '等待提名'}}</view>
    </view>
    <view class="government-badge__cell">
      <view class="government-badge__label">总理候选人</view>
      <view class="government-badge__value">{{chancellorCandidate ? chancellorCandidate.displayName : '等待提名'}}</view>
    </view>
    <view class="government-badge__cell">
      <view class="government-badge__label">当选总统</view>
      <view class="government-badge__value">{{president ? president.displayName : '未成立'}}</view>
    </view>
    <view class="government-badge__cell">
      <view class="government-badge__label">当选总理</view>
      <view class="government-badge__value">{{chancellor ? chancellor.displayName : '未成立'}}</view>
    </view>
  </view>
</view>
