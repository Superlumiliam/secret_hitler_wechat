.policy-picker {
  position: fixed;
  inset: 0;
  z-index: 60;
}

.policy-picker__mask {
  position: absolute;
  inset: 0;
  background: rgba(17, 13, 11, 0.5);
}

.policy-picker__sheet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 26rpx;
}

.policy-picker__head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.policy-picker__close {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: rgba(29, 22, 18, 0.06);
  font-size: 22rpx;
}

.policy-picker__cards {
  margin-top: 18rpx;
  display: flex;
  gap: 14rpx;
}

.policy-picker__card {
  flex: 1;
  min-height: 150rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #fff;
}

.policy-picker__card--liberal {
  background: linear-gradient(135deg, rgba(31, 90, 168, 0.95), rgba(31, 90, 168, 0.58));
}

.policy-picker__card--fascist {
  background: linear-gradient(135deg, rgba(177, 59, 36, 0.95), rgba(177, 59, 36, 0.58));
}

.policy-picker__card--active {
  transform: translateY(-4rpx);
  outline: 3rpx solid rgba(0, 0, 0, 0.18);
}

.policy-picker__card-type {
  font-size: 26rpx;
  font-weight: 800;
}

.policy-picker__card-index {
  font-size: 20rpx;
  opacity: 0.88;
}

.policy-picker__extra {
  margin-top: 18rpx;
}

.policy-picker__veto {
  width: 100%;
}

.policy-picker__confirm {
  margin-top: 18rpx;
  width: 100%;
}

