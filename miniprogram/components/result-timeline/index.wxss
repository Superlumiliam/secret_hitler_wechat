.result-timeline {
  padding: 24rpx;
}

.result-timeline__head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.result-timeline__list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-timeline__item {
  display: flex;
  gap: 16rpx;
}

.result-timeline__dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--brand), var(--brand-deep));
  box-shadow: 0 0 0 10rpx rgba(177, 34, 43, 0.08);
}

.result-timeline__body {
  flex: 1;
  padding-bottom: 6rpx;
  border-bottom: 1rpx solid rgba(47, 35, 19, 0.08);
}

.result-timeline__title {
  font-size: 26rpx;
  font-weight: 700;
}

.result-timeline__summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.result-timeline__meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.result-timeline__empty {
  margin-top: 18rpx;
  padding: 28rpx 20rpx;
  text-align: center;
}

