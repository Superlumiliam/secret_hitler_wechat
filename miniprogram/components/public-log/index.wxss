.public-log {
  padding: 24rpx;
}

.public-log__head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.public-log__toggle {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: rgba(29, 22, 18, 0.06);
  font-size: 24rpx;
}

.public-log__list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.public-log__item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.04);
}

.public-log__item-title {
  font-size: 26rpx;
  font-weight: 700;
}

.public-log__item-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.public-log__item-meta {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.public-log__empty {
  margin-top: 18rpx;
  padding: 30rpx 20rpx;
  text-align: center;
}

