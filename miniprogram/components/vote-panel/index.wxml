<view wx:if="{{visible}}" class="vote-panel">
  <view class="vote-panel__mask" catchtap="cancel"></view>
  <view class="vote-panel__sheet shell-card shell-card--strong">
    <view class="vote-panel__head">
      <view>
        <view class="card-title">{{title}}</view>
        <view wx:if="{{description}}" class="card-subtitle">{{description}}</view>
      </view>
      <button class="vote-panel__close" catchtap="cancel">关闭</button>
    </view>

    <view class="vote-panel__choices">
      <button class="vote-panel__choice {{selectedVote === 'JA' ? 'vote-panel__choice--active' : ''}}" data-vote="JA" catchtap="chooseVote">Ja</button>
      <button class="vote-panel__choice vote-panel__choice--dark {{selectedVote === 'NEIN' ? 'vote-panel__choice--active' : ''}}" data-vote="NEIN" catchtap="chooseVote">Nein</button>
    </view>

    <button class="button-solid vote-panel__confirm {{!selectedVote || submitting ? 'button-disabled' : ''}}" catchtap="confirmVote" disabled="{{!selectedVote || submitting}}">
      {{submitting ? '提交中...' : '确认投票'}}
    </button>
  </view>
</view>
