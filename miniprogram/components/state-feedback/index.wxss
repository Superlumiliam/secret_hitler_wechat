.state-feedback {
  padding: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.state-feedback__body {
  flex: 1;
}

.state-feedback__title {
  font-size: 26rpx;
  font-weight: 700;
}

.state-feedback__text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.state-feedback__retry {
  min-width: 120rpx;
}

