<view class="seat-list shell-card">
  <view class="seat-list__head">
    <view>
      <view class="card-title">{{title}}</view>
      <view wx:if="{{subtitle}}" class="card-subtitle">{{subtitle}}</view>
    </view>
    <view class="chip">{{players.length}} 人</view>
  </view>

  <view wx:if="{{players && players.length}}" class="seat-list__body">
    <seat-item
      wx:for="{{renderPlayers}}"
      wx:key="memberId"
      player="{{item}}"
      selectable="{{selectable}}"
      selected="{{selectedId === item.memberId}}"
      canMoveUp="{{canReorder && index > 0}}"
      canMoveDown="{{canReorder && index < players.length - 1}}"
      danger="{{item.isDanger}}"
      bind:select="onSelect"
      bind:moveup="onMoveUp"
      bind:movedown="onMoveDown"
    />
  </view>

  <view wx:else class="seat-list__empty">
    <text class="muted">{{emptyText}}</text>
  </view>
</view>
