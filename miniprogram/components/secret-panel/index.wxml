<view wx:if="{{visible}}" class="secret-panel shell-card shell-card--strong {{masked ? 'secret-panel--masked' : ''}}">
  <view class="secret-panel__head">
    <view>
      <view class="card-title">{{title}}</view>
      <view class="card-subtitle">{{hint || '请在安全环境中查看。'}}</view>
    </view>
    <button class="secret-panel__close" catchtap="close">关闭</button>
  </view>

  <view wx:if="{{masked}}" class="secret-panel__mask">
    <view class="secret-panel__cover"></view>
    <button class="button-solid secret-panel__reveal" catchtap="reveal">查看内容</button>
  </view>

  <view wx:else class="secret-panel__content">
    <slot></slot>
  </view>
</view>
