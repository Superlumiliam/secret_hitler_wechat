<view wx:if="{{visible}}" class="target-picker">
  <view class="target-picker__mask" catchtap="cancel"></view>
  <view class="target-picker__sheet shell-card shell-card--strong">
    <view class="target-picker__head">
      <view>
        <view class="card-title">{{title}}</view>
        <view class="card-subtitle">只显示后端允许的合法目标。</view>
      </view>
      <button class="target-picker__close" catchtap="cancel">{{cancelLabel}}</button>
    </view>

    <view class="target-picker__list">
      <button
        class="target-picker__item {{selectedId === item.memberId ? 'target-picker__item--active' : ''}} {{danger ? 'target-picker__item--danger' : ''}}"
        wx:for="{{targets}}"
        wx:key="memberId"
        data-member-id="{{item.memberId}}"
        catchtap="selectTarget"
        disabled="{{item.disabled}}"
      >
        <view class="target-picker__item-main">
          <text class="target-picker__name">{{item.displayName}}</text>
          <text wx:if="{{item.isSelf}}" class="chip chip--brand">你</text>
          <text wx:if="{{item.isAlive === false}}" class="chip chip--danger">已出局</text>
        </view>
        <view class="target-picker__item-meta mono">#{{item.seatIndex}}</view>
        <view wx:if="{{item.disabledReason}}" class="target-picker__reason">{{item.disabledReason}}</view>
      </button>
    </view>

    <button class="button-solid target-picker__confirm {{!selectedId || submitting ? 'button-disabled' : ''}}" catchtap="confirmTarget" disabled="{{!selectedId || submitting}}">
      {{submitting ? '提交中...' : confirmLabel}}
    </button>
  </view>
</view>
