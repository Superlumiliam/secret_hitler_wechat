.target-picker {
  position: fixed;
  inset: 0;
  z-index: 70;
}

.target-picker__mask {
  position: absolute;
  inset: 0;
  background: rgba(17, 13, 11, 0.5);
}

.target-picker__sheet {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 26rpx;
}

.target-picker__head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.target-picker__close {
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: rgba(29, 22, 18, 0.06);
  font-size: 22rpx;
}

.target-picker__list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  max-height: 54vh;
  overflow: auto;
}

.target-picker__item {
  padding: 18rpx;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.04);
  text-align: left;
  border: 1rpx solid transparent;
}

.target-picker__item--active {
  border-color: rgba(177, 34, 43, 0.45);
  background: rgba(246, 217, 220, 0.4);
}

.target-picker__item--danger {
  background: rgba(253, 229, 231, 0.48);
}

.target-picker__item-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.target-picker__name {
  font-size: 28rpx;
  font-weight: 700;
}

.target-picker__item-meta {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-muted);
}

.target-picker__reason {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--danger);
}

.target-picker__confirm {
  margin-top: 18rpx;
  width: 100%;
}

