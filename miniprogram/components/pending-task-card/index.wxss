.pending-task-card {
  padding: 24rpx;
}

.pending-task-card__head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.pending-task-card__content {
  margin-top: 18rpx;
}

.pending-task-card__title {
  font-size: 32rpx;
  font-weight: 800;
}

.pending-task-card__desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.pending-task-card__button {
  margin-top: 18rpx;
  width: 100%;
}

.pending-task-card__idle {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(29, 22, 18, 0.04);
  text-align: center;
}

