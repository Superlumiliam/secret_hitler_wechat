.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(15, 11, 10, 0.58);
  backdrop-filter: blur(12px);
}

.privacy-mask__sheet {
  width: 100%;
  max-width: 640rpx;
  padding: 30rpx;
  text-align: center;
}

.privacy-mask__icon {
  display: inline-flex;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(177, 34, 43, 0.12);
  color: var(--danger);
  font-size: 22rpx;
  font-weight: 700;
}

.privacy-mask__title {
  margin-top: 18rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.privacy-mask__text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

