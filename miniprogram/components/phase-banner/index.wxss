.phase-banner {
  padding: 28rpx;
}

.phase-banner--danger {
  border-color: rgba(161, 24, 37, 0.2);
  box-shadow: 0 20rpx 54rpx rgba(161, 24, 37, 0.08);
}

.phase-banner__title {
  margin-top: 14rpx;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
}

.phase-banner__desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

