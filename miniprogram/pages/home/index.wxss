.home {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.home__hero {
  padding: 34rpx;
}

.home__eyebrow {
  margin-bottom: 20rpx;
}

.home__title {
  font-size: 46rpx;
  line-height: 1.08;
  font-weight: 900;
  letter-spacing: 0.02em;
}

.home__subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.home__actions {
  margin-top: 24rpx;
}

.home__form {
  padding: 28rpx;
}

.home__field {
  margin-top: 18rpx;
}

.home__label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.home__input {
  width: 100%;
  min-height: 84rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(29, 22, 18, 0.04);
  border: 1rpx solid rgba(47, 35, 19, 0.08);
  font-size: 28rpx;
}

