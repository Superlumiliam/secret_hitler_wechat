<view class="page-root">
  <view class="page-inner home">
    <view class="home__hero shell-card shell-card--strong">
      <view class="home__eyebrow chip chip--brand">Secret Hitler</view>
      <view class="home__title">揭秘希特勒面杀助手</view>
      <view class="home__subtitle">{{subtitle}}</view>
      <view class="home__actions button-row">
        <button class="button-solid" catchtap="handleCreateRoom" loading="{{creating}}">{{creating ? '创建中...' : '创建房间'}}</button>
        <button class="button-secondary" catchtap="handleRecoverRoom" loading="{{recovering}}" disabled="{{!canRecover}}">{{recovering ? '恢复中...' : '恢复活跃房间'}}</button>
      </view>
    </view>

    <view class="section">
      <view class="home__form shell-card">
        <view class="card-title">加入已有房间</view>
        <view class="card-subtitle">输入展示名和 6 位房号，快速进入大厅。</view>
        <view class="home__field">
          <text class="home__label">展示名</text>
          <input class="home__input" value="{{displayName}}" maxlength="20" placeholder="例如：玩家A" bindinput="onDisplayNameInput" />
        </view>
        <view class="home__field">
          <text class="home__label">房号</text>
          <input class="home__input mono" value="{{roomCode}}" maxlength="6" placeholder="请输入 6 位房号" bindinput="onRoomCodeInput" />
        </view>
        <view class="button-row">
          <button class="button-solid" catchtap="handleJoinRoom" loading="{{joining}}">{{joining ? '加入中...' : '加入房间'}}</button>
          <button class="button-ghost" catchtap="handleShareEntry">复制分享路径</button>
        </view>
      </view>
    </view>

    <view class="section">
      <room-code-card roomCode="{{activeRoomCode}}" statusText="{{canRecover ? '可恢复' : '无活跃房间'}}" subtitle="{{canRecover ? '可直接恢复上次会话' : '创建或加入房间后会显示在这里'}}" bind:copy="handleShareEntry" />
    </view>

    <view class="section">
      <state-feedback status="{{errorText ? 'error' : 'idle'}}" text="{{errorText}}" retryText="重试" bind:retry="handleRecoverRoom" />
    </view>
  </view>
</view>
